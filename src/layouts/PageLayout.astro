---
/**
 * Inner pages (Platform, Solutions, sectors, Climate, Digitalization): the base
 * layout plus one scrubbed surface around the content, so the whole page turns
 * dark while a [data-dark] section is in view, and the shared page styles.
 */
import BaseLayout from './BaseLayout.astro';
import '../styles/pages.css';
import type { Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, locale = 'en', jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale} jsonLd={jsonLd}>
  <div class="pg theme-scrub" data-pg data-header-dark="scrub">
    <slot />
  </div>
</BaseLayout>

<script>
  import { mountPageScrub } from '../scripts/page-scrub';
  import { mountPageMotion } from '../scripts/page-motion';

  const root = document.querySelector<HTMLElement>('[data-pg]');
  if (root) mountPageScrub(root);
  mountPageMotion();
</script>
