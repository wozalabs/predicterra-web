---
/**
 * The four teams on one timeline, Today → 2100: one lane per team with a bar
 * over its horizon (bars grow in as the block scrolls into view), its question
 * and, optionally, what it gets. The 2050–2100 stretch of the axis is orange.
 */
interface Team {
  name: string;
  horizon: string;
  question?: string;
  gets?: string;
}
interface Props {
  teams: readonly Team[];
  /** Hide question and "gets" (hero use). */
  compact?: boolean;
  class?: string;
}
const { teams, compact = false, class: className } = Astro.props;
const ticks = ['Today', '14 days', '1 year', '10 years', '2050', '2100'];
const span = (h: string): [number, number] => {
  if (/^today/i.test(h)) return [0, 0.2];
  if (/1 to 10/.test(h)) return [0.4, 0.6];
  if (/every/i.test(h)) return [0, 1];
  if (/2100/.test(h)) return [0.6, 1];
  return [0, 1];
};
---

<div class:list={['hz', compact && 'hz--compact', className]} data-progress>
  <div class="hz__axis" aria-hidden="true">
    <span class="hz__axis-name"></span>
    <span class="hz__axis-line">
      {ticks.map((t, i) => <span class="hz__tick t-caption" style={`--x:${i / (ticks.length - 1)}`}>{t}</span>)}
    </span>
  </div>
  <ol class="hz__lanes">
    {
      teams.map((t, i) => {
        const [lo, hi] = span(t.horizon);
        return (
          <li class="hz__lane" style={`--lo:${lo};--hi:${hi};--i:${i}`}>
            <p class="hz__name">
              <span>{t.name}</span>
              <span class="hz__horizon t-small">{t.horizon}</span>
            </p>
            <div class="hz__track">
              <span class="hz__bar" aria-hidden="true" />
              {!compact && t.question && <p class="hz__q">{t.question}</p>}
              {!compact && t.gets && <p class="hz__gets t-small">{t.gets}</p>}
            </div>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .hz {
    --name-w: minmax(0, 1fr);
    display: grid;
  }

  .hz__axis,
  .hz__lane {
    display: grid;
    grid-template-columns: minmax(9rem, 3fr) minmax(0, 9fr);
    gap: 0.75rem clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .hz__axis-line {
    position: relative;
    height: 2.25rem;
    margin-right: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  /* The last stretch, 2050 → 2100, in orange. */
  .hz__axis-line::after {
    content: '';
    position: absolute;
    left: 80%;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
  }

  .hz__tick {
    position: absolute;
    top: 0;
    left: calc(var(--x) * 100%);
    color: var(--muted);
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .hz__tick:first-child {
    transform: none;
  }

  .hz__tick:last-child {
    transform: translateX(-100%);
  }

  .hz__lane {
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--line);
  }

  .hz__name {
    display: grid;
    align-content: start;
    gap: 0.125rem;
    font-size: var(--fs-h4);
    line-height: 1.2;
    letter-spacing: var(--track-title);
  }

  .hz__horizon {
    color: var(--muted);
    letter-spacing: var(--track-small);
  }

  .hz__track {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.375rem;
    margin-right: 1.5rem;
    padding-top: 1.25rem;
  }

  /* Bar over the team's horizon, growing from its start. */
  .hz__bar {
    position: absolute;
    top: 0.375rem;
    left: calc(var(--lo) * 100%);
    width: calc((var(--hi) - var(--lo)) * 100%);
    height: 0.5rem;
    background: var(--ink);
    transform-origin: left center;
    transform: scaleX(clamp(0, calc(var(--p, 1) * 1.6 - var(--i) * 0.15), 1));
  }

  .hz__q {
    max-width: 44ch;
    padding-top: 0.5rem;
  }

  .hz__gets {
    max-width: 52ch;
    color: var(--muted);
  }

  .hz--compact .hz__lane {
    padding-block: 0.75rem;
  }

  .hz--compact .hz__name {
    font-size: var(--fs-body);
  }

  @media (max-width: 47.99rem) {
    .hz__axis,
    .hz__lane {
      grid-template-columns: minmax(0, 1fr);
    }
    .hz__axis-name {
      display: none;
    }
    .hz__axis-line,
    .hz__track {
      margin-right: 1rem;
    }
    .hz__tick:nth-child(2),
    .hz__tick:nth-child(4) {
      display: none;
    }
  }
</style>
