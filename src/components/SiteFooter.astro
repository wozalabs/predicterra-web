---
import Logo from './Logo.astro';
import { getCopy, localizePath, type Locale } from '../i18n/config';
import { external } from '../data/routes';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { footer } = getCopy(locale).common;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo class="footer__logo" />
        <p class="footer__tagline t-small t-muted">{footer.tagline}</p>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        {
          footer.columns.map((col) => (
            <div>
              <p class="footer__title t-caption t-muted">{col.title}</p>
              <ul>
                {col.links.map((link) => (
                  <li>
                    <a
                      class="footer__link"
                      href={'external' in link && link.external ? link.href : localizePath(link.href, locale)}
                      {...('external' in link && link.external ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div>
          <p class="footer__title t-caption t-muted">{footer.contact.title}</p>
          <address class="footer__address">
            <a class="footer__link" href={`mailto:${footer.contact.email}`}>{footer.contact.email}</a>
            {
              footer.contact.phones.map((p) => (
                <a class="footer__link" href={p.href}>
                  <span class="t-muted">{p.label}</span> <span class="t-num">{p.value}</span>
                </a>
              ))
            }
            <span class="footer__street t-muted">
              {footer.contact.address.map((line) => <span>{line}</span>)}
            </span>
          </address>
        </div>
      </nav>
    </div>

    <div class="footer__bottom t-caption">
      <p class="t-muted">{footer.copyright}</p>
      <ul class="footer__chips" aria-label="Compliance">
        {footer.compliance.map((c) => <li class="chip">{c}</li>)}
      </ul>
      <ul class="footer__legal">
        {
          footer.legal.map((l) => (
            <li>
              <a class="footer__link" href={localizePath(l.href, locale)}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <span class="t-muted">{footer.builtBy}</span>
          <a class="footer__link" href={external.woza} target="_blank" rel="noopener">{footer.builtByName}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: var(--z-cover);
    background: var(--canvas);
    font-size: var(--fs-small);
    padding-bottom: 1.25rem;
  }

  .footer__top {
    display: grid;
    gap: 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .footer__top {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--gutter);
    }
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .footer__brand :global(.footer__logo) {
    height: 1.125rem;
  }

  .footer__tagline {
    max-width: 30ch;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem var(--gutter);
  }

  @media (min-width: 48rem) {
    .footer__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .footer__title {
    margin-bottom: 0.625rem;
  }

  .footer__cols ul {
    display: grid;
    gap: 0.25rem;
  }

  .footer__link {
    color: var(--ink-2);
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__link:hover {
      color: var(--ink);
    }
  }

  .footer__address {
    display: grid;
    gap: 0.25rem;
    font-style: normal;
  }

  .footer__street {
    display: grid;
    margin-top: 0.375rem;
    font-size: var(--fs-caption);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .footer__chips {
    display: flex;
    gap: 0.375rem;
  }

  .footer__chips .chip {
    min-height: 1.375rem;
    padding: 0 0.375rem;
    font-size: 0.6875rem;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-left: auto;
  }

  .footer__legal li {
    display: flex;
    gap: 0.35em;
  }
</style>
