---
import { icons } from '../data/icons';

interface Props {
  href: string;
  label: string;
  size?: 'md' | 'lg';
  /** primary: orange. secondary: white on light, dark grey inside .theme-dark. */
  variant?: 'primary' | 'secondary';
  external?: boolean;
  class?: string;
}
const { href, label, size = 'md', variant = 'primary', external = false, class: className } = Astro.props;
---

<a
  class:list={['btn', size === 'lg' && 'btn--lg', variant === 'secondary' && 'btn--secondary', className]}
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span>{label}</span>
  <span class="btn__sq" aria-hidden="true">
    <svg class="btn__icon" viewBox="0 -960 960 960"><path d={icons.arrow_forward} /></svg>
  </span>
</a>
