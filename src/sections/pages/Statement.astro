---
/**
 * One idea, large: a title and a short paragraph, centred, with lots of air.
 * `dark` turns the page dark around it (Resilience "Not a score. A model.").
 * The paragraph lights up word by word as it scrolls in.
 */
interface Props {
  id: string;
  title: string;
  text: string;
  dark?: boolean;
}
const { id, title, text, dark = false } = Astro.props;
---

<section class="stm pg-sec" aria-labelledby={id} data-dark={dark ? '' : undefined}>
  <div class="container stm__inner">
    <h2 id={id} class="stm__title" data-render>{title}</h2>
    <p class="stm__text" data-lit>
      {text.split(' ').map((w) => <span class="w">{w} </span>)}
    </p>
  </div>
</section>

<style>
  .stm {
    padding-block: clamp(7rem, 4rem + 9vw, 14rem);
  }

  .stm__inner {
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    text-align: center;
  }

  .stm__title {
    font-size: var(--pg-hero);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .stm__text {
    max-width: 34ch;
    font-size: var(--fs-h3);
    line-height: 1.3;
    letter-spacing: var(--track-title);
    text-wrap: balance;
  }
</style>
