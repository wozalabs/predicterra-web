---
/**
 * Key figures: the title on the left, the figures as rows on the right (label
 * left, value large on the right). An optional line and button close it
 * (Solutions pages: the cases behind the numbers).
 */
import FigureList from './FigureList.astro';
import Button from '../../components/Button.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { Stat, Link } from './types';

interface Props {
  locale?: Locale;
  items: readonly Stat[];
  title?: string;
  text?: string;
  /** A closing line and its button, under the figures. */
  backing?: { text: string; link: Link };
  id?: string;
  class?: string;
}
const { locale = 'en', items, title = 'Key figures', text, backing, id = 'figures-title', class: className } = Astro.props;
---

<section class:list={['st pg-sec', className]} aria-labelledby={id}>
  <div class="container st__grid">
    <div class="st__head">
      <h2 id={id} class="st__title" data-render>{title}</h2>
      {text && <p class="st__text" data-reveal>{text}</p>}
    </div>
    <div class="st__body">
      <FigureList items={items.map((s) => ({ value: s.value, label: s.text, text: s.note }))} />
      {
        backing && (
          <div class="st__backing" data-reveal>
            <p class="st__backing-text">{backing.text}</p>
            <Button href={localizePath(backing.link.href, locale)} label={backing.link.label} variant="secondary" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .st__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .st__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .st__head {
    display: grid;
    gap: 1.25rem;
  }

  .st__title {
    max-width: 18ch;
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .st__text {
    max-width: 40ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .st__backing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }

  .st__backing-text {
    max-width: 44ch;
    color: var(--ink-2);
  }
</style>
