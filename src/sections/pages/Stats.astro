---
/**
 * Quick proof: four large figures in a row, each on its own hairline with a
 * small running index (the homepage sub-hero rhythm, given more air). Optional
 * links under single figures and a backing line, centred under the row.
 */
import TextLink from '../../components/TextLink.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { Stat, Link } from './types';

interface Props {
  locale?: Locale;
  items: Stat[];
  backing?: { text: string; link: Link };
  link?: Link;
  label?: string;
}
const { locale = 'en', items, backing, link, label = 'Key figures' } = Astro.props;
const pad = (n: number) => String(n).padStart(3, '0');
---

<section class="st pg-sec" aria-label={label}>
  <div class="container st__inner">
    <ul class="st__list" data-reveal-group style={`--n:${items.length}`}>
      {
        items.map((s, i) => (
          <li class="st__item" data-reveal>
            <span class="pg-idx">{pad(i + 1)}</span>
            <p class="st__value t-num">{s.value}</p>
            <p class="st__text">{s.text}</p>
            {s.link && <TextLink href={localizePath(s.link.href, locale)} label={s.link.label} class="st__link" />}
          </li>
        ))
      }
    </ul>
    {
      backing && (
        <div class="st__backing" data-reveal>
          <p class="st__backing-text">{backing.text}</p>
          <TextLink href={localizePath(backing.link.href, locale)} label={backing.link.label} />
        </div>
      )
    }
    {
      link && (
        <div class="st__backing" data-reveal>
          <TextLink href={localizePath(link.href, locale)} label={link.label} />
        </div>
      )
    }
  </div>
</section>

<style>
  .st {
    padding-block: clamp(4rem, 2.5rem + 4vw, 7.5rem);
  }

  .st__inner {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .st__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .st__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }

  .st__item {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .st__value {
    margin-top: 1.5rem;
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .st__text {
    max-width: 24ch;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .st__item :global(.st__link) {
    align-self: end;
    margin-top: 1rem;
    min-width: 0;
    justify-self: start;
  }

  .st__backing {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .st__backing-text {
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }
</style>
