---
/**
 * "One X. Four teams. The same model." On wide screens the stage pins and the
 * four teams slide past sideways while a timeline (Today → 2100) above them
 * highlights the active team's horizon. Elsewhere, or if a team doesn't fit the
 * screen, the teams stack as a plain grid, each with its own small timeline.
 * With `cover`, the stage stays pinned one more screen so the next (dark)
 * section slides over it.
 */
import NotchRule from '../../components/NotchRule.astro';
import Placeholder from '../../components/Placeholder.astro';
import type { Team } from './types';

interface Props {
  id: string;
  title: string;
  items: Team[];
  cover?: boolean;
}
const { id, title, items, cover = false } = Astro.props;

// Where each horizon sits on the Today → 2100 line (ticks at 0, .2, .4, .6, .8, 1).
const span = (h: string): [number, number] => {
  if (/^today/i.test(h)) return [0, 0.2];
  if (/1 to 10/.test(h)) return [0.4, 0.6];
  if (/1 to 30/.test(h)) return [0.4, 0.82];
  if (/every/i.test(h)) return [0, 1];
  if (/2100/.test(h)) return [0.6, 1];
  return [0, 1];
};
const ticks = ['Today', '14 days', '1 year', '10 years', '2050', '2100'];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="tm" aria-labelledby={id} data-hscroll data-hs-cover={cover ? '' : undefined}>
  <div class="tm__stage" data-hs-stage>
    <div class="container tm__head">
      <NotchRule at={46} />
      <div class="tm__top">
        <h2 id={id} class="t-h2 pg-title" data-render>{title}</h2>
        <div class="tm__line" aria-hidden="true">
          <span class="tm__bar" data-hs-bar style={`--lo:${span(items[0].horizon)[0]};--hi:${span(items[0].horizon)[1]}`}
          ></span>
          {ticks.map((t, i) => <span class="tm__tick t-caption" style={`--x:${i / (ticks.length - 1)}`}>{t}</span>)}
        </div>
      </div>
    </div>

    <div class="container tm__viewport">
      <ol class="tm__track" data-hs-track data-reveal-group>
        {
          items.map((t, i) => {
            const [lo, hi] = span(t.horizon);
            return (
              <li class="tm__col" data-span={`${lo},${hi}`} data-on={i === 0 ? '' : undefined} data-reveal>
                <header class="tm__colhead">
                  <span class="tm__num t-caption t-num">{pad(i + 1)}</span>
                  <h3 class="tm__name">{t.name}</h3>
                  <p class="tm__horizon t-small">{t.horizon}</p>
                  <span class="tm__mini" aria-hidden="true" style={`--lo:${lo};--hi:${hi}`} />
                </header>
                <div class="tm__a">
                  <Placeholder kind="Platform capture" text={t.shot} ratio="16 / 10" compact />
                  <p class="tm__text">{t.text}</p>
                  <p class="tm__metric">
                    <span class="t-caption t-muted">Measured in</span>
                    <span>{t.metric}</span>
                  </p>
                </div>
                <ul class="tm__uses">
                  {t.useCases.map((u) => (
                    <li class="tm__use">
                      <span class="pg-dot" aria-hidden="true" />
                      <p>
                        <span class="tm__use-title">{u.title}</span>
                        <span class="tm__use-text">{u.text}</span>
                      </p>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .tm {
    position: relative;
    padding-block: clamp(4rem, 2.5rem + 4vw, 7rem);
  }

  .tm__top {
    display: grid;
    gap: 2rem clamp(2.5rem, 1rem + 5vw, 7.5rem);
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 64rem) {
    .tm__top {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: end;
    }
  }

  /* Timeline: a hairline with ticks; the bar marks the active horizon. Only shown when pinned. */
  .tm__line {
    position: relative;
    display: none;
    height: 2.75rem;
    margin-inline: 0.25rem 2.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .tm__tick {
    position: absolute;
    bottom: 0.875rem;
    left: calc(var(--x) * 100%);
    color: var(--muted);
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .tm__tick:first-of-type {
    transform: none;
  }

  .tm__tick::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(100% + 0.5rem);
    width: 1px;
    height: 0.375rem;
    background: var(--line-strong);
  }

  .tm__tick:first-of-type::after {
    left: 0;
  }

  .tm__bar {
    position: absolute;
    bottom: -2px;
    left: calc(var(--lo) * 100%);
    width: calc((var(--hi) - var(--lo)) * 100%);
    height: 3px;
    background: var(--accent);
  }

  /* ----- Teams: static grid ----- */
  .tm__viewport {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .tm__track {
    display: grid;
    gap: 3.5rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .tm__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tm__col {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .tm__colhead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .tm__num {
    color: var(--accent);
  }

  .tm__name {
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: var(--track-title);
  }

  .tm__horizon {
    grid-column: 2;
    color: var(--muted);
  }

  .tm__mini {
    position: relative;
    grid-column: 2;
    width: min(16rem, 100%);
    height: 1px;
    margin-top: 0.5rem;
    background: var(--line-strong);
  }

  .tm__mini::after {
    content: '';
    position: absolute;
    top: -1px;
    left: calc(var(--lo) * 100%);
    width: calc((var(--hi) - var(--lo)) * 100%);
    height: 3px;
    background: var(--accent);
  }

  .tm__a {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .tm__text {
    max-width: 44ch;
    color: var(--ink-2);
  }

  .tm__metric {
    display: grid;
    gap: 0.25rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
  }

  .tm__uses {
    display: grid;
    align-content: start;
    gap: 0.875rem;
  }

  .tm__use {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .tm__use .pg-dot {
    margin-top: 0.4em;
  }

  .tm__use-title {
    display: block;
    color: var(--ink);
  }

  .tm__use-text {
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .tm__col {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .tm__colhead {
      grid-column: 1 / -1;
    }
  }

  /* ----- Pinned (wide screens, set by scripts/page-motion.ts) ----- */
  .tm:global(.is-pinned) {
    padding-block: 0;
  }

  .tm:global(.is-pinned) .tm__stage {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100svh;
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
    overflow: clip;
    background: var(--canvas-mix);
  }

  .tm:global(.is-pinned) .tm__line {
    display: block;
  }

  .tm:global(.is-pinned) .tm__mini {
    display: none;
  }

  .tm:global(.is-pinned) .tm__viewport {
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 0;
  }

  .tm:global(.is-pinned) .tm__track {
    display: flex;
    gap: clamp(2rem, 1rem + 2.5vw, 4rem);
    width: 100%;
    will-change: transform;
  }

  .tm:global(.is-pinned) .tm__col {
    flex: 0 0 min(46rem, 58vw);
    transition: opacity 400ms ease;
  }

  .tm:global(.is-pinned) .tm__col:not([data-on]) {
    opacity: 0.35;
  }

  /* The next section slides over the stage while it stays pinned. */
  .tm:global(.is-pinned) + :global(.pg-cover) {
    margin-top: -100svh;
  }
</style>
