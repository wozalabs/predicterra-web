---
/**
 * Grid of flat cards (3 × 2, or 4 in a row), each with an orange icon square
 * or a number, a title and a line. Cards rise in a stagger.
 */
import SectionHead from './SectionHead.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';

interface Props {
  id: string;
  title: string;
  text?: string;
  items: readonly { icon?: IconName | string; title: string; text: string }[];
  cols?: 3 | 4;
  head?: 'center' | 'stack' | 'side';
  /** Wider title measure (long titles). */
  wide?: boolean;
}
const { id, title, text, items, cols = 3, head = 'stack', wide = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cd pg-sec" aria-labelledby={id} style={`--cols:${cols}`}>
  <div class="container">
    <div class="pg-body">
      <SectionHead id={id} title={title} text={text} align={head} wide={wide} />
      <slot name="before" />
      <ul class="cd__list" data-reveal-group>
        {
          items.map((it, i) => (
            <li class="cd__card" data-reveal>
              {it.icon ? (
                <Icon name={it.icon as IconName} boxed size="2.75rem" />
              ) : (
                <span class="cd__num t-num">{pad(i + 1)}</span>
              )}
              <div class="cd__body">
                <h3 class="cd__title">{it.title}</h3>
                <p class="cd__text">{it.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <slot />
    </div>
  </div>
</section>

<style>
  .cd__list {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .cd__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cd__list {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }

  .cd__card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
    min-height: clamp(15rem, 11rem + 7vw, 20rem);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    background: var(--card);
    transition: background-color 200ms ease;
  }

  .cd__num {
    font-size: var(--fs-small);
    color: var(--accent);
  }

  .cd__body {
    display: grid;
    align-content: end;
    gap: 0.5rem;
  }

  .cd__title {
    font-size: var(--fs-h4);
    line-height: 1.2;
    letter-spacing: var(--track-title);
  }

  .cd__text {
    max-width: 36ch;
    color: var(--ink-2);
  }
</style>
