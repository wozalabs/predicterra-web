---
/**
 * Logos of the clients in operation and of the recognition, with one line and
 * the button to the cases (home). The logos sit still in their own colours,
 * one row per screen width, centred and wrapping on narrow screens.
 */
import Button from '../../components/Button.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { Proof } from '../../i18n/en/pages-shared';

interface Props {
  locale?: Locale;
  proof: Proof;
  class?: string;
}
const { locale = 'en', proof, class: className } = Astro.props;
// Logos are scaled up a step for the band (the source heights suit the heroes).
const scale = 1.25;
---

<section class:list={['pb', className]} aria-label="Clients and recognition">
  <ul class="container pb__groups" data-reveal-group>
    {
      proof.groups.map((g) => (
        <li class="pb__group" data-reveal>
          <span class="pb__label">{g.label}</span>
          <ul class="pb__logos">
            {g.items.map((it) => (
              <li class="pb__item">
                {it.src ? (
                  <BrandLogo
                    src={it.src}
                    name={it.name}
                    height={Math.round((it.h ?? 20) * scale)}
                    w={it.w ?? 1}
                    h0={it.h0 ?? 1}
                  />
                ) : (
                  <span class="pb__word">{it.name}</span>
                )}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <div class="container pb__foot" data-reveal-group>
    <p class="pb__text" data-reveal>{proof.text}</p>
    <div data-reveal>
      <Button href={localizePath(proof.link.href, locale)} label={proof.link.label} variant="secondary" />
    </div>
  </div>
</section>

<style>
  .pb {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }

  /* ---------- Still logos, centred ---------- */
  .pb__groups {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem clamp(2.5rem, 1.5rem + 3vw, 5rem);
  }

  .pb__group,
  .pb__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem clamp(1.75rem, 1rem + 2vw, 3rem);
  }

  .pb__label {
    font-size: var(--fs-small);
    color: var(--muted);
    white-space: nowrap;
  }

  .pb__item {
    display: flex;
    align-items: center;
    height: 3rem;
  }

  .pb__word {
    font-size: 1.375rem;
    letter-spacing: var(--track-title);
    color: var(--ink);
    white-space: nowrap;
  }

  /* ---------- Line and button ---------- */
  .pb__foot {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .pb__text {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
    text-wrap: balance;
  }
</style>
