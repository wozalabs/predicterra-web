---
/**
 * A titled section of a few large figures in a row, on hairlines, with their
 * sources in small type underneath (Resilience "why now").
 */
import SectionHead from './SectionHead.astro';
import type { Stat } from './types';

interface Props {
  id: string;
  title: string;
  text?: string;
  items: readonly Stat[];
  sources?: string;
  head?: 'center' | 'stack' | 'side';
}
const { id, title, text, items, sources, head = 'side' } = Astro.props;
---

<section class="fg pg-sec" aria-labelledby={id}>
  <div class="container pg-body">
    <SectionHead id={id} title={title} text={text} align={head} />
    <dl class="fg__list" style={`--n:${items.length}`} data-reveal-group>
      {
        items.map((f) => (
          <div class="fg__item" data-reveal>
            <dt class="fg__value t-num">{f.value}</dt>
            <dd class="fg__text">{f.text}</dd>
          </div>
        ))
      }
    </dl>
    {sources && <p class="pg-source" data-reveal>{sources}</p>}
  </div>
</section>

<style>
  .fg__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 48rem) {
    .fg__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }

  .fg__item {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .fg__value {
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .fg__text {
    max-width: 30ch;
    color: var(--ink-2);
  }
</style>
