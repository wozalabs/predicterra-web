---
/**
 * A list of points as quiet hairline rows (icon or running index, title, text).
 *  - without a side visual: the section head on top, the rows in two columns
 *  - with a side visual (diagram, code panel, mock-up): head and rows on one
 *    side, the visual held in place on the other while the rows pass
 */
import Icon from '../../components/Icon.astro';
import SectionHead from './SectionHead.astro';
import type { IconName } from '../../data/icons';

interface Props {
  id: string;
  title: string;
  text?: string;
  items: readonly { icon?: IconName | string; title: string; text: string }[];
  marker?: 'icon' | 'num';
  dark?: boolean;
  rule?: number;
  head?: 'center' | 'stack' | 'side';
  /** With a side visual: put the visual first (on the left). */
  sideFirst?: boolean;
}
const { id, title, text, items, marker = 'icon', dark = false, head = 'side', sideFirst = false } = Astro.props;
const hasSide = Astro.slots.has('side');
const pad = (n: number) => String(n).padStart(3, '0');
---

<section
  class:list={['rw pg-sec', hasSide ? 'rw--side' : 'rw--plain', sideFirst && 'rw--side-first']}
  aria-labelledby={id}
  data-dark={dark ? '' : undefined}
>
  <div class="container">
    <div class="pg-body">
      {!hasSide && <SectionHead id={id} title={title} text={text} align={head} />}
      <div class="rw__grid">
        {
          hasSide && (
            <div class="rw__head">
              <SectionHead id={id} title={title} text={text} align="stack" />
            </div>
          )
        }
        <ol class:list={['rw__list', `rw__list--${marker}`]} data-reveal-group>
          {
            items.map((it, i) => (
              <li class="rw__row" data-reveal>
                {marker === 'icon' && it.icon ? (
                  <Icon name={it.icon as IconName} boxed size="2.5rem" />
                ) : (
                  <span class="pg-idx rw__num">{pad(i + 1)}</span>
                )}
                <h3 class="rw__title">{it.title}</h3>
                <p class="rw__text">{it.text}</p>
              </li>
            ))
          }
        </ol>
        {
          hasSide && (
            <div class="rw__side" data-reveal>
              <div class="rw__side-sticky">
                <slot name="side" />
              </div>
            </div>
          )
        }
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  .rw__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem clamp(3rem, 1rem + 5vw, 7rem);
  }

  /* Plain: two columns of rows under the head. */
  @media (min-width: 48rem) {
    .rw--plain .rw__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 1rem + 4vw, 6rem);
    }
  }

  /* Side: head and rows on one side, the visual held on the other. */
  @media (min-width: 64rem) {
    .rw--side .rw__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        'head side'
        'list side';
      row-gap: clamp(2.5rem, 1.5rem + 2vw, 4rem);
    }
    .rw--side .rw__head {
      grid-area: head;
    }
    .rw--side .rw__list {
      grid-area: list;
    }
    .rw--side .rw__side {
      grid-area: side;
    }
    .rw--side .rw__side-sticky {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
    .rw--side-first .rw__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'side head'
        'side list';
    }
  }

  .rw__list {
    display: grid;
  }

  .rw__row {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    grid-template-areas:
      'm title'
      'm text';
    gap: 0.5rem 0.5rem;
    padding-block: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  .rw__row > :global(.ibox),
  .rw__num {
    grid-area: m;
  }

  .rw__num {
    padding-top: 0.35rem;
  }

  .rw__title {
    grid-area: title;
    align-self: center;
    font-size: var(--fs-h4);
    line-height: 1.2;
    letter-spacing: var(--track-title);
  }

  .rw__text {
    grid-area: text;
    max-width: 44ch;
    color: var(--ink-2);
  }
</style>
