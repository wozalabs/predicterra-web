---
/**
 * A section of points as a list: the section title on the left, the rows on
 * the right, each row with its title (and running index or orange icon) on the
 * left and its text on the right. Anything in the default slot follows the
 * list (a closing line, seals). `dark` turns the page dark around it.
 */
import Icon from '../../components/Icon.astro';
import SectionHead from './SectionHead.astro';
import type { IconName } from '../../data/icons';

interface Props {
  id: string;
  title: string;
  text?: string;
  items: readonly { icon?: IconName | string; title: string; text: string }[];
  marker?: 'icon' | 'num';
  dark?: boolean;
}
const { id, title, text, items, marker = 'icon', dark = false } = Astro.props;
const pad = (n: number) => String(n).padStart(3, '0');
---

<section class="rw pg-sec" aria-labelledby={id} data-dark={dark ? '' : undefined}>
  <div class="container rw__grid">
    <div class="rw__head">
      <SectionHead id={id} title={title} text={text} align="stack" />
    </div>
    <div class="rw__body">
      <ol class="rw__list" data-reveal-group>
        {
          items.map((it, i) => (
            <li class="rw__row" data-reveal>
              <h3 class="rw__title">
                {marker === 'icon' && it.icon ? (
                  <Icon name={it.icon as IconName} boxed size="2.25rem" />
                ) : (
                  <span class="pg-idx rw__num">{pad(i + 1)}</span>
                )}
                <span>{it.title}</span>
              </h3>
              <p class="rw__text">{it.text}</p>
            </li>
          ))
        }
      </ol>
      <slot />
    </div>
  </div>
</section>

<style>
  .rw__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .rw__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
    .rw__head {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
  }

  .rw__body {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .rw__list {
    display: grid;
  }

  .rw__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem var(--gutter);
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .rw__row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 48rem) {
    .rw__row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: baseline;
    }
  }

  .rw__title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .rw__title > :global(.ibox) {
    align-self: center;
  }

  .rw__num {
    flex: none;
    width: 2rem;
    transform: translateY(-0.2em);
  }

  .rw__text {
    max-width: 42ch;
    color: var(--ink-2);
  }
</style>
