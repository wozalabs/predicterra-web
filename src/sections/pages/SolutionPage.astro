---
/**
 * The seven Solutions pages ("predicterra-00-mapa-web.md"):
 * hero (logos under the title) · key figures (with the line and the link to
 * the cases) · the solution · use cases or sectors · CTA.
 *  - sector pages: the sector's asset from the home's 3D scene in the hero,
 *    on alternating sides, standing still
 *  - pages across all sectors: a type-only hero
 * Every section reads title on the left, content on the right; use cases and
 * sectors are a list of rows (title left, text right).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from './PageHero.astro';
import Stats from './Stats.astro';
import FigureList from './FigureList.astro';
import AssetView from '../../components/AssetView.astro';
import Cta from '../home/Cta.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { SolutionCopy } from './types';

interface Props {
  locale?: Locale;
  copy: SolutionCopy;
  /** Sector pages: which side the asset sits on, so the four don't open identically. */
  layout?: 'split' | 'split-reverse';
}
const { locale = 'en', copy: c, layout = 'split' } = Astro.props;
const pad = (n: number) => String(n).padStart(3, '0');
const s = c.solution;
---

<PageLayout title={c.seo.title} description={c.seo.description} locale={locale}>
  {
    c.asset ? (
      <PageHero locale={locale} {...c.hero} logos={c.proof.groups} layout={layout}>
        <AssetView slot="visual" asset={c.asset} />
      </PageHero>
    ) : (
      <PageHero locale={locale} {...c.hero} logos={c.proof.groups} layout="centred" />
    )
  }

  <!-- The solution enters as a panel over the key figures (scripts/panels.ts);
       light in the dark theme, dark in the light one. -->
  <div class="pnl">
    <Stats locale={locale} items={c.metrics} backing={{ text: c.proof.text, link: c.proof.link }} />

  <section class="so pg-sec" aria-labelledby="solution-title" data-dark>
    <div class="container so__grid">
      <h2 id="solution-title" class="so__title" data-render>{s.title}</h2>
      <div class="so__body">
        {s.figures && s.figuresFirst && <FigureList items={s.figures.map((f) => ({ value: f.value, label: f.text }))} size="md" />}
        {
          s.paragraphs && (
            <div class="so__text" data-reveal-group>
              {s.paragraphs.map((p) => (
                <p class="so__p" data-reveal>
                  {p}
                </p>
              ))}
            </div>
          )
        }
        {s.figures && !s.figuresFirst && <FigureList items={s.figures.map((f) => ({ value: f.value, label: f.text }))} size="md" />}
        {
          s.table && (
            <dl class="so__table" data-reveal-group>
              {s.table.rows.map(([a, b]) => (
                <div class="so__row" data-reveal>
                  <dt class="so__key">{a}</dt>
                  <dd class="so__val">{b}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {s.sources && <p class="so__sources t-small">{s.sources}</p>}
      </div>
    </div>
  </section>
  </div>

  <section class="ls pg-sec" aria-labelledby="list-title">
    <div class="container ls__grid">
      <h2 id="list-title" class="ls__head" data-render>{c.list.title}</h2>
      <ol class="ls__list" data-reveal-group>
        {
          c.list.items.map((it, i) => (
            <li class:list={['ls__row', it.href && 'ls__row--link']} data-reveal>
              <h3 class="ls__title">
                <span class="pg-idx">{pad(i + 1)}</span>
                {it.href ? (
                  <a class="ls__link" href={localizePath(it.href, locale)}>
                    {it.title}
                  </a>
                ) : (
                  <span>{it.title}</span>
                )}
              </h3>
              <p class="ls__text">{it.text}</p>
              {it.href && (
                <span class="ls__go" aria-hidden="true">
                  <svg viewBox="0 -960 960 960">
                    <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
                  </svg>
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="so-cta">
    <Cta locale={locale} copy={c.cta} />
  </div>
</PageLayout>

<style>
  /* ---------- The solution: title left, everything else on the right ---------- */
  .so__grid,
  .ls__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .so__grid,
    .ls__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .so__title,
  .ls__head {
    max-width: 18ch;
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  @media (min-width: 64rem) {
    .so__title,
    .ls__head {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
  }

  .so__body {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .so__text {
    display: grid;
    gap: 1.5rem;
    max-width: 62ch;
  }

  .so__p {
    font-size: var(--fs-lead);
    line-height: 1.55;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .so__p + .so__p {
    font-size: var(--fs-body);
    line-height: 1.6;
    letter-spacing: var(--track-body);
    color: var(--muted);
  }

  .so__sources {
    max-width: 70ch;
    color: var(--muted);
  }

  /* Compliance: framework · what you get, as a list of rows. */
  .so__table {
    display: grid;
  }

  .so__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem var(--gutter);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .so__row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 48rem) {
    .so__row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: baseline;
    }
  }

  .so__key {
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--track-heading);
  }

  .so__val {
    max-width: 46ch;
    color: var(--ink-2);
  }

  /* ---------- Use cases and sectors: a list, title left, text right ---------- */
  .ls__list {
    display: grid;
  }

  .ls__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem var(--gutter);
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .ls__row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 48rem) {
    .ls__row {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: baseline;
    }
    .ls__row--link {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr) auto;
    }
  }

  .ls__title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .ls__title .pg-idx {
    flex: none;
    width: 2rem;
    transform: translateY(-0.2em);
  }

  .ls__text {
    max-width: 40ch;
    color: var(--ink-2);
  }

  /* Linked rows: the whole row follows the title's link. */
  .ls__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ls__link:focus-visible {
    outline: none;
  }

  .ls__row:has(.ls__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .ls__go {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.25rem;
    height: 2.25rem;
    background: #e4e4e4;
    color: var(--ink);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  :global(:root[data-theme='dark']) .ls__go {
    background: var(--grey-600);
  }

  .ls__go svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .ls__row--link:hover .ls__go {
      background: var(--accent);
      color: var(--on-accent);
    }
    .ls__row--link:hover .ls__go svg {
      transform: translateX(2px);
    }
    .ls__row--link:hover .ls__link {
      color: var(--accent);
    }
  }

  @media (max-width: 47.99rem) {
    .ls__go {
      display: none;
    }
  }
</style>
