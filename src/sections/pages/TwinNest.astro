---
/**
 * Three kinds of twin as layers (Platform): isometric slabs, each twin
 * standing on the one that can do more, so the Cognitive Twin is the base
 * (white, orange sides). Under the slabs, the three twins in a row, in the
 * order they build up: descriptive, physical, then the Cognitive Twin on a
 * white card. Each one: its chip, its name, what it asks, what it does.
 */
import SectionHead from './SectionHead.astro';

interface Props {
  id: string;
  title: string;
  text?: string | readonly string[];
  columns: readonly string[];
  rows: readonly { label: string; cells: readonly string[] }[];
  tags: readonly string[];
  closing?: string;
}
const { id, title, text, columns, rows, tags, closing } = Astro.props;
const twins = columns.map((name, i) => ({ name, tag: tags[i], rows: rows.map((r) => ({ label: r.label, text: r.cells[i] })) }));
---

<section class="tn pg-sec" aria-labelledby={id}>
  <div class="container pg-body">
    <SectionHead id={id} title={title} text={text} align="center" />

    <div class="tn__iso">
      <div class="tn__stack" aria-hidden="true">
        <div class="tn__plane">
          <span class="tn__slab tn__slab--3"></span>
          <span class="tn__slab tn__slab--2"></span>
          <span class="tn__slab tn__slab--1"></span>
        </div>
      </div>
      <ol class="tn__legend" data-reveal-group>
        {twins.map((t, i) => (
          <li class:list={['tn__item', i === twins.length - 1 && 'tn__item--hi']} data-reveal>
            <span class:list={['tn__tag', i === twins.length - 1 && 'tn__tag--hi']}>{t.tag}</span>
            <h3 class="tn__name">{t.name}</h3>
            <dl class="tn__rows">
              {t.rows.map((r) => (
                <div>
                  <dt class="t-small">{r.label}</dt>
                  <dd>{r.text}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ol>
    </div>

    {
      closing && (
        <p class="pg-statement tn__closing" data-lit>
          {closing.split(' ').map((w) => (
            <span class="w">{w} </span>
          ))}
        </p>
      )
    }
  </div>
</section>

<style>
  .tn__iso {
    --tn-pad: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* The shadow sits on the stage: a filter on the 3D plane would flatten it. */
  .tn__stack {
    position: relative;
    height: clamp(18rem, 13rem + 14vw, 28rem);
    filter: drop-shadow(0 30px 40px rgb(30 30 30 / 0.12));
  }

  .tn__plane {
    --s: clamp(12rem, 8rem + 12vw, 20rem);
    --t: clamp(14px, 0.5rem + 1vw, 22px);
    position: absolute;
    left: 50%;
    top: 58%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: rotateX(58deg) rotateZ(-45deg);
  }

  .tn__slab {
    --w: var(--s);
    position: absolute;
    left: calc(var(--w) / -2);
    top: calc(var(--w) / -2);
    width: var(--w);
    height: var(--w);
    background: var(--top);
    transform-style: preserve-3d;
    transform: translateZ(var(--z));
  }

  /* Two visible sides: hung from the front edges. */
  .tn__slab::before,
  .tn__slab::after {
    content: '';
    position: absolute;
  }

  .tn__slab::before {
    left: 0;
    top: 100%;
    width: 100%;
    height: var(--t);
    background: var(--side-a);
    transform-origin: top;
    transform: rotateX(-90deg);
  }

  .tn__slab::after {
    left: 0;
    top: 0;
    width: var(--t);
    height: 100%;
    background: var(--side-b);
    transform-origin: left;
    transform: rotateY(90deg);
  }

  .tn__slab--3 {
    --z: 0px;
    --top: #ffffff;
    --side-a: #ff3700;
    --side-b: #d42300;
  }

  .tn__slab--2 {
    --w: calc(var(--s) * 0.66);
    --z: calc(var(--t) * 3.2);
    --top: #ececec;
    --side-a: #d6d6d6;
    --side-b: #c4c4c4;
    translate: calc(var(--s) * -0.1) calc(var(--s) * 0.1);
  }

  .tn__slab--1 {
    --w: calc(var(--s) * 0.36);
    --z: calc(var(--t) * 6.4);
    --top: #f6f6f6;
    --side-a: #dedede;
    --side-b: #cdcdcd;
    translate: calc(var(--s) * -0.18) calc(var(--s) * 0.18);
  }

  /* The three twins in a row (stacked on phones), on the same box so their
     copy lines up; the Cognitive Twin's on a white card, like its slab. */
  .tn__legend {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .tn__legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tn__item {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.625rem;
    padding: var(--tn-pad);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tn__item--hi {
    background: #ffffff;
    color: #1e1e1e;
    --ink: #1e1e1e;
    --ink-2: #4d4d4d;
    --muted: #767676;
    box-shadow:
      0 1px 2px rgb(30 30 30 / 0.06),
      0 18px 40px -12px rgb(30 30 30 / 0.14);
  }

  .tn__tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    background: var(--chip-bg);
    color: var(--ink-2);
    font-size: var(--fs-caption);
    white-space: nowrap;
  }

  .tn__tag--hi {
    background: var(--grad-accent);
    background-size: var(--grad-accent-size);
    color: #ffffff;
  }

  .tn__name {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.625rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: var(--track-heading);
  }

  .tn__item--hi .tn__name {
    font-weight: 500;
  }

  .tn__rows {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .tn__rows div {
    display: grid;
    align-content: start;
    gap: 0.125rem;
  }

  .tn__rows dt {
    color: var(--muted);
  }

  .tn__rows dd {
    color: var(--ink-2);
  }

  .tn__item--hi .tn__rows dd {
    color: var(--ink);
  }

  .tn__closing {
    max-width: 40ch;
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
</style>
