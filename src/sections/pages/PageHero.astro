---
/**
 * Page hero in two calm compositions:
 *  - centred: label, title and copy centred; a visual (slot "visual") as a wide
 *    band under it if there is one, otherwise the hero is type only
 *  - split / split-reverse: copy on one side, a full-height visual running to
 *    the page edge on the other
 */
import Button from '../../components/Button.astro';
import LogoBand from './LogoBand.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { LogoGroup } from '../../i18n/en/pages-shared';
import type { Link } from './types';

interface Props {
  locale?: Locale;
  label: string;
  title: string;
  text: string;
  primary?: Link;
  secondary?: Link;
  layout?: 'stack' | 'centred' | 'split' | 'split-reverse';
  logos?: LogoGroup[];
}
const {
  locale = 'en',
  label,
  title,
  text,
  primary,
  secondary,
  layout: rawLayout = 'centred',
  logos,
} = Astro.props;
const layout = rawLayout === 'stack' ? 'centred' : rawLayout;
const split = layout !== 'centred';
const hasVisual = Astro.slots.has('visual');
// Keep compound words whole ("deep-tech", "i-DE").
const nb = (s: string) => s.replace(/(\w)-(\w)/g, '$1‑$2');
---

<section class:list={['ph-hero', `ph-hero--${layout}`, !hasVisual && 'ph-hero--type']} aria-labelledby="page-title">
  <div class="container ph-hero__inner">
    <div class="ph-hero__copy">
      <p class="label ph-hero__label" data-reveal>{label}</p>
      <h1 id="page-title" class="ph-hero__title" data-render>{nb(title)}</h1>
      <p class="ph-hero__text" data-reveal>{text}</p>
      {
        (primary || secondary) && (
          <div class="ph-hero__actions" data-reveal>
            {primary && <Button href={localizePath(primary.href, locale)} label={primary.label} size="lg" />}
            {secondary && (
              <Button href={localizePath(secondary.href, locale)} label={secondary.label} size="lg" variant="secondary" />
            )}
          </div>
        )
      }
      {split && logos && <LogoBand groups={logos} class="ph-hero__logos" />}
    </div>

    {
      hasVisual && (
        <div class="ph-hero__media" data-reveal>
          <slot name="visual" />
        </div>
      )
    }

    {!split && logos && <LogoBand groups={logos} class="ph-hero__logos" />}
  </div>
</section>

<style>
  .ph-hero__inner {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: calc(var(--header-h) + clamp(3rem, 1.5rem + 8vh, 8rem));
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .ph-hero__copy {
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }

  .ph-hero__title {
    max-width: 17ch;
    font-size: var(--pg-hero);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .ph-hero__text {
    max-width: 50ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .ph-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .ph-hero__media {
    position: relative;
    min-height: clamp(18rem, 40svh, 36rem);
  }

  .ph-hero__media > :global(*) {
    height: 100%;
  }

  /* Type only: the hero is one calm screen-and-a-bit of words. */
  .ph-hero--type .ph-hero__inner {
    padding-top: calc(var(--header-h) + clamp(5rem, 3rem + 12vh, 11rem));
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .ph-hero--type .ph-hero__title {
    max-width: 20ch;
  }

  /* ----- centred ----- */
  .ph-hero--centred .ph-hero__copy {
    justify-items: center;
    text-align: center;
  }

  .ph-hero--centred .ph-hero__actions {
    justify-content: center;
  }

  .ph-hero--centred .ph-hero__media {
    min-height: clamp(20rem, 62svh, 44rem);
  }

  .ph-hero--centred :global(.ph-hero__logos) {
    justify-content: center;
  }

  /* ----- split ----- */
  @media (min-width: 64rem) {
    .ph-hero--split .ph-hero__inner,
    .ph-hero--split-reverse .ph-hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
      min-height: 100svh;
      column-gap: clamp(3rem, 1rem + 5vw, 7rem);
      padding-top: calc(var(--header-h) + 1rem);
      padding-bottom: 0;
    }
    .ph-hero--split .ph-hero__copy,
    .ph-hero--split-reverse .ph-hero__copy {
      grid-template-rows: auto auto auto auto 1fr;
      padding-block: clamp(3rem, 1rem + 8vh, 7rem) clamp(1.5rem, 1rem + 1vw, 2.5rem);
    }
    .ph-hero--split :global(.ph-hero__logos),
    .ph-hero--split-reverse :global(.ph-hero__logos) {
      align-self: end;
    }
    .ph-hero--split .ph-hero__media {
      margin-right: calc(-1 * var(--gutter));
    }
    .ph-hero--split-reverse .ph-hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .ph-hero--split-reverse .ph-hero__media {
      order: -1;
      margin-left: calc(-1 * var(--gutter));
    }
    .ph-hero--split .ph-hero__media,
    .ph-hero--split-reverse .ph-hero__media {
      min-height: 0;
    }
  }
</style>
