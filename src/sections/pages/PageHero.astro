---
/**
 * Page hero, one viewport tall, in four layouts so the pages don't all open the
 * same way: stack (title, then the visual across the page), split / split-reverse
 * (copy and a full-height visual side by side), centred (copy centred over a wide,
 * shorter visual). The visual is a placeholder unless a "visual" slot is passed.
 */
import Button from '../../components/Button.astro';
import Placeholder from '../../components/Placeholder.astro';
import LogoBand from './LogoBand.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { LogoGroup } from '../../i18n/en/pages-shared';
import type { Link } from './types';

interface Props {
  locale?: Locale;
  label: string;
  title: string;
  text: string;
  primary: Link;
  secondary: Link;
  visual: string;
  visualKind?: 'Animation' | 'Photo' | 'Image';
  layout?: 'stack' | 'split' | 'split-reverse' | 'centred';
  logos?: LogoGroup[];
}
const {
  locale = 'en',
  label,
  title,
  text,
  primary,
  secondary,
  visual,
  visualKind = 'Animation',
  layout = 'stack',
  logos,
} = Astro.props;
const hasVisual = Astro.slots.has('visual');
// Keep compound words whole ("deep-tech", "i-DE").
const nb = (s: string) => s.replace(/(\w)-(\w)/g, '$1‑$2');
---

<section class:list={['ph-hero', `ph-hero--${layout}`]} aria-labelledby="page-title">
  <div class="container ph-hero__inner">
    <div class="ph-hero__copy">
      <p class="label ph-hero__label" data-reveal>{label}</p>
      <h1 id="page-title" class="ph-hero__title" data-render>{nb(title)}</h1>
      <div class="ph-hero__side" data-reveal-group>
        <p class="ph-hero__text" data-reveal>{text}</p>
        <div class="ph-hero__actions" data-reveal>
          <Button href={localizePath(primary.href, locale)} label={primary.label} size="lg" />
          <Button href={localizePath(secondary.href, locale)} label={secondary.label} size="lg" variant="secondary" />
        </div>
      </div>
    </div>

    <div class="ph-hero__media" data-reveal>
      {hasVisual ? <slot name="visual" /> : <Placeholder kind={visualKind} text={visual} notch={layout !== 'centred'} />}
    </div>

    {logos && <LogoBand groups={logos} class="ph-hero__logos" />}
  </div>
</section>

<style>
  .ph-hero__inner {
    display: grid;
    gap: clamp(1.75rem, 1rem + 2vw, 3rem);
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 5vh, 5rem));
    padding-bottom: clamp(1.25rem, 0.75rem + 1vw, 2rem);
  }

  .ph-hero__copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .ph-hero__title {
    max-width: 18ch;
    font-size: var(--pg-hero);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .ph-hero__side {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .ph-hero__text {
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .ph-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .ph-hero__media {
    position: relative;
    min-height: clamp(16rem, 34svh, 30rem);
  }

  .ph-hero__media > :global(*) {
    height: 100%;
  }

  /* ----- stack: title, copy in the content column, the visual takes what's left ----- */
  .ph-hero--stack .ph-hero__inner {
    grid-template-rows: auto 1fr auto;
  }

  @media (min-width: 64rem) {
    .ph-hero--stack .ph-hero__copy {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: clamp(2.5rem, 1rem + 5vw, 7.5rem);
    }
    .ph-hero--stack .ph-hero__label,
    .ph-hero--stack .ph-hero__title {
      grid-column: 1 / -1;
    }
    .ph-hero--stack .ph-hero__side {
      grid-column: 2;
      margin-top: 0.75rem;
    }
  }

  /* ----- split: copy left, a full-height visual right (or the other way round) ----- */
  @media (min-width: 64rem) {
    .ph-hero--split .ph-hero__inner,
    .ph-hero--split-reverse .ph-hero__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      grid-template-rows: 1fr auto;
      column-gap: clamp(2.5rem, 1rem + 4vw, 6rem);
    }
    .ph-hero--split .ph-hero__copy,
    .ph-hero--split-reverse .ph-hero__copy {
      align-content: center;
      padding-bottom: 2rem;
    }
    .ph-hero--split .ph-hero__media,
    .ph-hero--split-reverse .ph-hero__media {
      grid-row: 1 / 3;
      margin-top: calc(-1 * clamp(2rem, 1rem + 5vh, 5rem) + 0.5rem);
    }
    .ph-hero--split .ph-hero__media {
      grid-column: 2;
      margin-right: calc(-1 * var(--gutter));
    }
    .ph-hero--split-reverse .ph-hero__media {
      grid-column: 1;
      grid-row: 1 / 3;
      margin-left: calc(-1 * var(--gutter));
    }
    .ph-hero--split-reverse .ph-hero__copy,
    .ph-hero--split-reverse .ph-hero__logos {
      grid-column: 2;
    }
    .ph-hero--split .ph-hero__logos {
      grid-column: 1;
    }
    .ph-hero--split .ph-hero__title,
    .ph-hero--split-reverse .ph-hero__title {
      max-width: 14ch;
    }
  }

  /* ----- centred: copy centred, a wide shorter visual under it ----- */
  .ph-hero--centred .ph-hero__inner {
    grid-template-rows: auto 1fr auto;
  }

  .ph-hero--centred .ph-hero__copy {
    justify-items: center;
    text-align: center;
  }

  .ph-hero--centred .ph-hero__side {
    justify-items: center;
  }

  .ph-hero--centred .ph-hero__actions {
    justify-content: center;
  }

  .ph-hero--centred .ph-hero__logos {
    justify-content: center;
  }

  @media (min-width: 64rem) {
    .ph-hero--centred .ph-hero__media {
      margin-inline: calc(-1 * var(--gutter));
    }
  }
</style>
