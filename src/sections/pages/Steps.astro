---
/**
 * Numbered steps joined by tick lines (horizontal on wide screens, vertical on
 * phones). Each stretch fills tick by tick, one stretch after the other, as the
 * steps scroll in (the home asset panel's stepped bars); the last stretch and
 * the last step are orange. Optional mini captures under each step, and an
 * optional side card (buyer's guide), shown only once it is ready.
 */
import Placeholder from '../../components/Placeholder.astro';
import TextLink from '../../components/TextLink.astro';
import SectionHead from './SectionHead.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { Link } from './types';

interface Props {
  locale?: Locale;
  id: string;
  title: string;
  text?: string;
  steps: readonly { title: string; text: string; shot?: string }[];
  guide?: { ready: boolean; text: string; link: Link };
  head?: 'center' | 'stack' | 'side';
}
const { locale = 'en', id, title, text, steps, guide, head = 'center' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const n = steps.length;
---

<section class="sp pg-sec" aria-labelledby={id} style={`--n:${n}`}>
  <div class="container">
    <div class="pg-body">
      <SectionHead id={id} title={title} text={text} align={head} />

      <ol class="sp__list" data-progress>
        {
          steps.map((s, i) => (
            <li class:list={['sp__step', i === n - 1 && 'is-last']}>
              <span class="sp__num t-num" aria-hidden="true">
                {pad(i + 1)}
              </span>
              {i < n - 1 && (
                <span
                  class:list={['tick sp__link', i === n - 2 && 'tick--accent']}
                  aria-hidden="true"
                  style={`--p:clamp(0, calc(var(--pp, 1) * ${n - 1} - ${i}), 1)`}
                />
              )}
              <h3 class="sp__title">{s.title}</h3>
              <p class="sp__text">{s.text}</p>
              {s.shot && <Placeholder kind="Platform capture" text={s.shot} ratio="4 / 3" compact class="sp__shot" />}
            </li>
          ))
        }
      </ol>

      {
        guide?.ready && (
          <aside class="sp__guide" data-reveal>
            <p>{guide.text}</p>
            <TextLink href={localizePath(guide.link.href, locale)} label={guide.link.label} />
          </aside>
        )
      }
    </div>
  </div>
</section>

<style>
  .sp__list {
    --sq: 2.75rem;
    --pp: var(--p, 1);
    display: grid;
    gap: 0;
  }

  .sp__step {
    position: relative;
    display: grid;
    grid-template-columns: var(--sq) minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    padding-bottom: 3rem;
  }

  .sp__step > :not(.sp__num):not(.sp__link) {
    grid-column: 2;
  }

  .sp__num {
    position: relative;
    z-index: 1;
    grid-row: 1 / 4;
    display: grid;
    place-items: center;
    width: var(--sq);
    height: var(--sq);
    background: var(--ink);
    color: var(--canvas-mix);
    font-size: var(--fs-small);
  }

  .sp__step.is-last .sp__num {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* Phones: a vertical stretch from this square down to the next. */
  .sp__link {
    position: absolute;
    left: calc(var(--sq) / 2 - 3px);
    top: calc(var(--sq) + 0.5rem);
    bottom: 0.5rem;
    width: 6px;
    height: auto;
    --ticks: repeating-linear-gradient(180deg, currentColor 0 2px, transparent 2px 5px);
  }

  .sp__link::after {
    inset: 0 0 auto 0;
    width: auto;
    height: calc(var(--p, 1) * 100%);
    height: round(down, calc(var(--p, 1) * 100%), 5px);
  }

  .sp__title {
    align-self: center;
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: var(--track-title);
  }

  .sp__text {
    max-width: 34ch;
    color: var(--ink-2);
  }

  .sp__step :global(.sp__shot) {
    margin-top: 1rem;
    max-width: 22rem;
  }

  @media (min-width: 48rem) {
    .sp__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .sp__step {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      row-gap: 1rem;
      padding-bottom: 0;
    }

    .sp__step > :not(.sp__num):not(.sp__link) {
      grid-column: 1;
    }

    .sp__num {
      grid-row: auto;
      margin-bottom: 1rem;
    }

    /* Wide: a horizontal stretch from this square to the next one. */
    .sp__link {
      left: calc(var(--sq) + 0.75rem);
      right: calc(-1 * var(--gutter) + 0.75rem);
      top: calc(var(--sq) / 2 - 3px);
      bottom: auto;
      width: auto;
      height: 6px;
      --ticks: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px);
    }

    .sp__link::after {
      inset: 0 auto 0 0;
      height: auto;
      width: calc(var(--p, 1) * 100%);
      width: round(down, calc(var(--p, 1) * 100%), 5px);
    }

    .sp__step :global(.sp__shot) {
      max-width: none;
    }
  }

  .sp__guide {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.5rem;
    background: var(--card);
  }
</style>
