---
/** Logo strip under the heroes, in two labelled groups (clients in operation, recognition). */
import BrandLogo from '../../components/BrandLogo.astro';
import type { LogoGroup } from '../../i18n/en/pages-shared';

interface Props {
  groups: LogoGroup[];
  /** Scale on the logos' tuned heights (the home's band after the capture is larger). */
  scale?: number;
  class?: string;
}
const { groups, scale = 1, class: className } = Astro.props;
---

<div class:list={['lb', className]}>
  {
    groups.map((g) => (
      <div class="lb__group">
        <p class="lb__label t-caption">{g.label}</p>
        <ul class="lb__list">
          {g.items.map((it) => (
            <li class="lb__item">
              {it.src ? (
                <BrandLogo src={it.src} name={it.name} height={Math.round((it.h ?? 20) * scale)} w={it.w ?? 1} h0={it.h0 ?? 1} />
              ) : (
                <span class="lb__word">{it.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .lb {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem clamp(2rem, 1rem + 4vw, 5rem);
  }

  .lb__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem clamp(1.25rem, 0.75rem + 1.5vw, 2.5rem);
  }

  .lb__label {
    color: var(--muted);
    white-space: nowrap;
  }

  .lb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem);
  }

  .lb__item {
    display: flex;
    align-items: center;
    height: 2.25rem;
  }

  /* The logos keep their colours (BrandLogo); the names without a file are set in ink. */
  .lb__word {
    font-size: 1.125rem;
    letter-spacing: var(--track-title);
    color: var(--ink);
  }
</style>
