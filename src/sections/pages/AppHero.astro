---
/**
 * App hero (Platform): one screen, side by side. The label, title, text and
 * action on the left; the platform capture on the right (the home's silent
 * loop, no controls, playing only while on screen). Both sit inside the first
 * viewport on desktop; on phones the capture follows the copy. Follows the
 * site theme. The title has the page-title entrance (components/PageTitle).
 */
import Button from '../../components/Button.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getCopy, localizePath, withBase, type Locale } from '../../i18n/config';
import type { Link } from './types';

interface Props {
  locale?: Locale;
  id?: string;
  label?: string;
  titleLine1: string;
  titleLine2: string;
  text: string;
  primary: Link;
  secondary?: Link;
}
const { locale = 'en', id = 'page-title', label, titleLine1, titleLine2, text, primary, secondary } = Astro.props;
const v = getCopy(locale).home.showcase.video;
---

<section class="aph" aria-labelledby={id}>
  <div class="container aph__inner">
    <div class="aph__copy">
      {label && <p class="label aph__label">{label}</p>}
      <PageTitle id={id} class="aph__title" text={`${titleLine1} ${titleLine2}`} />
      <p class="aph__text">{text}</p>
      <div class="aph__actions">
        <Button href={localizePath(primary.href, locale)} label={primary.label} size="lg" />
        {secondary && <Button href={localizePath(secondary.href, locale)} label={secondary.label} size="lg" variant="secondary" />}
      </div>
    </div>

    <figure class="aph__frame">
      <video
        class="aph__video"
        width={v.w}
        height={v.h}
        poster={withBase(v.poster)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
        tabindex="-1"
        aria-label={v.label}
        data-aph-video
      >
        <source src={withBase(v.small)} type="video/mp4" media="(max-width: 47.99rem)" />
        <source src={withBase(v.large)} type="video/mp4" />
      </video>
    </figure>
  </div>
</section>

<style>
  .aph__inner {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: calc(var(--header-h) + clamp(2.5rem, 1.5rem + 5vh, 5rem));
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  /* Desktop: copy and capture side by side, together inside the first screen. */
  @media (min-width: 64rem) {
    .aph__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
      align-items: center;
      min-height: 100svh;
      padding-top: calc(var(--header-h) + 2rem);
      padding-bottom: 2rem;
    }
  }

  .aph__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
  }

  .aph__label {
    color: var(--muted);
  }

  .aph__title {
    max-width: 14ch;
    font-size: var(--pg-hero);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .aph__text {
    max-width: 40ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .aph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .aph__frame {
    position: relative;
    background: #161616;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.55);
  }

  /* Never taller than what is left of the screen under the header. */
  @media (min-width: 64rem) {
    .aph__frame {
      max-height: calc(100svh - var(--header-h) - 4rem);
      aspect-ratio: 1920 / 1076;
      justify-self: end;
      width: min(100%, calc((100svh - var(--header-h) - 4rem) * 1920 / 1076));
    }
  }

  /* No controls and no pointer: the loop cannot be paused, scrubbed or opened. */
  .aph__video {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  /* Entrance: after the title, the copy focuses in and the capture rises. */
  @media (prefers-reduced-motion: no-preference) {
    .aph__label,
    .aph__text,
    .aph__actions {
      animation: aph-focus 900ms cubic-bezier(0.19, 1, 0.22, 1) both;
    }
    .aph__label {
      animation-delay: 120ms;
    }
    .aph__text {
      animation-delay: 460ms;
    }
    .aph__actions {
      animation-delay: 560ms;
    }
    .aph__frame {
      animation: aph-rise 1300ms cubic-bezier(0.19, 1, 0.22, 1) 380ms both;
    }
  }

  @keyframes aph-focus {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(6px);
    }
  }

  @keyframes aph-rise {
    from {
      opacity: 0;
      transform: translateY(3rem);
    }
  }
</style>

<script>
  /* The loop plays only while on screen; reduced motion: the poster. */
  const video = document.querySelector<HTMLVideoElement>('[data-aph-video]');
  if (video) {
    video.muted = true;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    } else {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }).observe(video);
    }
  }
</script>
