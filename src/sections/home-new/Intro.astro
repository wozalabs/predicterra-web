---
/**
 * New home: the claim before the 3D scene. "Energy is one machine. Run it like
 * one." with its line, and the four sector links.
 */
import { getCopy, localizePath, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { scene, sectorsLink } = getCopy(locale).homeNew;
---

<section class="nh-intro" aria-labelledby="intro-title">
  <div class="container nh-intro__grid">
    <h2 id="intro-title" class="nh-intro__title" data-render>{scene.title}</h2>
    <div class="nh-intro__side">
      <p class="nh-intro__text" data-reveal>{scene.intro}</p>
      <nav class="nh-intro__links" aria-label={sectorsLink.label} data-reveal>
        <span class="t-small nh-intro__label">{sectorsLink.label}</span>
        <ul>
          {
            sectorsLink.links.map((l) => (
              <li>
                <a href={localizePath(l.href, locale)}>
                  <span>{l.label}</span>
                  <span class="nh-intro__sq" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</section>

<style>
  .nh-intro {
    position: relative;
    z-index: var(--z-cover);
    display: flex;
    align-items: center;
    min-height: min(100svh, 54rem);
    padding-block: clamp(6rem, 4rem + 6vw, 11rem);
    background: var(--canvas);
  }

  .nh-intro__grid {
    display: grid;
    gap: 3rem clamp(3rem, 1rem + 6vw, 8rem);
    width: 100%;
  }

  @media (min-width: 64rem) {
    .nh-intro__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  .nh-intro__title {
    max-width: 12em;
    font-size: clamp(2.25rem, 1.2rem + 2.9vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .nh-intro__side {
    display: grid;
    gap: 2.5rem;
  }

  .nh-intro__text {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .nh-intro__label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--muted);
  }

  .nh-intro__links ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  .nh-intro__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
    transition: color 160ms ease;
  }

  .nh-intro__sq {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    transform: scale(0);
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nh-intro__links a:hover .nh-intro__sq {
      transform: scale(1);
    }
  }
</style>
