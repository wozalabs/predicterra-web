---
/**
 * New home: the four figures, large, after the dark Teams section. It brings
 * the light back (theme-scrub), like Key figures on the current home.
 */
import { getCopy, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { figures } = getCopy(locale).homeNew;
---

<section class="nh-fig theme-scrub" aria-label="Predicterra in figures">
  <div class="container">
    <dl class="nh-fig__list" data-reveal-group>
      {
        figures.map((f) => (
          <div class="nh-fig__item" data-reveal>
            <dt class="nh-fig__value t-num" data-render>{f.value}</dt>
            <dd class="nh-fig__text">{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .nh-fig {
    position: relative;
    z-index: var(--z-cover);
    padding-block: clamp(6rem, 4rem + 7vw, 12rem);
  }

  .nh-fig__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--gutter);
  }

  @media (min-width: 64rem) {
    .nh-fig__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .nh-fig__item {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .nh-fig__value {
    font-size: clamp(2.5rem, 1.4rem + 3.4vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: var(--track-display);
    white-space: nowrap;
  }

  .nh-fig__text {
    max-width: 22ch;
    color: var(--ink-2);
  }
</style>
