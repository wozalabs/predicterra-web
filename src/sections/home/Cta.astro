---
import Button from '../../components/Button.astro';
import { getCopy, localizePath, type Locale } from '../../i18n/config';

interface CtaCopy {
  /** Optional: pages whose brief has no label above the title leave it out. */
  label?: string;
  titleLine1: string;
  titleLine2: string;
  titleAccent: string;
  text: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string; external?: boolean };
}
interface Props {
  locale?: Locale;
  /** Other pages pass their own copy; defaults to the homepage CTA. */
  copy?: CtaCopy;
}
const { locale = 'en', copy } = Astro.props;
const cta: CtaCopy = copy ?? getCopy(locale).home.cta;
---

<!--
  Action card, inset from the page edges. The 3D section's white assets sit
  on both sides (scripts/cta-scene.ts, lazy) and tilt with the pointer.
-->
<section class="cta" id="contact" aria-labelledby="cta-title">
  <div class="cta__card" data-cta-card data-reveal>
    <canvas class="cta__scene" aria-hidden="true" data-cta-canvas></canvas>
    <div class="cta__veil" aria-hidden="true"></div>

    <div class="cta__content">
      {cta.label && <p class="label cta__label" data-render>{cta.label}</p>}
      <h2 id="cta-title" class="t-h2 cta__title" data-render>
        <span class="cta__line">{cta.titleLine1}</span>
        <span class="cta__line">{cta.titleLine2} <span class="accent">{cta.titleAccent}</span></span>
      </h2>
      <p class="cta__text">{cta.text}</p>
      <div class="cta__actions">
        <Button href={localizePath(cta.primary.href, locale)} label={cta.primary.label} size="lg" />
        {
          cta.secondary && (
            <Button
              href={cta.secondary.external === false ? localizePath(cta.secondary.href, locale) : cta.secondary.href}
              label={cta.secondary.label}
              variant="secondary"
              size="lg"
              external={cta.secondary.external !== false}
            />
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    z-index: var(--z-cover);
    background: var(--canvas);
    padding: clamp(2rem, 1rem + 3vw, 4rem) var(--gutter) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .cta__card {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    place-items: center;
    min-height: clamp(30rem, 58vh, 38rem);
    max-width: var(--max-w);
    margin-inline: auto;
    padding: clamp(3rem, 2rem + 4vw, 5.5rem) var(--gutter);
    /* Matches CTA_GROUND in scripts/cta-scene.ts (shown until WebGL is ready). */
    background: #eaeaea;
    /* Notched top edge: the success-stories card notch, mirrored to the top. */
    clip-path: polygon(0 18px, calc(42% - 18px) 18px, 42% 0, 100% 0, 100% 100%, 0 100%);
    color: var(--ink);
  }

  .cta__scene {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .cta__scene[data-ready] {
    opacity: 1;
  }

  /* Plain ground behind the copy, so the assets and their shadows never touch the text. */
  .cta__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 34% 52% at 50% 50%, #eaeaea 55%, rgb(234 234 234 / 0) 100%);
    pointer-events: none;
  }

  .cta__content {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 44rem;
    text-align: center;
  }

  .cta__title {
    display: grid;
  }

  .cta__line {
    white-space: nowrap;
  }

  .cta__text {
    max-width: 40ch;
    color: var(--ink-2);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (max-width: 47.99rem) {
    /* Room above and below the copy for the two clusters */
    .cta__card {
      min-height: 44rem;
      padding-block: 11rem 12rem;
    }
    .cta__line {
      white-space: normal;
    }
    .cta__veil {
      background: radial-gradient(ellipse 70% 34% at 50% 50%, #eaeaea 60%, rgb(234 234 234 / 0) 100%);
    }
  }
</style>

<script>
  import type { CtaScene } from '../../scripts/cta-scene';

  const card = document.querySelector<HTMLElement>('[data-cta-card]');
  const canvas = card?.querySelector<HTMLCanvasElement>('[data-cta-canvas]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (card && canvas) {
    let scene: CtaScene | null = null;
    let visible = false;
    let raf = 0;
    let last = 0;

    const frame = (now: number) => {
      raf = 0;
      if (!scene || !visible) return;
      const dt = last ? (now - last) / 1000 : 1 / 60;
      last = now;
      const moving = scene.tick(dt);
      if (moving) raf = requestAnimationFrame(frame);
    };
    const start = () => {
      if (!raf && visible && scene) {
        last = 0;
        raf = requestAnimationFrame(frame);
      }
    };

    const boot = async () => {
      try {
        const { createCtaScene } = await import('../../scripts/cta-scene');
        scene = createCtaScene(canvas, { reducedMotion: reduce });
        const r = card.getBoundingClientRect();
        scene.resize(r.width, r.height);
        scene.tick(0);
        canvas.dataset.ready = '';
        new ResizeObserver(([e]) => {
          scene?.resize(e.contentRect.width, e.contentRect.height);
          scene?.tick(0);
        }).observe(card);
        start();
      } catch {
        /* No WebGL: the card stays plain orange. */
      }
    };

    // Load three.js only when the card gets close.
    const near = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          near.disconnect();
          boot();
        }
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(card);

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) start();
    }).observe(card);

    // Pointer tilt (mouse only), relative to the card centre.
    card.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !scene) return;
      const r = card.getBoundingClientRect();
      scene.setPointer(((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1);
      start();
    });
    card.addEventListener('pointerleave', () => {
      scene?.setPointer(0, 0);
      start();
    });
  }
</script>
