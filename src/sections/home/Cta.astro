---
import Button from '../../components/Button.astro';
import { getCopy, localizePath, type Locale } from '../../i18n/config';

interface CtaCopy {
  title: string;
  accent?: string;
  primary: { label: string; href: string };
}
interface Props {
  locale?: Locale;
  /** Other pages pass their own copy; defaults to the homepage CTA. */
  copy?: CtaCopy;
}
const { locale = 'en', copy } = Astro.props;
const cta: CtaCopy = copy ?? getCopy(locale).home.cta;
---

<!--
  Action card, inset from the page edges: one large title in the bottom-left
  corner and its button in the same row, on the right. The 3D section's white assets fill the rest of the
  card (scripts/cta-scene.ts, lazy) and tilt with the pointer.
-->
<section class="cta" id="contact" aria-labelledby="cta-title">
  <div class="cta__card" data-cta-card data-reveal>
    <canvas class="cta__scene" aria-hidden="true" data-cta-canvas></canvas>
    <div class="cta__veil" aria-hidden="true"></div>

    <div class="cta__content">
      <h2 id="cta-title" class="cta__title" data-render>
        {cta.accent ? `${cta.title} ` : cta.title}
        {cta.accent && <span class="accent">{cta.accent}</span>}
      </h2>
      <Button href={localizePath(cta.primary.href, locale)} label={cta.primary.label} size="lg" />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    z-index: var(--z-cover);
    background: var(--canvas);
    padding: clamp(2rem, 1rem + 3vw, 4rem) var(--gutter) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .cta__card {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    align-items: end;
    min-height: clamp(30rem, 58vh, 38rem);
    max-width: var(--max-w);
    margin-inline: auto;
    padding: 32px;
    /* Matches palette.ctaGround in scripts/sector-scene/palette.ts (shown until WebGL is ready). */
    background: var(--cta-ground);
    /* Notched top edge: the success-stories card notch, mirrored to the top. */
    clip-path: var(--notch-top);
    /* The opposite of the page behind it: dark on the light theme… */
    color: #ffffff;
    --ink: #ffffff;
    --burn-base: rgb(178 36 6);
    --burn-tint: rgb(255 98 30);
  }

  /* …light on the dark one. */
  :global(:root[data-theme='dark']) .cta__card {
    color: #1e1e1e;
    --ink: #1e1e1e;
    --burn-base: rgb(74 18 6);
    --burn-tint: rgb(254 60 1);
  }

  .cta__scene {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .cta__scene[data-ready] {
    opacity: 1;
  }

  /* Plain ground behind the copy, so the assets and their shadows never touch the text. */
  .cta__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* The bottom row (title and button) on plain ground, across the card. */
    background:
      radial-gradient(ellipse 62% 70% at 0% 100%, var(--cta-ground) 50%, rgb(var(--cta-ground-rgb) / 0) 100%),
      linear-gradient(to top, var(--cta-ground) 22%, rgb(var(--cta-ground-rgb) / 0) 48%);
    pointer-events: none;
  }

  /* Title and button in one row, sharing the last line (stacked on phones). */
  .cta__content {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem) 2rem;
  }

  .cta__title {
    font-size: clamp(3rem, 1.25rem + 5.5vw, 7rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }

  @media (max-width: 47.99rem) {
    /* Room above the copy for the two clusters. */
    .cta__card {
      min-height: 40rem;
    }
    .cta__veil {
      background: linear-gradient(to top, var(--cta-ground) 40%, rgb(var(--cta-ground-rgb) / 0) 70%);
    }
  }
</style>

<script>
  import type { CtaScene } from '../../scripts/cta-scene';
  import { onThemeChange } from '../../scripts/theme';

  const card = document.querySelector<HTMLElement>('[data-cta-card]');
  const canvas = card?.querySelector<HTMLCanvasElement>('[data-cta-canvas]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (card && canvas) {
    let scene: CtaScene | null = null;
    let visible = false;
    let raf = 0;
    let last = 0;

    const frame = (now: number) => {
      raf = 0;
      if (!scene || !visible) return;
      const dt = last ? (now - last) / 1000 : 1 / 60;
      last = now;
      const moving = scene.tick(dt);
      if (moving) raf = requestAnimationFrame(frame);
    };
    const start = () => {
      if (!raf && visible && scene) {
        last = 0;
        raf = requestAnimationFrame(frame);
      }
    };

    const boot = async () => {
      try {
        const { createCtaScene } = await import('../../scripts/cta-scene');
        scene = createCtaScene(canvas, { reducedMotion: reduce });
        const r = card.getBoundingClientRect();
        scene.resize(r.width, r.height);
        scene.tick(0);
        canvas.dataset.ready = '';
        new ResizeObserver(([e]) => {
          scene?.resize(e.contentRect.width, e.contentRect.height);
          scene?.tick(0);
        }).observe(card);
        start();
      } catch {
        /* No WebGL: the card stays plain orange. */
      }
    };

    onThemeChange(() => {
      scene?.setTheme();
      scene?.tick(0);
    });

    // Load three.js only when the card gets close.
    const near = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          near.disconnect();
          boot();
        }
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(card);

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) start();
    }).observe(card);

    // Pointer tilt (mouse only), relative to the card centre.
    card.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !scene) return;
      const r = card.getBoundingClientRect();
      scene.setPointer(((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1);
      start();
    });
    card.addEventListener('pointerleave', () => {
      scene?.setPointer(0, 0);
      start();
    });
  }
</script>
