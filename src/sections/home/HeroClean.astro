---
/**
 * Hero, clean layout (default). The video, the title, a line of copy, one
 * action and the partner logos. On load the footage assembles from big pixels
 * with gaps of the page background (scripts/hero-mosaic.ts), then the title
 * lines slide up out of a mask and the rest settles in.
 */
import Button from '../../components/Button.astro';
import Logos from './Logos.astro';
import { getCopy, localizePath, withBase, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { hero } = getCopy(locale).home;
const { video, clean } = hero;
---

<section class="hcl theme-dark" aria-labelledby="hcl-title" data-hero-variant="clean" data-header-dark>
  <video
    class="hcl__video"
    muted
    loop
    playsinline
    preload="metadata"
    poster={withBase(video.poster)}
    disablepictureinpicture
    aria-hidden="true"
    data-hero-video
  >
    <source src={withBase(video.large)} type="video/mp4" media="(min-width: 60em)" />
    <source src={withBase(video.small)} type="video/mp4" />
  </video>
  <div class="hcl__scrim" aria-hidden="true"></div>
  <canvas class="hcl__mosaic" aria-hidden="true" data-hero-mosaic></canvas>

  <div class="hcl__content container">
    <h1 id="hcl-title" class="hcl__title">
      <span class="hcl__line"><span>{clean.titleLine1}</span></span>
      <span class="hcl__line"><span>{clean.titleLine2}</span></span>
    </h1>
    <p class="hcl__text">{clean.text}</p>
    <Button class="hcl__cta" href={localizePath(clean.cta.href, locale)} label={clean.cta.label} size="lg" />
  </div>

  <!-- Partner logos along the bottom edge, over the video -->
  <div class="hcl__logos container">
    <div class="hcl__logos-inner">
      <Logos locale={locale} class="hcl__logos-row" />
    </div>
  </div>
</section>

<style>
  .hcl {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    background: var(--grey-700);
  }

  .hcl__video,
  .hcl__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hcl__video {
    object-fit: cover;
  }

  /* Dimmed so the footage stays in the background; darker behind the copy. */
  .hcl__video {
    filter: saturate(0.8);
  }

  .hcl__scrim {
    background:
      linear-gradient(to bottom, rgb(16 16 16 / 0.35), rgb(16 16 16 / 0) 24%),
      linear-gradient(to top, rgb(16 16 16 / 0.82), rgb(16 16 16 / 0) 62%),
      rgb(16 16 16 / 0.38);
  }

  .hcl__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--logos-h) + clamp(2rem, 1rem + 4vh, 4.5rem));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hcl {
    --logos-h: clamp(4.5rem, 3.5rem + 2vw, 5.75rem);
  }

  .hcl__text {
    max-width: 34rem;
    margin-top: clamp(1rem, 0.75rem + 0.8vw, 1.5rem);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.45;
    letter-spacing: var(--track-body);
    color: rgb(255 255 255 / 0.78);
  }

  .hcl__content :global(.hcl__cta) {
    margin-top: clamp(1.5rem, 1rem + 1.2vw, 2.25rem);
  }

  /* Logos row: a hairline, then the marks in white */
  .hcl__logos {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0 auto;
  }

  .hcl__logos-inner {
    display: flex;
    align-items: center;
    height: var(--logos-h);
  }

  /* Left-aligned, never past the middle of the screen */
  .hcl__logos :global(.hcl__logos-row) {
    --logo-scale: 0.78;
    width: min(100%, 50vw);
  }

  .hcl__logos :global(.logos__list) {
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: clamp(1.25rem, 0.5rem + 1.5vw, 2.25rem);
  }

  .hcl__logos :global(.logos__item img) {
    filter: brightness(0) invert(1);
    opacity: 0.72;
  }

  @media (max-width: 47.99rem) {
    .hcl {
      --logos-h: 7rem;
    }
    .hcl__logos :global(.hcl__logos-row) {
      --logo-scale: 0.62;
      width: 100%;
    }
    .hcl__logos :global(.logos__list) {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      justify-content: start;
      gap: 1rem 1.75rem;
    }
  }

  .hcl__title {
    display: grid;
    font-size: clamp(2.75rem, 1rem + 4.6vw, 6rem);
    line-height: 0.96;
    letter-spacing: var(--track-display);
    color: #ffffff;
  }

  /* ---------- Entrance ----------
     While html.hero-intro is set (inline script in BaseLayout, removed by
     hero-mosaic.ts) the section shows the page background and the footage is
     drawn as a pixel mosaic on the canvas. Then the copy comes in:
     title lines slide up out of a mask, the rest focuses in, logos one by one. */
  .hcl__mosaic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    /* Matches the dimmed video + scrim, so the hand-off is seamless */
    filter: saturate(0.8) brightness(0.58);
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
  }

  :global(html.hero-intro) .hcl {
    background: var(--canvas);
  }

  :global(html.hero-intro) .hcl__mosaic {
    opacity: 1;
    transition: none;
  }

  .hcl__video,
  .hcl__scrim {
    transition: opacity 420ms ease;
  }

  :global(html.hero-intro) .hcl__video,
  :global(html.hero-intro) .hcl__scrim {
    opacity: 0;
    transition: none;
  }

  /* Masked lines (padding keeps descenders inside the mask) */
  .hcl__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .hcl__line > span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hcl__line > span {
      animation: hcl-line 1100ms cubic-bezier(0.19, 1, 0.22, 1) both;
      animation-delay: var(--d, 0ms);
    }
    .hcl__line:nth-child(1) > span {
      --d: 620ms;
    }
    .hcl__line:nth-child(2) > span {
      --d: 720ms;
    }
    .hcl__text,
    .hcl__content :global(.hcl__cta) {
      animation: hcl-focus 900ms cubic-bezier(0.19, 1, 0.22, 1) both;
    }
    .hcl__text {
      animation-delay: 900ms;
    }
    .hcl__content :global(.hcl__cta) {
      animation-delay: 1000ms;
    }
    .hcl__logos :global(.logos__item) {
      animation: hcl-focus 900ms cubic-bezier(0.19, 1, 0.22, 1) both;
      animation-delay: calc(1100ms + var(--li, 0) * 70ms);
    }
    .hcl__logos :global(.logos__item:nth-child(2)) {
      --li: 1;
    }
    .hcl__logos :global(.logos__item:nth-child(3)) {
      --li: 2;
    }
    .hcl__logos :global(.logos__item:nth-child(4)) {
      --li: 3;
    }
    .hcl__logos :global(.logos__item:nth-child(5)) {
      --li: 4;
    }
  }

  @keyframes hcl-line {
    from {
      transform: translateY(108%);
    }
  }

  @keyframes hcl-focus {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hcl__mosaic {
      display: none;
    }
  }
</style>

<script>
  import { mountHeroVideos } from '../../scripts/hero-video';
  import { mountHeroMosaic } from '../../scripts/hero-mosaic';
  mountHeroVideos();
  const root = document.querySelector<HTMLElement>('[data-hero-variant="clean"]');
  if (root && root.getClientRects().length) mountHeroMosaic(root);
  else document.documentElement.classList.remove('hero-intro');
</script>
