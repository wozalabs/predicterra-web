---
/**
 * Hero, clean layout (test). Only the video, the title and one action.
 * Shown only when Menu > Hero layout (test) = Clean.
 */
import Button from '../../components/Button.astro';
import Logos from './Logos.astro';
import { getCopy, localizePath, withBase, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { hero } = getCopy(locale).home;
const { video, clean } = hero;
---

<section class="hcl theme-dark" aria-labelledby="hcl-title" data-hero-variant="clean" data-header-dark>
  <video
    class="hcl__video"
    muted
    loop
    playsinline
    preload="none"
    poster={withBase(video.poster)}
    disablepictureinpicture
    aria-hidden="true"
    data-hero-video
  >
    <source src={withBase(video.large)} type="video/mp4" media="(min-width: 60em)" />
    <source src={withBase(video.small)} type="video/mp4" />
  </video>
  <div class="hcl__scrim" aria-hidden="true"></div>

  <div class="hcl__content container">
    <!-- Only one hero is displayed at a time; the hidden ones are out of the
         accessibility tree, so this heading never competes with the other h1. -->
    <p id="hcl-title" class="hcl__title" role="heading" aria-level="1" data-render>
      <span>{clean.titleLine1}</span>
      <span>{clean.titleLine2}</span>
    </p>
    <p class="hcl__text">{clean.text}</p>
    <Button class="hcl__cta" href={localizePath(clean.cta.href, locale)} label={clean.cta.label} size="lg" />
  </div>

  <!-- Partner logos along the bottom edge, over the video -->
  <div class="hcl__logos container">
    <div class="hcl__logos-inner">
      <Logos locale={locale} class="hcl__logos-row" />
    </div>
  </div>
</section>

<style>
  .hcl {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    background: var(--grey-700);
  }

  .hcl__video,
  .hcl__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hcl__video {
    object-fit: cover;
  }

  /* Dimmed so the footage stays in the background; darker behind the copy. */
  .hcl__video {
    filter: saturate(0.8);
  }

  .hcl__scrim {
    background:
      linear-gradient(to bottom, rgb(16 16 16 / 0.35), rgb(16 16 16 / 0) 24%),
      linear-gradient(to top, rgb(16 16 16 / 0.82), rgb(16 16 16 / 0) 62%),
      rgb(16 16 16 / 0.38);
  }

  .hcl__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--logos-h) + clamp(2rem, 1rem + 4vh, 4.5rem));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hcl {
    --logos-h: clamp(4.5rem, 3.5rem + 2vw, 5.75rem);
  }

  .hcl__text {
    max-width: 34rem;
    margin-top: clamp(1rem, 0.75rem + 0.8vw, 1.5rem);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.45;
    letter-spacing: var(--track-body);
    color: rgb(255 255 255 / 0.78);
  }

  .hcl__content :global(.hcl__cta) {
    margin-top: clamp(1.5rem, 1rem + 1.2vw, 2.25rem);
  }

  /* Logos row: a hairline, then the marks in white */
  .hcl__logos {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0 auto;
  }

  .hcl__logos-inner {
    display: flex;
    align-items: center;
    height: var(--logos-h);
  }

  /* Left-aligned, never past the middle of the screen */
  .hcl__logos :global(.hcl__logos-row) {
    --logo-scale: 0.78;
    width: min(100%, 50vw);
  }

  .hcl__logos :global(.logos__list) {
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: clamp(1.25rem, 0.5rem + 1.5vw, 2.25rem);
  }

  .hcl__logos :global(.logos__item img) {
    filter: brightness(0) invert(1);
    opacity: 0.72;
  }

  @media (max-width: 47.99rem) {
    .hcl {
      --logos-h: 7rem;
    }
    .hcl__logos :global(.hcl__logos-row) {
      --logo-scale: 0.62;
      width: 100%;
    }
    .hcl__logos :global(.logos__list) {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      justify-content: start;
      gap: 1rem 1.75rem;
    }
  }

  .hcl__title {
    display: grid;
    font-size: clamp(2.75rem, 1rem + 4.6vw, 6rem);
    line-height: 0.96;
    letter-spacing: var(--track-display);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hcl__content :global(.hcl__cta) {
      animation: hcl-in 700ms var(--ease-out) 500ms backwards;
    }
  }

  @keyframes hcl-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>

<script>
  import { mountHeroVideos } from '../../scripts/hero-video';
  mountHeroVideos();
</script>
