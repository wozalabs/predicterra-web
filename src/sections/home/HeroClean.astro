---
/**
 * Hero, clean layout (test). Only the video, the title and one action.
 * Shown only when Menu > Hero layout (test) = Clean.
 */
import Button from '../../components/Button.astro';
import { getCopy, localizePath, withBase, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { hero } = getCopy(locale).home;
const { video, clean } = hero;
---

<section class="hcl theme-dark" aria-labelledby="hcl-title" data-hero-variant="clean" data-header-dark>
  <video
    class="hcl__video"
    muted
    loop
    playsinline
    preload="none"
    poster={withBase(video.poster)}
    disablepictureinpicture
    aria-hidden="true"
    data-hero-video
  >
    <source src={withBase(video.large)} type="video/mp4" media="(min-width: 60em)" />
    <source src={withBase(video.small)} type="video/mp4" />
  </video>
  <div class="hcl__scrim" aria-hidden="true"></div>

  <div class="hcl__content container">
    <!-- Only one hero is displayed at a time; the hidden ones are out of the
         accessibility tree, so this heading never competes with the other h1. -->
    <p id="hcl-title" class="hcl__title" role="heading" aria-level="1" data-render>
      <span>{clean.titleLine1}</span>
      <span>{clean.titleLine2}</span>
    </p>
    <Button class="hcl__cta" href={localizePath(clean.cta.href, locale)} label={clean.cta.label} size="lg" />
  </div>
</section>

<style>
  .hcl {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    background: var(--grey-700);
  }

  .hcl__video,
  .hcl__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hcl__video {
    object-fit: cover;
  }

  /* Just enough shade for the header and the title; the footage stays clear. */
  .hcl__scrim {
    background:
      linear-gradient(to bottom, rgb(16 16 16 / 0.35), rgb(16 16 16 / 0) 22%),
      linear-gradient(to top, rgb(16 16 16 / 0.6), rgb(16 16 16 / 0) 50%);
  }

  .hcl__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(2.5rem, 1rem + 6vh, 6rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .hcl__title {
    display: grid;
    font-size: clamp(2.75rem, 1rem + 4.6vw, 6rem);
    line-height: 0.96;
    letter-spacing: var(--track-display);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hcl__content :global(.hcl__cta) {
      animation: hcl-in 700ms var(--ease-out) 500ms backwards;
    }
  }

  @keyframes hcl-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>

<script>
  import { mountHeroVideos } from '../../scripts/hero-video';
  mountHeroVideos();
</script>
