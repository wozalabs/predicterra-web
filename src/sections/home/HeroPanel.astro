---
/**
 * Hero, panel layout (the default). A white panel runs the full
 * width of the viewport from the very top of the page (the header sits on
 * it, in dark text). Its bottom edge is the brand's notch, made larger: low
 * on the left, where it holds the title, then a long 45° rise right after the
 * title and flat to the right edge. The description sits under that raised
 * edge, on the dark ground, in light text. Under it, in both themes, the platform
 * capture rises from the bottom of the screen (Showcase.astro, which follows
 * this section and keeps the dark ground behind the capture in this layout).
 */
import { getCopy, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { main } = getCopy(locale).home.hero;
---

<section class="hpn" aria-labelledby="hpn-title" data-hero-variant="panel">
  <div class="hpn__panel" data-header-light>
    <div class="container hpn__inner">
      <!-- The brand's corner in the orange square, a rule, then the title: the
           same row as Why us and the 3D section's sector titles. -->
      <div class="hpn__head">
        <span class="ibox hpn__mark" aria-hidden="true">
          <svg viewBox="3.89 -0.11 220 220"><path d="M113.472 36.8552V64.4133H67.5418V110.343H39.9844V36.8552H113.472Z" /></svg>
        </span>
        <span class="hpn__divider" aria-hidden="true"></span>
        <h1 id="hpn-title" class="hpn__title">
          <span class="hpn__line"><span>{main.titleLine1}</span></span>
          <span class="hpn__line"><span>{main.titleLine2}</span></span>
        </h1>
      </div>
      <span class="hpn__rise" aria-hidden="true"></span>
      <p class="hpn__text">{main.text}</p>
    </div>
  </div>
</section>

<style>
  /* No display here: the hero layout switch (global.css) shows or hides it. */
  .hpn {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    background: #0d0d0d;
    /* The bottom of the screen belongs to the capture (Showcase --peek). */
    padding-bottom: var(--hero-peek);
  }

  /* The panel: full width, from the top of the page. The white is drawn by
     ::before so the description can sit on the dark ground outside it.
     The rise's top corner lines up with the grid: content right edge, minus
     the description column and the gap before it. */
  .hpn__panel {
    --rise: clamp(9rem, 6rem + 6vh, 12rem);
    --pb: clamp(2rem, 1rem + 3vh, 3.5rem);
    --text-w: 26rem;
    --text-gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    --rise-top: calc(100% - (100% - min(100%, var(--max-w))) / 2 - var(--gutter) - var(--text-w) - var(--text-gap));
    position: relative;
    z-index: calc(var(--z-cover) + 1);
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding-top: var(--header-h);
    padding-bottom: var(--pb);
    color: #1e1e1e;
    --ink: #1e1e1e;
    --ink-2: #4d4d4d;
  }

  .hpn__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #ffffff;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--rise)),
      var(--rise-top) calc(100% - var(--rise)),
      calc(var(--rise-top) - var(--rise)) 100%,
      0 100%
    );
  }

  .hpn__inner {
    display: grid;
    gap: 1.25rem;
    width: 100%;
  }

  .hpn__rise {
    display: none;
  }

  /* Title | the rise | a gap | the description, under the raised edge. */
  @media (min-width: 56rem) {
    .hpn__inner {
      grid-template-columns: minmax(0, 1fr) var(--rise) var(--text-gap) var(--text-w);
      align-items: end;
      gap: 0;
    }
    .hpn__rise {
      display: block;
      grid-column: 2;
      align-self: stretch;
    }
    /* From just under the raised edge down; a longer text runs into the
       panel's bottom padding, still on the dark. */
    .hpn__inner .hpn__text {
      grid-column: 4;
      align-self: end;
      box-sizing: border-box;
      height: calc(var(--rise) - var(--pb));
      max-width: none;
      padding-top: 3rem;
      color: rgb(255 255 255 / 0.72);
    }
  }

  /* Phones: title and description both on the white, a short rise at the right. */
  @media (max-width: 55.99rem) {
    .hpn__panel {
      --rise: 2.5rem;
      --rise-top: calc(100% - var(--gutter));
      padding-bottom: calc(var(--pb) + var(--rise));
    }
  }

  /* The square as tall as the title's first line, beside it (the title sets
     its size on the row, so the square follows it in em). */
  .hpn__head {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 0.75rem + 0.8vw, 1.5rem);
    font-size: clamp(2.5rem, 1rem + 4vw, 5.25rem);
  }

  .hpn__mark {
    --ibox: 0.96em;
  }

  .hpn__mark svg {
    width: 100%;
    height: 100%;
  }

  .hpn__divider {
    flex: none;
    height: 0.96em;
    width: 1px;
    background: currentColor;
    opacity: 0.2;
  }

  .hpn__title {
    display: grid;
    font-size: 1em;
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: var(--track-display);
  }

  .hpn__text {
    max-width: 38ch;
    text-wrap: pretty;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.45;
    color: #4d4d4d;
  }

  /* One block per line, each fading in on its own beat. */
  .hpn__line {
    display: block;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }


  .hpn__line > span {
    display: block;
  }

  /* Wide screens: each line on one line; the square takes the room it would
     otherwise wrap in (the last line, the longest, sits clear of the rise). */
  @media (min-width: 75rem) {
    .hpn__line {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hpn__line > span {
      animation: hpn-line 850ms cubic-bezier(0.33, 1, 0.68, 1) backwards;
    }
    .hpn__line:nth-child(1) > span {
      animation-delay: 200ms;
    }
    .hpn__line:nth-child(2) > span {
      animation-delay: 290ms;
    }
    .hpn__text {
      animation: hpn-focus 800ms cubic-bezier(0.33, 1, 0.68, 1) 320ms backwards;
    }
    .hpn__mark,
    .hpn__divider {
      animation: hpn-focus 800ms cubic-bezier(0.33, 1, 0.68, 1) 120ms backwards;
    }
  }

  /* In place: each line fades in out of a soft blur, nothing moves; a touch
     of orange settles to the ink. */
  @keyframes hpn-line {
    from {
      opacity: 0;
      filter: blur(12px);
      color: var(--accent);
    }
    35% {
      color: var(--accent);
    }
  }

  @keyframes hpn-focus {
    from {
      opacity: 0;
      filter: blur(8px);
    }
  }
</style>
