---
/**
 * Hero, cutout layout (test). Full-screen video, a short title bottom left,
 * and a light notch along the bottom edge that holds the partner logos. The
 * notch ends in a 45° step, as if cut out of the video.
 * Shown only when Menu > Hero layout (test) = Cutout.
 */
import Logos from './Logos.astro';
import { getCopy, withBase, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { hero } = getCopy(locale).home;
const { video, cutout } = hero;
---

<section class="hcut theme-dark" aria-labelledby="hcut-title" data-hero-variant="cutout" data-header-dark>
  <video
    class="hcut__video"
    muted
    loop
    playsinline
    preload="none"
    poster={withBase(video.poster)}
    disablepictureinpicture
    aria-hidden="true"
    data-hero-video
  >
    <source src={withBase(video.large)} type="video/mp4" media="(min-width: 60em)" />
    <source src={withBase(video.small)} type="video/mp4" />
  </video>
  <div class="hcut__scrim" aria-hidden="true"></div>

  <div class="hcut__content container">
    <p class="hcut__eyebrow t-small">{cutout.eyebrow}</p>
    <span class="hcut__rule" aria-hidden="true"></span>
    <!-- Only one hero is displayed at a time; the hidden one is out of the
         accessibility tree, so this heading never competes with the other h1. -->
    <p id="hcut-title" class="hcut__title" role="heading" aria-level="1">
      <span>{cutout.titleLine1}</span>
      <span>{cutout.titleLine2}</span>
    </p>
  </div>

  <div class="hcut__cut">
    <Logos locale={locale} class="hcut__logos" />
  </div>
</section>

<style>
  .hcut {
    /* Height of the light notch; the step is 45°, so its run equals this. */
    --cut-h: clamp(5rem, 3.75rem + 2.6vw, 7rem);
    /* Left edge shared by the title and the logos (matches .container). */
    --edge: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    background: var(--grey-700);
  }

  .hcut__video,
  .hcut__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hcut__video {
    object-fit: cover;
    filter: saturate(0.9);
  }

  /* Dim overall, darker towards the bottom left where the title sits. */
  .hcut__scrim {
    background:
      linear-gradient(to top, rgb(20 20 20 / 0.6), rgb(20 20 20 / 0) 55%),
      linear-gradient(to right, rgb(20 20 20 / 0.35), rgb(20 20 20 / 0) 60%),
      rgb(20 20 20 / 0.28);
  }

  /* ---------- Title ---------- */
  .hcut__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--cut-h) + clamp(2rem, 1rem + 3vh, 3.5rem));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0 auto;
  }

  .hcut__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink-2);
  }

  .hcut__eyebrow::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  /* Hairline between label and title */
  .hcut__rule {
    width: min(26rem, 100%);
    height: 1px;
    margin-block: 0.875rem 1.5rem;
    background: rgb(255 255 255 / 0.4);
  }

  .hcut__title {
    display: grid;
    font-size: clamp(2.5rem, 1rem + 4vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: var(--track-display);
    color: #ffffff;
  }

  /* ---------- Notch ---------- */
  .hcut__cut {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    height: var(--cut-h);
    padding-left: var(--edge);
    padding-right: calc(var(--cut-h) + clamp(2rem, 1rem + 2vw, 3.5rem));
    background: var(--canvas);
    color: var(--grey-700);
    clip-path: polygon(0 0, calc(100% - var(--cut-h)) 0, 100% 100%, 0 100%);
  }

  .hcut__cut :global(.hcut__logos) {
    --logo-scale: 0.82;
  }

  .hcut__cut :global(.logos__list) {
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: clamp(1.75rem, 0.75rem + 2.2vw, 3.25rem);
  }

  /* Settle in once (no layout shift: transform and opacity only). */
  @media (prefers-reduced-motion: no-preference) {
    .hcut__content > * {
      animation: hcut-in 700ms var(--ease-out) both;
    }
    .hcut__title {
      animation-delay: 80ms;
    }
    .hcut__cut {
      animation: hcut-cut 800ms var(--ease-out) 150ms both;
    }
  }

  @keyframes hcut-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hcut-cut {
    from {
      transform: translateY(100%);
    }
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 47.99rem) {
    .hcut {
      --cut-h: 7.5rem;
    }

    /* Full-width notch with a small 45° corner; logos as a 3 + 2 grid. */
    .hcut__cut {
      right: 0;
      padding-right: var(--gutter);
      clip-path: polygon(0 0, calc(100% - 2rem) 0, 100% 2rem, 100% 100%, 0 100%);
    }

    .hcut__cut :global(.hcut__logos) {
      --logo-scale: 0.7;
    }

    .hcut__cut :global(.logos__list) {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      gap: 1rem 1.75rem;
    }
  }
</style>

<script>
  import { mountHeroVideos } from '../../scripts/hero-video';
  mountHeroVideos();
</script>
