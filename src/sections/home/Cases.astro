---
import NotchRule from '../../components/NotchRule.astro';
import Button from '../../components/Button.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCopy, localizePath, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const copy = getCopy(locale);
const { cases } = copy.home;
// The first three success stories (src/i18n/en/cases.ts).
const stories = copy.cases.items.slice(0, 3);
---

<section class="cases" id="success-stories" aria-labelledby="cases-title">
  <div class="container cases__inner">
    <NotchRule at={70} />
    <h2 id="cases-title" class="t-h2 cases__title" data-render>{cases.title}</h2>

    <div class="cases__grid">
      <div class="cases__explore" data-reveal>
        <Button variant="secondary" href={localizePath(cases.exploreHref, locale)} label={cases.exploreLabel} />
      </div>

      <ul class="cases__list" data-reveal-group>
        {
          stories.map((story) => (
            <li data-reveal>
              <CaseCard story={story} locale={locale} meta={false} render />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cases {
    position: relative;
    z-index: var(--z-cover);
    background: var(--canvas);
  }

  .cases__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 1rem) clamp(3rem, 2rem + 3vw, 5rem);
  }

  .cases__title {
    margin-top: clamp(1rem, 0.75rem + 1vw, 2rem);
  }

  .cases__grid {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  @media (min-width: 64rem) {
    .cases__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--gutter);
    }
  }

  .cases__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 2.5rem var(--gutter);
  }

</style>
