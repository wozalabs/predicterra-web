---
import Icon from '../../components/Icon.astro';
import AssetPanel from '../../components/AssetPanel.astro';
import { getCopy, localizePath, type Locale } from '../../i18n/config';
import type { IconName } from '../../data/icons';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { scene } = getCopy(locale).home;
const stops = scene.sectors.length + 1; // overview + one stop per sector
---

<section
  class="sectors"
  id="sectors-overview"
  aria-labelledby="sectors-ov-title"
  data-sectors="overview"
  style={`--stops:${stops}`}
>
  <div class="sectors__stage" data-stage>
    <div class="sectors__canvas" data-canvas-host aria-hidden="true"></div>

    <!-- Copy: one layer per step. All text stays in the DOM for crawlers and screen readers. -->
    <div class="sectors__copy container">
      <div class="step step--intro" data-step="0" data-active>
        <p class="label">{scene.label}</p>
        <h2 id="sectors-ov-title" class="t-h2 step__intro-title">{scene.title}</h2>
        <p class="t-lead step__intro-text">{scene.intro}</p>
      </div>

      {
        scene.sectors.map((s, i) => (
          <article class="step" data-step={i + 1} aria-labelledby={`sector-ov-${s.id}-title`}>
            <div class="step__head">
              <Icon name={s.icon as IconName} boxed size="3.5rem" />
              <span class="step__divider" aria-hidden="true" />
              <h3 id={`sector-ov-${s.id}-title`} class="t-h2 step__title" data-render-step>
                {s.title}
              </h3>
            </div>
            <div class="step__foot">
              <p class="step__index t-small">{scene.indexLabel} {s.index}</p>
              <p class="step__text">{s.text}</p>
              <p class="step__hint t-small t-muted">
                <span class="hint-pointer">{scene.hintPointer}</span>
                <span class="hint-touch">{scene.hintTouch}</span>
              </p>
              <a class="step__link t-small" href={localizePath(s.href, locale)}>
                {scene.linkPrefix} {s.title.toLowerCase()}
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Markers: square dots projected from the 3D anchors. -->
    <div class="sectors__markers" data-markers>
      {
        scene.sectors.map((s) => (
          <div class="marker" data-marker={s.id}>
            <button
              class="marker__btn"
              type="button"
              aria-expanded="false"
              aria-controls={`alert-ov-${s.id}`}
              aria-label={`${scene.openAlert} ${s.alert.asset}`}
            >
              <span class="marker__ring" aria-hidden="true" />
              <span class="marker__dot" aria-hidden="true" />
            </button>
          </div>
        ))
      }
    </div>

    <!-- Alert cards, positioned next to their marker (desktop) or as a sheet (mobile). -->
    <div class="sectors__alerts">
      {
        scene.sectors.map((s) => (
          <div class="alert" id={`alert-ov-${s.id}`} data-alert={s.id} role="group" aria-label={`${s.panel.name}, ${s.alert.hazard}`}>
            <AssetPanel panel={s.panel} labels={scene.panelLabels} />
          </div>
        ))
      }
    </div>

    <nav class="sectors__progress" aria-label={scene.progressLabel}>
      <ol>
        {
          scene.sectors.map((s, i) => (
            <li>
              <button type="button" class="progress__item" data-goto={i + 1}>
                <span class="progress__sq" aria-hidden="true" />
                <span class="progress__label t-small">{s.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    <p class="sectors__footnote t-caption t-muted">{scene.footnote}</p>
  </div>
</section>

<style>
  /* ---------- Pinning ---------- */
  .sectors {
    position: relative;
    z-index: var(--z-stage);
    /* one viewport per stop, half a viewport to hold the last one,
       plus one for the next section to slide over (see LAST_HOLD in controller.ts) */
    height: calc((var(--stops) + 1.5) * 100svh);
  }

  .sectors__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    /* clip, not hidden: focusing a marker must never scroll the stage */
    overflow: clip;
    background: var(--canvas);
    transform-origin: 50% 0;
  }

  .sectors__canvas {
    position: absolute;
    inset: 0;
    /* Static fallback before WebGL loads: the same dot grid as the 3D ground. */
    background-image: radial-gradient(circle, #cfcfcf 1px, transparent 1.6px);
    background-size: 22px 22px;
  }

  .sectors__canvas :global(canvas) {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .sectors__canvas[data-ready] :global(canvas) {
    opacity: 1;
  }

  /* ---------- Copy layers ---------- */
  .sectors__copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Readability veil behind the copy column */
  .sectors__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(240 240 240 / 0.94) 0%, rgb(240 240 240 / 0.8) 22%, rgb(240 240 240 / 0) 46%);
  }

  .sectors__canvas {
    z-index: -1;
  }

  .step {
    position: absolute;
    inset: calc(var(--header-h) + 1.5rem) var(--gutter) clamp(1.5rem, 1rem + 2vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 360ms var(--ease-out),
      transform 480ms var(--ease-out),
      visibility 0s linear 480ms;
  }

  .step[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 420ms var(--ease-out) 80ms,
      transform 560ms var(--ease-out) 80ms,
      visibility 0s;
  }

  .step a,
  .step button {
    pointer-events: auto;
  }

  .step--intro {
    justify-content: flex-start;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .step__intro-title {
    max-width: 14ch;
  }

  .step__intro-text {
    max-width: 30ch;
    color: var(--ink-2);
  }

  .step__head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: auto;
    margin-bottom: auto;
  }

  .step__divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-strong);
  }

  .step__title {
    text-shadow: 0 0 24px var(--canvas), 0 0 8px var(--canvas);
  }

  .step__foot {
    display: grid;
    gap: 0.75rem;
    max-width: 26rem;
  }

  .step__index {
    color: var(--ink);
  }

  .step__text {
    color: var(--ink-2);
  }

  .step__link {
    justify-self: start;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .step__link:hover {
      border-color: var(--accent);
    }
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .hint-pointer {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  /* ---------- Markers ---------- */
  .sectors__markers,
  .sectors__alerts {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .marker {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
    transition: opacity 300ms ease;
  }

  /* In focus mode only the active asset keeps its marker. */
  .sectors[data-has-focus] .marker:not([data-active]) {
    opacity: 0;
  }

  .sectors[data-has-focus] .marker:not([data-active]) .marker__btn {
    pointer-events: none;
  }

  .marker[hidden] {
    display: none;
  }

  .marker__btn {
    position: absolute;
    left: -22px;
    top: -22px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .marker__dot {
    width: 14px;
    height: 14px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--surface), 0 2px 10px rgb(30 30 30 / 0.18);
    transition: transform 200ms var(--ease-out);
  }

  .marker__btn:active .marker__dot {
    transform: scale(0.9);
  }

  .marker__btn[aria-expanded='true'] .marker__dot {
    transform: scale(1.15);
  }

  .marker__ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--accent);
    opacity: 0;
  }

  .marker[data-active] .marker__ring,
  .sectors:not([data-has-focus]) .marker__ring {
    animation: ring 2s var(--ease-out) infinite;
  }

  .marker__btn[aria-expanded='true'] .marker__ring {
    animation: none;
  }

  @keyframes ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marker__ring {
      animation: none !important;
    }
  }

  /* ---------- Alert card ---------- */
  .alert {
    position: absolute;
    top: 0;
    left: 0;
    width: 22.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgb(30 30 30 / 0.06),
      0 16px 40px -12px rgb(30 30 30 / 0.22);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform-origin: var(--origin, 0 0);
    transform: translate3d(var(--x, 0), var(--y, 0), 0) scale(0.96);
    transition:
      opacity 140ms ease,
      transform 160ms var(--ease-out),
      visibility 0s linear 160ms;
  }

  .alert[data-open] {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: translate3d(var(--x, 0), var(--y, 0), 0) scale(1);
    transition:
      opacity 180ms ease,
      transform 220ms var(--ease-out),
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .alert,
    .alert[data-open] {
      transform: translate3d(var(--x, 0), var(--y, 0), 0);
    }
  }

  /* ---------- Progress ---------- */
  .sectors__progress {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding: 0.5rem 0.25rem;
    background: rgb(240 240 240 / 0.82);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
  }

  .sectors__progress ol {
    display: grid;
    gap: 0.125rem;
  }

  .progress__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2rem;
    padding-inline: 0.5rem;
    color: var(--muted);
    transition: color 200ms ease;
  }

  .progress__sq {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid currentColor;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .progress__item[aria-current='step'] {
    color: var(--ink);
  }

  .progress__item[aria-current='step'] .progress__sq {
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .progress__item:hover {
      color: var(--ink);
    }
  }

  .sectors__footnote {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) + 1rem);
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 47.99rem) {
    .sectors__stage::before {
      background:
        linear-gradient(180deg, rgb(240 240 240 / 0.92) 0%, rgb(240 240 240 / 0) 34%),
        linear-gradient(0deg, rgb(240 240 240 / 0.96) 0%, rgb(240 240 240 / 0) 38%);
    }
    .step {
      inset: calc(var(--header-h) + 0.75rem) var(--gutter) 1rem;
    }
    .step__head {
      margin: 0;
    }
    .step__head :global(.ibox) {
      --ibox: 2.75rem !important;
    }
    .step__title {
      font-size: clamp(2.25rem, 1.5rem + 4vw, 3rem);
    }
    .step__foot {
      margin-top: auto;
      max-width: none;
      padding: 1rem 0 0;
      background: linear-gradient(0deg, rgb(240 240 240 / 0.96) 75%, rgb(240 240 240 / 0));
    }
    .step__text {
      font-size: var(--fs-small);
    }
    .step__link,
    .step__hint {
      display: none;
    }
    .sectors__progress {
      display: none;
    }
    .sectors__footnote {
      display: none;
    }
    .alert {
      left: var(--gutter);
      right: var(--gutter);
      top: auto;
      bottom: var(--gutter);
      width: auto;
      max-height: 74svh;
      overflow: auto;
      transform-origin: 50% 100%;
      transform: translateY(8px) scale(0.98);
    }
    .alert[data-open] {
      transform: none;
    }
  }
</style>

<script>
  import { mountSectorScene } from '../../scripts/sector-scene/controller';

  // Test switch: only the variant selected in the menu is displayed and mounted.
  const root = document.querySelector<HTMLElement>('[data-sectors="overview"]');
  if (root && getComputedStyle(root).display !== 'none') mountSectorScene(root, 'overview');
</script>
