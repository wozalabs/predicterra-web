---
/**
 * Hero, app layout (default). No footage: the title and its text centred on
 * the page canvas, sitting just above the platform capture (Showcase.astro,
 * which follows this section) that peeks up from the bottom, barely tilted.
 * Follows the site theme (dark by default).
 */
import Button from '../../components/Button.astro';
import { getCopy, localizePath, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { main } = getCopy(locale).home.hero;
---

<section class="hap" aria-labelledby="hap-title" data-hero-variant="app">
  <div class="hap__content container">
    <h1 id="hap-title" class="hap__title">
      <span class="hap__line"><span>{main.titleLine1}</span></span>
      <span class="hap__line"><span>{main.titleLine2}</span></span>
    </h1>
    <p class="hap__text">{main.text}</p>
    <!-- <div class="hap__actions">
      <Button href={localizePath(main.primary.href, locale)} label={main.primary.label} size="lg" />
      <Button href={localizePath(main.secondary.href, locale)} label={main.secondary.label} size="lg" variant="secondary" />
    </div> -->
  </div>
</section>

<style>
  /* No display here: the hero layout switch (global.css) shows or hides it. */
  .hap {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    /* The bottom of the screen belongs to the capture (Showcase --peek). */
    padding-top: var(--header-h);
    padding-bottom: var(--hero-peek);
    background: var(--canvas);
    color: var(--ink);
  }

  /* Above the capture's dither gradient (Showcase sits at z-index cover). */
  .hap__content {
    position: relative;
    z-index: calc(var(--z-cover) + 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* The copy sits on the capture rather than floating mid-screen. */
    justify-content: flex-end;
    padding-bottom: clamp(1.75rem, 1rem + 2.5vh, 3rem);
    text-align: center;
  }

  .hap__title {
    display: grid;
    font-size: clamp(2.5rem, 1rem + 4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: var(--track-display);
  }

  .hap__text {
    max-width: 44rem;
    margin-top: clamp(1rem, 0.75rem + 0.8vw, 1.5rem);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .hap__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 1rem + 1.2vw, 2.25rem);
  }


  /* One block per line, each fading in on its own beat. */
  .hap__line {
    display: block;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .hap__line > span {
    display: block;
  }

  /* Entrance: the title lines slide up out of their mask, then the line and
     the button focus in (same timing as the video hero). */
  @media (prefers-reduced-motion: no-preference) {
    .hap__line > span {
      animation: hap-line 850ms cubic-bezier(0.33, 1, 0.68, 1) backwards;
      animation-delay: var(--d, 0ms);
    }
    .hap__line:nth-child(1) > span {
      --d: 200ms;
    }
    .hap__line:nth-child(2) > span {
      --d: 290ms;
    }
    .hap__text,
    .hap__actions {
      animation: hap-focus 800ms cubic-bezier(0.33, 1, 0.68, 1) backwards;
    }
    .hap__text {
      animation-delay: 460ms;
    }
    .hap__actions {
      animation-delay: 560ms;
    }
  }

  /* In place: each line fades in out of a soft blur, nothing moves; a touch
     of orange settles to the ink. */
  @keyframes hap-line {
    from {
      opacity: 0;
      filter: blur(12px);
      color: var(--accent);
    }
    35% {
      color: var(--accent);
    }
  }

  @keyframes hap-focus {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }
</style>
