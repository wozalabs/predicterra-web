---
import BrandLogo from '../../components/BrandLogo.astro';
import { getCopy, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
  class?: string;
}
const { locale = 'en', class: className } = Astro.props;
const { logos } = getCopy(locale).home;
---

<div class:list={['logos', className]} role="region" aria-label={logos.title}>
  <ul class="logos__list">
    {
      logos.items.map((item) => (
        <li class="logos__item">
          <BrandLogo src={item.src} name={item.name} height={item.h} w={item.w} h0={item.h0} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .logos {
    /* Scale all logos together (the split hero uses a smaller value). */
    --logo-scale: 1;
  }

  .logos__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem clamp(2rem, 1rem + 3vw, 4.5rem);
  }

  .logos__item {
    display: flex;
    align-items: center;
  }

  /* In their own colours (BrandLogo), scaled together. */
  .logos__item {
    zoom: var(--logo-scale);
  }

  @media (max-width: 40rem) {
    .logos__list {
      gap: 1rem 1.75rem;
    }
  }
</style>
