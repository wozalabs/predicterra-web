---
/**
 * Why us (home), right after the platform and its logos: an orange panel with
 * the CTA's notched top edge, the title on the left and one statement on the
 * right, lit word by word as it scrolls in (scripts/lit.ts). The panel takes
 * the opposite of the page: white with dark text in the dark theme, near
 * black with white text in the light one.
 */
import { getCopy, type Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { why } = getCopy(locale).home;
---

<section class="why" aria-labelledby="why-title">
  <div class="why__panel">
    <div class="why__grid">
      <h2 id="why-title" class="why__title" data-render>{why.title}</h2>
      <p class="why__text" data-lit>
        {why.text.split(' ').map((w) => <span class="w">{w} </span>)}
      </p>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    z-index: var(--z-cover);
    background: var(--canvas);
    padding: clamp(5rem, 3rem + 6vw, 10rem) var(--gutter) 0;
  }

  .why__panel {
    position: relative;
    isolation: isolate;
    overflow: clip;
    max-width: var(--max-w);
    margin-inline: auto;
    padding: clamp(4rem, 2.5rem + 5vw, 8rem) var(--gutter) clamp(3.5rem, 2rem + 5vw, 7rem);
    background: #0d0d0d;
    color: #ffffff;
    /* The CTA card's notched top edge. */
    clip-path: polygon(0 18px, calc(42% - 18px) 18px, 42% 0, 100% 0, 100% 100%, 0 100%);
  }

  :global(:root[data-theme='dark']) .why__panel {
    background: #ffffff;
    color: #1e1e1e;
  }

  .why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .why__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
  }

  .why__title {
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: var(--track-heading);
  }

  .why__text {
    max-width: 38ch;
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2.25rem);
    line-height: 1.18;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  /* The unlit words stay a little present. */
  .why__text:global(.is-lit) :global(.w) {
    opacity: calc(0.3 + 0.7 * var(--o, 0));
  }
</style>

<script>
  import { mountLit } from '../../scripts/lit';
  const why = document.querySelector<HTMLElement>('.why');
  if (why) mountLit(why);
</script>
