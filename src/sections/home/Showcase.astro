---
/**
 * Platform capture under the hero, centred: a silent loop of the platform in
 * use, with no controls (it cannot be paused, scrubbed, unmuted or opened full
 * screen), playing only while on screen. It arrives tilted back and
 * straightens as it reaches the middle of the viewport (scroll-linked, see the
 * script below). Reduced motion: shown flat, no movement.
 *
 * `logos` (homepage): the client and recognition logos follow the capture,
 * larger, spread across the full content width, after it rather than in the
 * same screen.
 *
 * `peek` (homepage only): with the App hero layout (the default) the capture
 * is pulled up into the bottom of the hero, barely tilted, so it is already in
 * view on load, rising out of a soft fire glow.
 */
import BrandLogo from '../../components/BrandLogo.astro';
import { getCopy, withBase, type Locale } from '../../i18n/config';
import type { LogoGroup } from '../../i18n/en/pages-shared';

interface Props {
  locale?: Locale;
  peek?: boolean;
  /** Logo groups after the capture (homepage). */
  logos?: LogoGroup[];
}
const { locale = 'en', peek = false, logos } = Astro.props;
const { showcase: s } = getCopy(locale).home;
const v = s.video;
---

<section class="sc" aria-label={s.label} data-showcase data-peek={peek ? '' : undefined}>
  {peek && <div class="sc__glow" aria-hidden="true" data-glow />}
  <div class="container sc__stage">
    <figure class="sc__frame" data-showcase-frame>
      <video
        class="sc__video"
        width={v.w}
        height={v.h}
        poster={withBase(v.poster)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
        tabindex="-1"
        aria-label={v.label}
        data-showcase-video
      >
        <source src={withBase(v.small)} type="video/mp4" media="(max-width: 47.99rem)" />
        <source src={withBase(v.large)} type="video/mp4" />
      </video>
    </figure>
  </div>
  {
    logos && (
      <div class="container sc__after">
        <h2 class="t-h2 sc__title" data-render>{s.trustedBy}</h2>
        <ul class="sc__logos" data-reveal-group>
          {logos.flatMap((g) => g.items).map((it) => (
            <li class="sc__logo" data-reveal>
              {it.src ? (
                <BrandLogo src={it.src} name={it.name} height={Math.round((it.h ?? 20) * 1.25)} w={it.w ?? 1} h0={it.h0 ?? 1} />
              ) : (
                <span class="sc__word">{it.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .sc {
    /* 0 = tilted back, 1 = flat and centred in the viewport. */
    --p: 0;
    --q: calc(1 - var(--p));
    /* How far the capture is pulled up over the hero (App hero layout only). */
    --peek: 0px;
    position: relative;
    z-index: var(--z-cover);
    margin-top: calc(-1 * var(--peek));
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    overflow-x: clip;
    /* Transparent where it overlaps the hero, page canvas below. */
    background: linear-gradient(180deg, transparent var(--peek), var(--canvas) var(--peek));
    pointer-events: none;
  }

  /* App hero: pulled up into the bottom of the hero, only a slight tilt, and
     it rises into place on load after the title. */
  /* App hero: no drop shadow around the capture, so nothing blurs the
     sunrise behind it. */
  :global(html:is([data-hero='app'], [data-hero='panel'])) .sc[data-peek] .sc__frame {
    box-shadow: none;
  }

  :global(html:is([data-hero='app'], [data-hero='panel'])) .sc[data-peek] {
    --peek: var(--hero-peek);
    --tilt: 6deg;
    padding-top: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:is([data-hero='app'], [data-hero='panel'])) .sc[data-peek] .sc__stage {
      animation: sc-rise 1300ms cubic-bezier(0.19, 1, 0.22, 1) 520ms both;
    }
  }

  /* Panel hero: the capture sits on a plain dark ground, full width, in both
     themes, down to its bottom edge. */
  :global(html[data-hero='panel']) .sc[data-peek] .sc__stage {
    background: #0d0d0d;
    box-shadow: 0 0 0 100vmax #0d0d0d;
    clip-path: inset(0 -100vmax);
    padding-bottom: clamp(2rem, 1rem + 3vw, 4rem);
  }

  @keyframes sc-rise {
    from {
      opacity: 0;
      transform: translateY(6rem);
    }
  }

  /* App hero: a sunrise behind the capture. A vertical fire gradient that
     starts as nothing just above the capture's top edge, deepens through ember red
     and the brand orange, and is brightest (warm amber) at the bottom of the
     first screen, with a soft film grain over it. The capture sits in front,
     so it shows above and beside it. It rises in on load and is gone once
     the capture reaches the middle of the screen (--g, set below). The
     hero's copy sits above it. */
  .sc__glow {
    --a: var(--hero-glow-a);
    display: none;
    position: absolute;
    left: 0;
    top: calc(-0.15 * var(--peek));
    width: 100%;
    height: calc(1.55 * var(--peek));
    pointer-events: none;
    opacity: calc(1 - var(--g, 0));
    background:
      /* Rings around a point above the box: the light rises in a U, higher
         at the sides and lowest in the middle. */
      radial-gradient(in oklab 82% 96% at 50% -12%,
        rgb(var(--sun-ember) / 0) 0%,
        rgb(var(--sun-ember) / 0) 32%,
        rgb(var(--sun-ember) / calc(var(--a) * 0.12)) 46%,
        rgb(var(--sun-ember) / calc(var(--a) * 0.34)) 58%,
        rgb(var(--sun-core) / calc(var(--a) * 0.58)) 70%,
        rgb(var(--sun-core) / calc(var(--a) * 0.76)) 80%,
        rgb(var(--sun-warm) / calc(var(--a) * 0.88)) 90%,
        rgb(var(--sun-light) / calc(var(--a) * 0.95)) 100%,
        rgb(var(--sun-warm) / calc(var(--a) * 0.7)) 114%,
        rgb(var(--sun-core) / calc(var(--a) * 0.3)) 130%,
        rgb(var(--sun-core) / 0) 150%);
    /* Fades in from nothing at the top edge, so the U has no hard line. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.35) 25%, #000 60%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.35) 25%, #000 60%);
  }

  /* Film grain, only where the light is. */
  .sc__glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grain);
    background-size: 160px 160px;
    mix-blend-mode: overlay;
    opacity: var(--hero-grain);
    -webkit-mask-image: linear-gradient(to bottom, transparent 15%, #000 55%, #000 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 15%, #000 55%, #000 82%, transparent 100%);
  }

  /* Dark theme only (hidden in the light one). */
  :global(html[data-hero='app'][data-theme='dark']) .sc[data-peek] .sc__glow {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-hero='app']) .sc[data-peek] .sc__glow {
      /* After the title and the capture have arrived. */
      animation: sc-glow 2400ms cubic-bezier(0.19, 1, 0.22, 1) 1100ms both;
    }
  }

  @keyframes sc-glow {
    from {
      opacity: 0;
      transform: translateY(10%);
    }
  }

  .sc__stage {
    position: relative;
    perspective: 1600px;
    perspective-origin: 50% 30%;
  }

  .sc__frame {
    position: relative;
    max-width: 76rem;
    margin-inline: auto;
    background: #161616;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.55);
    transform-origin: 50% 100%;
    transform: rotateX(calc(var(--q) * var(--tilt, 22deg))) scale(calc(1 - var(--q) * 0.06));
    will-change: transform;
  }

  /* No controls and no pointer: the loop cannot be paused, scrubbed or opened. */
  .sc__video {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  /* ---------- Logos after the capture: a title, then every logo in one row,
     evenly spaced, straight on the canvas. */
  .sc__after {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 1rem + 2vw, 3rem);
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
    pointer-events: auto;
  }

  .sc__logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem clamp(0.5rem, 1vw, 1.5rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .sc__logos {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: none;
    }
  }

  .sc__logo {
    display: grid;
    place-items: center;
    height: clamp(5rem, 4rem + 3vw, 7rem);
    padding: 1rem 0;
  }

  .sc__logo :global(.brand-logo svg) {
    max-width: 100%;
    height: auto;
  }

  .sc__word {
    font-size: 1.25rem;
    letter-spacing: var(--track-title);
    color: var(--ink);
  }

  /* Phones: wider than the screen, cropped at the sides, so the interface
     stays legible instead of shrinking to a thumbnail. */
  @media (max-width: 47.99rem) {
    .sc__frame {
      width: 150vw;
      max-width: none;
      margin-left: calc(50% - 75vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc {
      --p: 1 !important;
    }
    .sc__frame {
      will-change: auto;
    }
  }
</style>

<script>
  /* ---------- The loop plays only while on screen; reduced motion: the poster ---------- */
  const video = document.querySelector<HTMLVideoElement>('[data-showcase-video]');
  if (video) {
    video.muted = true;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still) {
      video.removeAttribute('autoplay');
      video.pause();
    } else {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }).observe(video);
    }
  }


  /* ---------- Glow (App hero): fades out as the page scrolls ---------- */
  const glow = document.querySelector<HTMLElement>('[data-glow]');
  if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    const dim = () => {
      raf = 0;
      // Gone by the time the capture reaches the middle of the screen.
      const g = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.35)));
      const e = g * g * (3 - 2 * g);
      glow.style.setProperty('--g', e.toFixed(3));
    };
    window.addEventListener('scroll', () => raf || (raf = requestAnimationFrame(dim)), { passive: true });
    dim();
  }

  /* ---------- Scroll: tilt → flat ---------- */
  const section = document.querySelector<HTMLElement>('[data-showcase]');
  const frame = section?.querySelector<HTMLElement>('[data-showcase-frame]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section && frame && !reduce.matches) {
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (t: number) => t * t * (3 - 2 * t);
    let raf = 0;
    let last = -1;

    // p runs from 0 when the frame's top enters the viewport (or at the top of
    // the page, when it is already in view) to 1 when the frame is centred.
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      const top = section.getBoundingClientRect().top + window.scrollY + frame.offsetTop; // untransformed
      const h = frame.offsetHeight;
      const start = Math.max(0, top - vh);
      const end = Math.max(start + 1, top - Math.max(0, (vh - h) / 2));
      const p = Math.round(smooth(clamp01((window.scrollY - start) / (end - start))) * 1000) / 1000;
      if (p === last) return;
      last = p;
      section.style.setProperty('--p', String(p));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    // Only listen while the showcase is near the viewport.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) window.addEventListener('scroll', onScroll, { passive: true });
        else window.removeEventListener('scroll', onScroll);
        update();
      },
      { rootMargin: '25% 0px' },
    ).observe(section);
    window.addEventListener('resize', onScroll, { passive: true });
    // The hero layout switch changes where the frame starts.
    window.addEventListener('hero:change', () => requestAnimationFrame(update));
    update();
  }
</script>
