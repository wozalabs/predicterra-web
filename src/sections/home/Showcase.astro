---
/**
 * Platform capture under the hero, centred: a silent loop of the platform in
 * use, with no controls (it cannot be paused, scrubbed, unmuted or opened full
 * screen), playing only while on screen. It arrives tilted back and
 * straightens as it reaches the middle of the viewport (scroll-linked, see the
 * script below). Reduced motion: shown flat, no movement.
 *
 * `logos` (homepage): the client and recognition logos follow the capture,
 * larger, spread across the full content width, after it rather than in the
 * same screen.
 *
 * `peek` (homepage only): with the App hero layout (the default) the capture
 * is pulled up into the bottom of the hero, barely tilted, so it is already in
 * view on load, rising out of a soft fire glow.
 *
 * Panel hero: the dark ground under the hero panel and behind the capture
 * plays the film of the sectors and industries, under a dark veil, the
 * capture at its usual size on top; it fades out into the page below.
 *
 * Test (html[data-sc-mix], switch bottom left, development only):
 *  current    the above
 *  alternate  the sectors film plays inside the capture's 16:9 frame, taking
 *             turns with the platform (a crossfade between them), on a plain
 *             dark ground
 *  framed     the capture at its size but lower, just under the fold, so the
 *             first screen shows the film (under a lighter veil) and the
 *             capture follows as the page scrolls
 */
import BrandLogo from '../../components/BrandLogo.astro';
import { getCopy, withBase, type Locale } from '../../i18n/config';
import type { LogoGroup } from '../../i18n/en/pages-shared';

interface Props {
  locale?: Locale;
  peek?: boolean;
  /** Logo groups after the capture (homepage). */
  logos?: LogoGroup[];
}
const { locale = 'en', peek = false, logos } = Astro.props;
const { showcase: s, hero } = getCopy(locale).home;
const v = s.video;
const film = hero.video;
---

<section class="sc" aria-label={s.label} data-showcase data-peek={peek ? '' : undefined}>
  {peek && <div class="sc__glow" aria-hidden="true" data-glow />}
  {
    peek && (
      <div class="sc__ground" aria-hidden="true" data-sc-ground>
        <video
          class="sc__film"
          poster={withBase(film.poster)}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          disableRemotePlayback
          tabindex="-1"
          data-hero-video
        >
          <source src={withBase(film.small)} type="video/mp4" media="(max-width: 47.99rem)" />
          <source src={withBase(film.large)} type="video/mp4" />
        </video>
      </div>
    )
  }
  <div class="container sc__stage">
    <figure class="sc__frame" data-showcase-frame>
      <video
        class="sc__video"
        width={v.w}
        height={v.h}
        poster={withBase(v.poster)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
        tabindex="-1"
        aria-label={v.label}
        data-showcase-video
      >
        <source src={withBase(v.small)} type="video/mp4" media="(max-width: 47.99rem)" />
        <source src={withBase(v.large)} type="video/mp4" />
      </video>
      {
        peek && (
          <video
            class="sc__alt"
            poster={withBase(film.poster)}
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            disableRemotePlayback
            tabindex="-1"
            aria-hidden="true"
            data-sc-alt
          >
            <source src={withBase(film.small)} type="video/mp4" media="(max-width: 47.99rem)" />
            <source src={withBase(film.large)} type="video/mp4" />
          </video>
        )
      }
    </figure>
  </div>
  {
    logos && (
      <div class="container sc__after">
        <h2 class="t-h2 sc__title" data-render>{s.trustedBy}</h2>
        <ul class="sc__logos" data-reveal-group>
          {logos.flatMap((g) => g.items).map((it) => (
            <li class="sc__logo" data-reveal>
              {it.src ? (
                <BrandLogo src={it.src} name={it.name} height={Math.round((it.h ?? 20) * 1.25)} w={it.w ?? 1} h0={it.h0 ?? 1} />
              ) : (
                <span class="sc__word">{it.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .sc {
    /* 0 = tilted back, 1 = flat and centred in the viewport. */
    --p: 0;
    --q: calc(1 - var(--p));
    /* How far the capture is pulled up over the hero (App hero layout only). */
    --peek: 0px;
    position: relative;
    z-index: var(--z-cover);
    margin-top: calc(-1 * var(--peek));
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    overflow-x: clip;
    /* Transparent where it overlaps the hero, page canvas below. */
    background: linear-gradient(180deg, transparent var(--peek), var(--canvas) var(--peek));
    pointer-events: none;
  }

  /* App hero: pulled up into the bottom of the hero, only a slight tilt, and
     it rises into place on load after the title. */
  /* App hero: no drop shadow around the capture, so nothing blurs the
     sunrise behind it. */
  :global(html:is([data-hero='app'], [data-hero='panel'])) .sc[data-peek] .sc__frame {
    box-shadow: none;
  }

  :global(html:is([data-hero='app'], [data-hero='panel'])) .sc[data-peek] {
    --peek: var(--hero-peek);
    --tilt: 6deg;
    padding-top: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:is([data-hero='app'], [data-hero='panel'])) .sc[data-peek] .sc__stage {
      animation: sc-rise 1300ms cubic-bezier(0.19, 1, 0.22, 1) 520ms both;
    }
  }

  /* Panel hero: the capture sits on the film's ground (below), full width,
     down to its bottom edge. */
  :global(html[data-hero='panel']) .sc[data-peek] .sc__stage {
    clip-path: inset(0 -100vmax);
    padding-bottom: clamp(2rem, 1rem + 3vw, 4rem);
  }

  /* ---------- The sectors film as the dark ground (panel hero) ----------
     Full width, from under the hero panel's raised edge down past the bottom
     of the capture's ground (height set by the script), behind the capture. */
  .sc__ground {
    display: none;
  }

  :global(html[data-hero='panel']) .sc[data-peek] .sc__ground {
    position: absolute;
    top: -15rem;
    left: 0;
    right: 0;
    display: block;
    height: calc(var(--ground-h, 100svh) + 15rem + 4rem);
    overflow: hidden;
    background: #0d0d0d;
    /* Runs a little past the capture's ground and fades out into the page,
       so the next section starts on the canvas with no edge. */
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 14rem), transparent);
    mask-image: linear-gradient(180deg, #000 calc(100% - 14rem), transparent);
  }

  .sc__film {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A dark veil, heavier under the hero's copy and around the capture's foot,
     so the film reads as ground and never competes with the platform. */
  .sc__ground::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(13 13 13 / 0.35) 0%, rgb(13 13 13 / 0) 30%, rgb(13 13 13 / 0) 70%, rgb(13 13 13 / 0.85) 100%),
      rgb(13 13 13 / 0.5);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-hero='panel']) .sc[data-peek] .sc__ground {
      animation: sc-ground 1200ms cubic-bezier(0.33, 1, 0.68, 1) both;
    }
  }

  @keyframes sc-ground {
    from {
      opacity: 0;
    }
  }

  /* ---------- Test: alternate (the film inside the frame, taking turns) ---------- */
  .sc__alt {
    display: none;
  }

  :global(html[data-sc-mix='alternate']) .sc__alt {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.33, 1, 0.68, 1);
    pointer-events: none;
  }

  :global(html[data-sc-mix='alternate']) .sc__frame[data-alt-on] .sc__alt {
    opacity: 1;
  }

  /* The film is in the frame, so the ground goes back to plain dark. */
  :global(html[data-hero='panel'][data-sc-mix='alternate']) .sc[data-peek] .sc__ground {
    display: none;
  }

  :global(html[data-hero='panel'][data-sc-mix='alternate']) .sc[data-peek] .sc__stage {
    background: #0d0d0d;
    box-shadow: 0 0 0 100vmax #0d0d0d;
  }

  /* ---------- Test: framed (the capture lower, the film first) ----------
     The capture starts where the first screen ends, its top edge just in view
     as a cue to scroll; its own size is unchanged. */
  :global(html[data-hero='panel'][data-sc-mix='framed']) .sc[data-peek] .sc__stage {
    padding-top: calc(var(--hero-peek) - 3rem);
    padding-bottom: clamp(4rem, 2rem + 6vw, 9rem);
  }

  :global(html[data-hero='panel'][data-sc-mix='framed']) .sc[data-peek] .sc__ground::after {
    background:
      linear-gradient(180deg, rgb(13 13 13 / 0.5) 0%, rgb(13 13 13 / 0) 30%, rgb(13 13 13 / 0) 70%, rgb(13 13 13 / 0.75) 100%),
      rgb(13 13 13 / 0.18);
  }

  /* Layouts whose hero already shows the platform: no second capture, the
     logos follow the hero directly. */
  :global(html:is([data-hero='immersive'], [data-hero='window'], [data-hero='annotated'])) .sc__stage {
    display: none;
  }

  :global(html:is([data-hero='immersive'], [data-hero='window'], [data-hero='annotated'])) .sc {
    padding-top: 0;
  }

  @keyframes sc-rise {
    from {
      opacity: 0;
      transform: translateY(6rem);
    }
  }

  /* App hero: a sunrise behind the capture. A vertical fire gradient that
     starts as nothing just above the capture's top edge, deepens through ember red
     and the brand orange, and is brightest (warm amber) at the bottom of the
     first screen, with a soft film grain over it. The capture sits in front,
     so it shows above and beside it. It rises in on load and is gone once
     the capture reaches the middle of the screen (--g, set below). The
     hero's copy sits above it. */
  .sc__glow {
    --a: var(--hero-glow-a);
    display: none;
    position: absolute;
    left: 0;
    top: calc(-0.15 * var(--peek));
    width: 100%;
    height: calc(1.55 * var(--peek));
    pointer-events: none;
    opacity: calc(1 - var(--g, 0));
    background:
      /* Rings around a point above the box: the light rises in a U, higher
         at the sides and lowest in the middle. */
      radial-gradient(in oklab 82% 96% at 50% -12%,
        rgb(var(--sun-ember) / 0) 0%,
        rgb(var(--sun-ember) / 0) 32%,
        rgb(var(--sun-ember) / calc(var(--a) * 0.12)) 46%,
        rgb(var(--sun-ember) / calc(var(--a) * 0.34)) 58%,
        rgb(var(--sun-core) / calc(var(--a) * 0.58)) 70%,
        rgb(var(--sun-core) / calc(var(--a) * 0.76)) 80%,
        rgb(var(--sun-warm) / calc(var(--a) * 0.88)) 90%,
        rgb(var(--sun-light) / calc(var(--a) * 0.95)) 100%,
        rgb(var(--sun-warm) / calc(var(--a) * 0.7)) 114%,
        rgb(var(--sun-core) / calc(var(--a) * 0.3)) 130%,
        rgb(var(--sun-core) / 0) 150%);
    /* Fades in from nothing at the top edge, so the U has no hard line. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.35) 25%, #000 60%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.35) 25%, #000 60%);
  }

  /* Film grain, only where the light is. */
  .sc__glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grain);
    background-size: 160px 160px;
    mix-blend-mode: overlay;
    opacity: var(--hero-grain);
    -webkit-mask-image: linear-gradient(to bottom, transparent 15%, #000 55%, #000 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 15%, #000 55%, #000 82%, transparent 100%);
  }

  /* Dark theme only (hidden in the light one). */
  :global(html[data-hero='app'][data-theme='dark']) .sc[data-peek] .sc__glow {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-hero='app']) .sc[data-peek] .sc__glow {
      /* After the title and the capture have arrived. */
      animation: sc-glow 2400ms cubic-bezier(0.19, 1, 0.22, 1) 1100ms both;
    }
  }

  @keyframes sc-glow {
    from {
      opacity: 0;
      transform: translateY(10%);
    }
  }

  .sc__stage {
    position: relative;
    perspective: 1600px;
    perspective-origin: 50% 30%;
  }

  .sc__frame {
    position: relative;
    max-width: 76rem;
    margin-inline: auto;
    background: #161616;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.55);
    transform-origin: 50% 100%;
    transform: rotateX(calc(var(--q) * var(--tilt, 22deg))) scale(calc(1 - var(--q) * 0.06));
    will-change: transform;
  }

  /* No controls and no pointer: the loop cannot be paused, scrubbed or opened. */
  .sc__video {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  /* ---------- Logos after the capture: a title, then every logo in one row,
     evenly spaced, straight on the canvas. */
  .sc__after {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 1rem + 2vw, 3rem);
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
    pointer-events: auto;
  }

  .sc__logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem clamp(0.5rem, 1vw, 1.5rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .sc__logos {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: none;
    }
  }

  .sc__logo {
    display: grid;
    place-items: center;
    height: clamp(5rem, 4rem + 3vw, 7rem);
    padding: 1rem 0;
  }

  .sc__logo :global(.brand-logo svg) {
    max-width: 100%;
    height: auto;
  }

  .sc__word {
    font-size: 1.25rem;
    letter-spacing: var(--track-title);
    color: var(--ink);
  }

  /* Phones: wider than the screen, cropped at the sides, so the interface
     stays legible instead of shrinking to a thumbnail. */
  @media (max-width: 47.99rem) {
    .sc__frame {
      width: 150vw;
      max-width: none;
      margin-left: calc(50% - 75vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc {
      --p: 1 !important;
    }
    .sc__frame {
      will-change: auto;
    }
  }
</style>

<script>
  /* ---------- The loop plays only while on screen; reduced motion: the poster ---------- */
  const video = document.querySelector<HTMLVideoElement>('[data-showcase-video]');
  if (video) {
    video.muted = true;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still) {
      video.removeAttribute('autoplay');
      video.pause();
    } else {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }).observe(video);
    }
  }


  /* ---------- Test: alternate, the platform and the film taking turns ---------- */
  {
    const html = document.documentElement;
    const altFrame = document.querySelector<HTMLElement>('[data-showcase-frame]');
    const app = altFrame?.querySelector<HTMLVideoElement>('[data-showcase-video]');
    const film = altFrame?.querySelector<HTMLVideoElement>('[data-sc-alt]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const APP_MS = 7000;
    const FILM_MS = 5000;
    const FADE_MS = 900;
    let timer = 0;
    const show = (onFilm: boolean) => {
      if (!altFrame || !app || !film) return;
      altFrame.toggleAttribute('data-alt-on', onFilm);
      if (onFilm) {
        if (film.preload === 'none') film.preload = 'auto';
        film.play().catch(() => {});
        // The platform holds its place while the film plays, then carries on.
        window.setTimeout(() => altFrame.hasAttribute('data-alt-on') && app.pause(), FADE_MS);
      } else {
        app.play().catch(() => {});
        window.setTimeout(() => !altFrame.hasAttribute('data-alt-on') && film.pause(), FADE_MS);
      }
      timer = window.setTimeout(() => show(!onFilm), onFilm ? FILM_MS : APP_MS);
    };
    const stop = () => {
      window.clearTimeout(timer);
      altFrame?.removeAttribute('data-alt-on');
      film?.pause();
    };
    const start = () => {
      stop();
      if (html.dataset.scMix !== 'alternate' || still) return;
      timer = window.setTimeout(() => show(true), APP_MS);
    };
    window.addEventListener('showcase:mix', start);
    start();
  }

  /* ---------- The film ground runs down to the capture's ground ---------- */
  const ground = document.querySelector<HTMLElement>('[data-sc-ground]');
  const groundStage = ground?.parentElement?.querySelector<HTMLElement>('.sc__stage');
  const groundHost = ground?.parentElement;
  if (ground && groundStage && groundHost) {
    // From the top of the section to the bottom of the capture's ground (layout
    // boxes, so the stage's entrance transform doesn't count).
    const fit = () => {
      let y = 0;
      for (let el: HTMLElement | null = groundStage; el && el !== groundHost; el = el.offsetParent as HTMLElement | null) y += el.offsetTop;
      ground.style.setProperty('--ground-h', `${y + groundStage.offsetHeight}px`);
    };
    const ro = new ResizeObserver(fit);
    ro.observe(groundStage);
    ro.observe(groundHost);
    window.addEventListener('load', fit, { once: true });
    fit();
  }
  import('../../scripts/hero-video').then((m) => m.mountHeroVideos());

  /* ---------- Glow (App hero): fades out as the page scrolls ---------- */
  const glow = document.querySelector<HTMLElement>('[data-glow]');
  if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    const dim = () => {
      raf = 0;
      // Gone by the time the capture reaches the middle of the screen.
      const g = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.35)));
      const e = g * g * (3 - 2 * g);
      glow.style.setProperty('--g', e.toFixed(3));
    };
    window.addEventListener('scroll', () => raf || (raf = requestAnimationFrame(dim)), { passive: true });
    dim();
  }

  /* ---------- Scroll: tilt → flat ---------- */
  const section = document.querySelector<HTMLElement>('[data-showcase]');
  const frame = section?.querySelector<HTMLElement>('[data-showcase-frame]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section && frame && !reduce.matches) {
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const smooth = (t: number) => t * t * (3 - 2 * t);
    let raf = 0;
    let last = -1;

    // p runs from 0 when the frame's top enters the viewport (or at the top of
    // the page, when it is already in view) to 1 when the frame is centred.
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      const top = section.getBoundingClientRect().top + window.scrollY + frame.offsetTop; // untransformed
      const h = frame.offsetHeight;
      const start = Math.max(0, top - vh);
      const end = Math.max(start + 1, top - Math.max(0, (vh - h) / 2));
      const p = Math.round(smooth(clamp01((window.scrollY - start) / (end - start))) * 1000) / 1000;
      if (p === last) return;
      last = p;
      section.style.setProperty('--p', String(p));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    // Only listen while the showcase is near the viewport.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) window.addEventListener('scroll', onScroll, { passive: true });
        else window.removeEventListener('scroll', onScroll);
        update();
      },
      { rootMargin: '25% 0px' },
    ).observe(section);
    window.addEventListener('resize', onScroll, { passive: true });
    // The hero layout switch changes where the frame starts.
    window.addEventListener('hero:change', () => requestAnimationFrame(update));
    update();
  }
</script>
