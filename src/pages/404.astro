---
/**
 * 404, from "predicterra-15-404.md". Answers with a real 404 and is not indexed.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
import PageTitle from '../components/PageTitle.astro';
import { getCopy, localizePath } from '../i18n/config';

const locale = 'en';
const { notFound: nf } = getCopy(locale).common;
---

<PageLayout title="Page not found | Predicterra" description={nf.text} locale={locale} noindex>
  <section class="nf" aria-labelledby="page-title">
    <div class="container nf__inner">
      <p class="nf__code t-num" aria-hidden="true">{nf.label}</p>
      <PageTitle class="nf__title" text={nf.title} />
      <p class="nf__text">{nf.text}</p>
      <div class="nf__actions">
        <Button href={localizePath(nf.primary.href, locale)} label={nf.primary.label} size="lg" />
        <Button href={localizePath(nf.secondary.href, locale)} label={nf.secondary.label} size="lg" variant="secondary" />
      </div>
      <ul class="nf__links">
        {nf.links.map((l) => <li><a href={localizePath(l.href, locale)}>{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .nf__inner {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1.5rem;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 3rem) 4rem;
    text-align: center;
  }

  .nf__code {
    font-size: clamp(5rem, 3rem + 9vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--accent);
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background-size: var(--grad-text-size);
    animation: var(--fire-text-motion);
  }

  .nf__title {
    max-width: 18ch;
    font-size: var(--pg-hero);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .nf__text {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.5rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
  }

  .nf__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nf__links a:hover {
      color: var(--accent);
      background: var(--grad-text);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      background-size: var(--grad-text-size);
      animation: var(--fire-text-motion);
    }
  }
</style>
