  .an-row__title {
    font-size: var(--fs-h4);
    line-height: 1.2;
    letter-spacing: var(--track-title);
  }

  .an-row__text {
    max-width: 52ch;
    color: var(--ink-2);
  }

  .an-row--icon {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
