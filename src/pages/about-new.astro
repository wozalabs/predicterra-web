---
/**
 * About, new draft (/about-new). Copy from "predicterra-about-textos.md".
 *
 * Site design language (near-white canvas, notched rules, 4 : 8 grid, notched
 * image frames, grey CTA card), with no eyebrows and every section at least one
 * viewport tall. Like the homepage it mixes a classic reading layout with a few
 * scroll-driven moments: the mission statement lights up word by word, the
 * milestones turn on a dial with each year's text beside it, and the dark Trust
 * section slides over the pinned sovereignty section while the page turns dark.
 * Reduced motion gets the static layout. Not indexed while it is a draft.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NotchRule from '../components/NotchRule.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import wozaLogoRaw from '../assets/woza-labs.svg?raw';
import AboutCompare from '../components/AboutCompare.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy, withBase } from '../i18n/config';
import type { IconName } from '../data/icons';

const locale = 'en';
const { aboutNew: a } = getCopy(locale);
const pad = (n: number) => String(n).padStart(2, '0');
const n = a.milestones.items.length;
const last = n - 1;

// Mission statement split in words for the scroll highlight; the payoff in orange.
const missionHead = a.mission.title.slice(0, a.mission.title.length - a.mission.accent.length).trim().split(' ');
const missionAccent = a.mission.accent.split(' ');

// Woza Labs logo, recoloured to follow the text colour (light on the dark section).
const wozaLogo = wozaLogoRaw
  .replace(/<metadata[\s\S]*?<\/metadata>/g, '') // keep the page light: no embedded file metadata
  .replace(/fill="#161616"/g, 'fill="currentColor"')
  .replace('<svg ', '<svg role="img" aria-label="Woza Labs" focusable="false" ');

---

<BaseLayout title={a.seo.title} description={a.seo.description} locale={locale} noindex>
  <!-- 1. Hero -->
  <section class="an-full an-hero" aria-labelledby="about-title">
    <div class="container an-hero__inner">
      <h1 id="about-title" class="an-hero__title" data-render>{a.hero.title.replace('deep-tech', 'deep\u2011tech')}</h1>
      <div class="an-grid an-hero__copy">
        <div aria-hidden="true"></div>
        <div class="an-hero__text" data-reveal-group>
          <p class="an-lead" data-reveal>{a.hero.text}</p>
          <p class="an-hero__proof" data-reveal>
            <span>{a.hero.place}</span>
            <span class="t-muted">{a.hero.proof}</span>
          </p>
        </div>
      </div>
      <figure class="an-hero-media" data-reveal>
        <img
          data-parallax
          src={withBase(a.hero.photo.src)}
          alt={a.hero.photo.alt}
          width={a.hero.photo.w}
          height={a.hero.photo.h}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- 2. Mission -->
  <section class="an-full" aria-labelledby="mission-title">
    <div class="container an-full__inner">
      <NotchRule at={70} />
      <div class="an-body">
        <h2 id="mission-title" class="an-statement" data-lit>
          {missionHead.map((w) => <span class="w">{w} </span>)}
          <span class="accent nowrap">{missionAccent.map((w) => <span class="w">{w} </span>)}</span>
        </h2>
        <div class="an-grid an-grid--tight">
          <div aria-hidden="true"></div>
          <p class="an-lead an-lead--lg" data-reveal>{a.mission.text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Milestones: pinned; the years turn on a dial at the left and each
       year's milestone reads right beside it, on the same line. -->
  <section class="an-ms" aria-labelledby="milestones-title" data-ms style={`--n:${n}`}>
    <div class="an-ms__stage">
      <div class="container">
        <NotchRule at={70} />
        <h2 id="milestones-title" class="t-h2 an-ms__title" data-render>{a.milestones.title}</h2>
      </div>
      <div class="container an-ms__body">
        <div class="an-ms__wheel" data-ms-wheel>
          <span class="an-ms__mark" aria-hidden="true"></span>
          <span class="an-ms__lead" aria-hidden="true"></span>
          {
            a.milestones.items.map((m, i) => (
              <span class:list={['an-ms__wy t-num', i === last && 'is-last']} aria-hidden="true" data-ms-wy>
                {m.year}
              </span>
            ))
          }
          <ol class="an-ms__list" data-ms-list>
            {
              a.milestones.items.map((m, i) => (
                <li class:list={['an-ms__item', i === last && 'is-last']} data-ms-item>
                  <span class="an-ms__node" aria-hidden="true" />
                  <p class="an-ms__year t-num">{m.year}</p>
                  <p class="an-ms__text">{m.text.replace(/(\w)-(\w)/g, '$1\u2011$2')}</p>
                  <p class="an-ms__count t-num" aria-hidden="true">{pad(i + 1)} / {pad(n)}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 4–5. The sovereignty section stays pinned while the dark Trust section slides over it -->
  <div class="an-pin">
    <section class="an-full an-pinned" aria-labelledby="sovereign-title" data-pinned>
      <div class="container an-full__inner">
        <NotchRule at={70} />
        <div class="an-body">
          <div class="an-grid">
            <h2 id="sovereign-title" class="t-h2 an-head" data-render>{a.sovereign.title}</h2>
            <ul class="an-rows" data-reveal-group>
              {
                a.sovereign.items.map((it) => (
                  <li class="an-row an-row--icon" data-reveal>
                    <Icon name={it.icon as IconName} boxed size="2.75rem" />
                    <h3 class="an-row__title">{it.title}</h3>
                    <p class="an-row__text">{it.text}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="an-full an-trust theme-scrub" aria-labelledby="trust-title" data-theme-dark data-header-dark="scrub">
      <div class="container an-full__inner">
        <div class="an-body">
          <div class="an-grid">
            <h2 id="trust-title" class="t-h2 an-head" data-render>{a.trust.title}</h2>
            <ol class="an-rows" data-reveal-group>
              {
                a.trust.items.map((it, i) => (
                  <li class="an-row an-row--num" data-reveal>
                    <span class="an-row__num t-num">{pad(i + 1)}</span>
                    <h3 class="an-row__title">{it.title}</h3>
                    <p class="an-row__text">{it.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- 6. Recognition: scrubbed back from dark to light as it comes in -->
  <section class="an-full an-recog theme-scrub" aria-labelledby="recognition-title" data-theme-next>
    <div class="container an-full__inner">
      <div class="an-body">
        <h2 id="recognition-title" class="t-h2 an-head" data-render>{a.recognition.title}</h2>
        <ul class="an-cards" data-reveal-group>
          {
            a.recognition.items.map((it) => (
              <li class="an-card" data-reveal>
                <div class="an-card__brand">
                  {it.logo ? (
                    <img
                      src={withBase(it.logo.src)}
                      alt={it.name}
                      width={Math.round((it.logo.w / it.logo.h) * it.logo.h1)}
                      height={it.logo.h1}
                      style={`--h:${it.logo.h1}px`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="an-card__wordmark">{it.name}</span>
                  )}
                </div>
                <div class="an-card__body">
                  {it.logo && <h3 class="an-card__name t-small">{it.name}</h3>}
                  <p class="an-card__text">
                    <span class="an-dot" aria-hidden="true" />
                    {it.text}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. Team -->
  <section class="an-full" aria-labelledby="team-title">
    <div class="container an-full__inner">
      <NotchRule at={70} />
      <div class="an-body">
        <div class="an-grid">
          <h2 id="team-title" class="t-h2 an-head" data-render>{a.team.title}</h2>
          <p class="an-lead an-lead--lg" data-reveal>{a.team.text}</p>
        </div>
        <ul class="an-team" data-reveal-group>
          {
            a.team.people.map((m, i) => (
              <li class="an-person" data-reveal>
                <div class="an-person__photo">
                  <img src={withBase(m.photo)} alt={m.name} width="600" height="600" loading="lazy" decoding="async" />
                </div>
                <p class="an-person__index t-caption t-num">{pad(i + 1)}</p>
                <h3 class="an-person__name">{m.name}</h3>
                <p class="an-person__role t-small">{m.role}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. Built by Woza: dark; the whole card is the link to wozalabs.com -->
  <section class="an-full an-woza-sec theme-dark" aria-labelledby="woza-title" data-header-dark>
    <div class="container an-full__inner">
      <a class="an-woza" href={a.woza.link.href} target="_blank" rel="noopener" data-btn-host data-reveal>
        <div class="an-woza__logo" set:html={wozaLogo} />
        <h2 id="woza-title" class="an-woza__title">{a.woza.title}</h2>
        <div class="an-woza__side">
          <p class="an-woza__text">{a.woza.text}</p>
          <Button label={a.woza.link.label} variant="secondary" />
        </div>
      </a>
    </div>
  </section>

  <!-- 9. Where we are: details left, the BAT tower right -->
  <section class="an-full" aria-labelledby="where-title">
    <div class="container an-full__inner">
      <NotchRule at={70} />
      <div class="an-body an-where">
        <div class="an-where__info">
          <h2 id="where-title" class="t-h2 an-head" data-render>{a.where.title}</h2>
          <dl class="an-facts" data-reveal-group>
            <div class="an-fact" data-reveal>
              <dt class="t-small">{a.where.office.label}</dt>
              <dd>{a.where.office.value}</dd>
            </div>
            <div class="an-fact" data-reveal>
              <dt class="t-small">{a.where.email.label}</dt>
              <dd><a href={`mailto:${a.where.email.value}`}>{a.where.email.value}</a></dd>
            </div>
            <div class="an-fact" data-reveal>
              <dt class="t-small">{a.where.phone.label}</dt>
              <dd class="an-fact__phones">
                {
                  a.where.phone.items.map((p) => (
                    <a href={p.href}>
                      <span class="t-muted">{p.label}</span> <span class="t-num">{p.value}</span>
                    </a>
                  ))
                }
              </dd>
            </div>
          </dl>
          <div data-reveal>
            <Button href={a.where.open.href} label={a.where.open.label} variant="secondary" external />
          </div>
        </div>
        <figure class="an-where__photo" data-reveal>
          <img
            src={withBase(a.where.photo.src)}
            alt={a.where.photo.alt}
            width={a.where.photo.w}
            height={a.where.photo.h}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- 10. CTA -->
  <div class="an-cta">
    <Cta locale={locale} copy={a.cta} />
  </div>

  <AboutCompare locale={locale} current="draft" />
</BaseLayout>

<style>
  /* ---------- Section frame: at least one viewport tall ---------- */
  .an-full {
    position: relative;
    display: flex;
    min-height: 100svh;
  }

  .an-full__inner {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  /* Content centred in the space under the rule. */
  .an-body {
    flex: 1;
    display: grid;
    align-content: center;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .an-grid {
    display: grid;
    /* Generous gap between the title column and the content, so both breathe. */
    gap: 2rem clamp(2.5rem, 1rem + 5vw, 7.5rem);
  }

  .an-grid--tight {
    gap: 0 var(--gutter);
  }

  @media (min-width: 64rem) {
    .an-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .an-head {
    align-self: start;
    max-width: 30rem;
    text-wrap: balance;
  }

  .an-lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .an-lead--lg {
    max-width: 36ch;
    font-size: var(--fs-h4);
    line-height: 1.4;
    letter-spacing: var(--track-title);
  }

  /* ---------- 1. Hero ---------- */
  .an-hero__inner {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 1rem + 6vh, 6rem));
    padding-bottom: clamp(1rem, 0.5rem + 1vw, 2rem);
  }

  .an-hero__title {
    max-width: 16ch;
    font-size: clamp(2.75rem, 1rem + 4.6vw, 6rem);
    line-height: 0.96;
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }

  .an-hero__copy {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .an-hero__text {
    display: grid;
    gap: 1.25rem;
  }

  .an-hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.4em;
    font-size: var(--fs-small);
  }

  /* The photo takes whatever the viewport has left (never less than a band). */
  .an-hero-media {
    position: relative;
    flex: 1 1 0;
    min-height: clamp(12rem, 30svh, 26rem);
    overflow: hidden;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    background: #e4e4e4;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  .an-hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .an-hero-media.is-parallax img {
    height: 116%;
    transform: translate3d(0, var(--py, 0px), 0);
    will-change: transform;
  }

  /* ---------- 2. Mission ---------- */
  .an-statement {
    max-width: 20ch;
    font-size: var(--fs-display);
    line-height: 0.98;
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }

  :global(.lit-on) .an-statement .w {
    opacity: var(--o, 0.16);
    transition: opacity 200ms linear;
  }

  /* ---------- 3. Milestones ----------
     Static by default (no JS, reduced motion): a list with a line and a node per
     year (vertical on phones, five columns on wide screens). With JS, .is-pinned
     pins the stage and turns it into the dial. */
  .an-ms {
    --node: 0.625rem;
    position: relative;
  }

  .an-ms__stage {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .an-ms__title {
    max-width: 30rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    text-wrap: balance;
  }

  .an-ms__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .an-ms__mark,
  .an-ms__lead,
  .an-ms__wy,
  .an-ms__count {
    display: none;
  }

  .an-ms__list {
    display: grid;
    gap: 0 var(--gutter);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .an-ms__item {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 0 0 2rem 1.75rem;
  }

  .an-ms__item::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }

  .an-ms__node {
    position: absolute;
    left: 0;
    top: 0.25rem;
    width: var(--node);
    height: var(--node);
    background: var(--ink);
  }

  .an-ms__item.is-last::before,
  .an-ms__item.is-last .an-ms__node {
    background: var(--accent);
  }

  .an-ms__year {
    font-size: var(--fs-h2);
    line-height: 0.9;
    letter-spacing: var(--track-display);
  }

  .an-ms__text {
    max-width: 30ch;
    color: var(--ink-2);
  }

  @media (min-width: 64rem) {
    .an-ms:not(.is-pinned) .an-ms__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }

    .an-ms:not(.is-pinned) .an-ms__item {
      padding: 2.25rem 0 0;
    }

    .an-ms:not(.is-pinned) .an-ms__item::before {
      left: 0;
      right: calc(-1 * var(--gutter));
      top: calc(var(--node) / 2 - 0.5px);
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .an-ms:not(.is-pinned) .an-ms__item.is-last::before {
      right: 0;
      height: 2px;
    }

    .an-ms:not(.is-pinned) .an-ms__node {
      top: 0;
    }
  }

  /* ----- Pinned dial ----- */
  .an-ms.is-pinned .an-ms__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }

  .an-ms.is-pinned .an-ms__body {
    min-height: 0;
    padding-top: 1rem;
  }

  .an-ms.is-pinned .an-ms__wheel {
    flex: 1;
    position: relative;
    min-height: 0;
    /* Clip above and below (never over the title), but let the dial run off the
       left edge of the page. */
    clip-path: inset(0 -100vw 0 -100vw);
  }

  /* Years on the dial: placed at its centre, turned by their angle and pushed
     out along the radius (the script writes --a, --o and the geometry). */
  .an-ms.is-pinned .an-ms__wy {
    display: block;
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    font-size: var(--fs, 5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: var(--ink);
    opacity: var(--o, 0);
    transform-origin: 0 50%;
    transform: rotate(var(--a, 0rad)) translateX(var(--r, 0px)) translateY(-50%);
    will-change: transform, opacity;
  }

  .an-ms.is-pinned .an-ms__wy.is-last {
    color: var(--accent);
  }

  /* Pointer on the centre line, just before the current year. */
  .an-ms.is-pinned .an-ms__mark {
    display: block;
    position: absolute;
    left: var(--mx);
    top: var(--cy);
    width: 0.75rem;
    height: 0.75rem;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }

  /* Leader line from the current year to its milestone (wide screens). */
  .an-ms.is-pinned .an-ms__lead {
    display: block;
    position: absolute;
    left: var(--lx);
    top: var(--cy);
    width: var(--lw, 0px);
    height: 1px;
    background: var(--line-strong);
  }

  :global(.an-ms__tick) {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    width: var(--tl, 0.75rem);
    height: 1px;
    background: var(--line-strong);
    transform-origin: 0 50%;
    transform: rotate(var(--a, 0rad)) translateX(var(--r, 0px));
  }

  /* The current year's milestone, beside it on the same line (below it on
     phones), crossfaded as the dial turns. */
  .an-ms.is-pinned .an-ms__list {
    position: absolute;
    left: var(--tx);
    top: var(--ty);
    width: var(--tw);
    margin: 0;
    display: grid;
  }

  .an-ms.is-pinned .an-ms__item {
    grid-area: 1 / 1;
    align-self: var(--align, center);
    gap: 0.75rem;
    padding: 0;
    opacity: var(--t, 0);
    transform: translate3d(0, calc((1 - var(--t, 0)) * var(--dir, 1) * 0.5rem), 0);
    visibility: var(--vis, hidden);
  }

  .an-ms.is-pinned .an-ms__item::before,
  .an-ms.is-pinned .an-ms__node,
  .an-ms.is-pinned .an-ms__year {
    display: none;
  }

  .an-ms.is-pinned .an-ms__text {
    max-width: 24ch;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: var(--track-title);
    color: var(--ink);
    text-wrap: balance;
  }

  .an-ms.is-pinned .an-ms__count {
    display: block;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 47.99rem) {
    .an-ms.is-pinned .an-ms__text {
      font-size: var(--fs-h4);
    }
  }

  /* ---------- Rows (sovereignty, Trust) ---------- */
  .an-rows {
    display: grid;
  }

  .an-row {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding-block: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-top: 1px solid var(--line);
  }

  .an-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .an-row__title {
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: var(--track-title);
  }

  .an-row__text {
    max-width: 48ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .an-row--icon {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'icon title'
      'icon text';
  }

  .an-row--icon :global(.ibox) {
    grid-area: icon;
  }

  .an-row--icon .an-row__title {
    grid-area: title;
    align-self: center;
  }

  .an-row--icon .an-row__text {
    grid-area: text;
  }

  .an-row--num {
    grid-template-columns: 2.75rem minmax(0, 1fr);
    grid-template-areas:
      'num title'
      'num text';
  }

  .an-row--num .an-row__num {
    grid-area: num;
    padding-top: 0.45rem;
    font-size: var(--fs-small);
    color: var(--accent);
  }

  .an-row--num .an-row__title {
    grid-area: title;
  }

  .an-row--num .an-row__text {
    grid-area: text;
  }

  /* ---------- Pinned section + Trust slides over (homepage Solutions pattern) ---------- */
  .an-pin {
    position: relative;
  }

  /* Sticks once its bottom reaches the bottom of the viewport (top set by the script). */
  .an-pinned {
    position: sticky;
    top: var(--pin-top, 0px);
    z-index: var(--z-stage);
    background: var(--canvas);
  }

  .an-trust,
  .an-recog {
    z-index: var(--z-cover);
  }

  .an-trust {
    box-shadow: 0 -24px 48px -24px rgb(30 30 30 / 0.14);
  }

  /* ---------- Recognition ---------- */
  .an-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gutter);
  }

  @media (min-width: 40rem) {
    .an-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .an-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .an-card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--card);
  }

  .an-card__brand {
    display: flex;
    align-items: center;
    height: 2.5rem;
  }

  .an-card__brand img {
    width: auto;
    height: var(--h);
    max-width: 100%;
    filter: brightness(0) invert(var(--dt, 0));
    opacity: 0.7;
  }

  .an-card__wordmark {
    font-size: var(--fs-h3);
    letter-spacing: var(--track-title);
  }

  .an-card__body {
    display: grid;
    align-content: end;
    gap: 0.375rem;
  }

  .an-card__name {
    color: var(--muted);
  }

  .an-card__text {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .an-dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  /* ---------- Team ---------- */
  .an-team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
  }

  @media (min-width: 48rem) {
    .an-team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .an-team {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .an-person {
    display: grid;
    align-content: start;
  }

  .an-person__photo {
    overflow: hidden;
    aspect-ratio: 1;
    margin-bottom: 1rem;
    background: #e4e4e4;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  /* Portraits are cut out on white: multiply takes the white to the frame grey. Always in colour. */
  .an-person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .an-person__index {
    color: var(--muted);
  }

  .an-person__name {
    margin-top: 0.25rem;
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .an-person__role {
    margin-top: 0.25rem;
    color: var(--ink-2);
  }

  /* ---------- Built by Woza: dark section, one large card that is the link ----------
     Logo at the top left; at the foot, the statement on the left and the text
     with the button on the right (the same 4 : 8 rhythm, mirrored). */
  .an-woza-sec {
    background: var(--grey-700);
  }

  .an-woza {
    flex: 1;
    display: grid;
    grid-template-areas: 'logo' 'title' 'side';
    grid-template-rows: auto 1fr auto;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    background: var(--surface);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
    color: var(--ink);
    transition: background-color 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 64rem) {
    .an-woza {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      grid-template-areas: 'logo .' 'title side';
      grid-template-rows: 1fr auto;
      column-gap: clamp(2.5rem, 1rem + 5vw, 7.5rem);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .an-woza:hover {
      background: #2c2c2c;
    }
  }

  /* Inset: the notched clip-path would cut an outside outline. */
  .an-woza:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -6px;
  }

  .an-woza__logo {
    grid-area: logo;
    align-self: start;
    width: clamp(10rem, 6rem + 12vw, 20rem);
  }

  .an-woza__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .an-woza__title {
    grid-area: title;
    align-self: end;
    max-width: 18ch;
    font-size: var(--fs-display);
    line-height: 0.98;
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }

  .an-woza__side {
    grid-area: side;
    align-self: end;
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .an-woza__text {
    max-width: 36ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- Where we are ---------- */
  .an-facts {
    display: grid;
  }

  .an-fact {
    display: grid;
    gap: 0.375rem 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  .an-fact:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 48rem) {
    .an-fact {
      grid-template-columns: 8rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .an-fact dt {
    color: var(--muted);
  }

  .an-fact dd {
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .an-fact__phones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .an-facts a {
    width: fit-content;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .an-facts a:hover {
      color: var(--accent);
    }
  }

  /* Details left, map right; the map fills the section's height. */
  .an-where {
    align-content: stretch;
    gap: 2.5rem clamp(2.5rem, 1rem + 5vw, 7.5rem);
  }

  @media (min-width: 64rem) {
    .an-where {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .an-where__info {
    display: grid;
    align-content: center;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* The BAT tower in the notched frame, filling the section's height. */
  .an-where__photo {
    position: relative;
    overflow: hidden;
    min-height: clamp(20rem, 58svh, 46rem);
    background: #e4e4e4;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  .an-where__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* A different crop from the hero: the tower itself. */
    object-position: 30% 40%;
  }

  /* ---------- CTA: a full viewport too ---------- */
  .an-cta {
    display: grid;
    align-content: center;
    min-height: 100svh;
    background: var(--canvas);
  }
</style>

<script>
  import { mountThemeScrub } from '../scripts/theme-scrub';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  /** Calls `fn` on scroll (one rAF per frame) only while `el` is near the viewport. */
  function whileNear(el: Element, fn: () => void, margin = '25% 0px') {
    let raf = 0;
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(() => ((raf = 0), fn()));
    };
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          window.addEventListener('scroll', onScroll, { passive: true });
          fn();
        } else window.removeEventListener('scroll', onScroll);
      },
      { rootMargin: margin },
    ).observe(el);
    window.addEventListener('resize', onScroll, { passive: true });
  }

  // Dark Trust section: light → dark → light, like the homepage.
  mountThemeScrub();

  // The sovereignty section sticks when its bottom meets the bottom of the
  // viewport, so Trust slides over it instead of pushing it away.
  const pinned = document.querySelector<HTMLElement>('[data-pinned]');
  if (pinned) {
    const setTop = () => pinned.style.setProperty('--pin-top', `${Math.min(0, window.innerHeight - pinned.offsetHeight)}px`);
    setTop();
    new ResizeObserver(setTop).observe(pinned);
    window.addEventListener('resize', setTop, { passive: true });
  }

  if (!reduce) {
    // Hero photo: slow drift inside its frame.
    const fig = document.querySelector<HTMLElement>('.an-hero-media');
    const img = fig?.querySelector<HTMLElement>('[data-parallax]');
    if (fig && img) {
      fig.classList.add('is-parallax');
      whileNear(fig, () => {
        const r = fig.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = clamp01((vh - r.top) / (vh + r.height));
        img.style.setProperty('--py', `${(-p * 0.14 * r.height).toFixed(1)}px`);
      });
    }

    // Mission statement: lit word by word as it scrolls in (homepage claim pattern).
    const lit = document.querySelector<HTMLElement>('[data-lit]');
    if (lit) {
      const words = Array.from(lit.querySelectorAll<HTMLElement>('.w'));
      lit.parentElement?.classList.add('lit-on');
      whileNear(lit, () => {
        const vh = window.innerHeight;
        const top = lit.getBoundingClientRect().top;
        const p = clamp01((vh * 0.9 - top) / (vh * 0.9 - vh * 0.35));
        const on = p * words.length;
        words.forEach((w, i) => w.style.setProperty('--o', Math.min(1, Math.max(0.16, on - i + 0.16)).toFixed(3)));
      });
    }

    // Milestones: the stage pins; the years turn on a dial at the left and the
    // current year's milestone sits beside it on the centre line.
    const ms = document.querySelector<HTMLElement>('[data-ms]');
    const wheel = ms?.querySelector<HTMLElement>('[data-ms-wheel]');
    if (ms && wheel) {
      const years = Array.from(wheel.querySelectorAll<HTMLElement>('[data-ms-wy]'));
      const items = Array.from(wheel.querySelectorAll<HTMLElement>('[data-ms-item]'));
      const list = wheel.querySelector<HTMLElement>('[data-ms-list]')!;
      const n = years.length;
      const DWELL = 0.35; // each year rests for this part of its scroll segment
      const SEGMENTS = n - 1 + 0.6;
      const TICKS = 72;
      const ticks: HTMLElement[] = [];
      for (let i = 0; i < TICKS; i++) {
        const t = document.createElement('span');
        t.className = 'an-ms__tick';
        t.setAttribute('aria-hidden', 'true');
        wheel.prepend(t);
        ticks.push(t);
      }

      let g = { R: 0, H: 0, fs: 0, step: 0, gap: 0, tickStep: 0, maxA: 0 };
      // Fades a year out before it reaches the top or bottom of the dial area.
      const edge = (a: number) => clamp01((g.H / 2 - Math.abs(Math.sin(a) * g.R) - g.fs * 0.6) / (g.fs * 0.8));
      // Angle of a year at signed distance d from the current one: an even step,
      // plus extra room on either side of the current year for its milestone.
      const angle = (d: number) => d * g.step + Math.max(-1, Math.min(1, d)) * g.gap;

      ms.classList.add('is-pinned');

      // Geometry from the space the dial has, so it always fits the viewport.
      const size = () => {
        ms.style.height = `${window.innerHeight * (1 + SEGMENTS * 0.85)}px`;
        const W = wheel.clientWidth;
        const H = wheel.clientHeight;
        const wide = W >= 720;
        // Year size: large, but leaving room beside it (wide) or under it (phones) for the text.
        const fs = Math.max(44, Math.min(H * (wide ? 0.2 : 0.14), W * (wide ? 0.17 : 0.26), 200));
        const R = Math.max(H * 0.95, fs * 4.2); // the dial centre sits far left, off-screen
        const markX = 6;
        const startX = markX + 22; // where the current year starts
        const cx = startX - R;
        const cy = H / 2;
        years.forEach((y) => {
          y.style.setProperty('--fs', `${fs}px`);
          y.style.setProperty('--r', `${R}px`);
        });
        // Widest year, measured unrotated.
        const yearW = Math.max(...years.map((y) => y.scrollWidth));
        wheel.style.setProperty('--cx', `${cx}px`);
        wheel.style.setProperty('--cy', `${cy}px`);
        wheel.style.setProperty('--mx', `${markX}px`);

        let gap = 0;
        if (wide) {
          // Text on the same line, after a short leader line.
          const lx = startX + yearW + 16;
          const tx = lx + Math.min(96, W * 0.07) + 16;
          wheel.style.setProperty('--lx', `${lx}px`);
          wheel.style.setProperty('--lw', `${tx - lx - 16}px`);
          wheel.style.setProperty('--tx', `${tx}px`);
          wheel.style.setProperty('--tw', `${Math.max(200, W - tx)}px`);
          wheel.style.setProperty('--ty', `${cy}px`);
          list.style.transform = 'translateY(-50%)';
          items.forEach((el) => el.style.setProperty('--align', 'center'));
          gap = (fs * 0.25) / R;
        } else {
          // Phones: text directly under the current year; the dial opens up around it.
          wheel.style.setProperty('--lw', '0px');
          wheel.style.setProperty('--tx', `${startX}px`);
          wheel.style.setProperty('--tw', `${W - startX}px`);
          wheel.style.setProperty('--ty', `${cy + fs * 0.55 + 10}px`);
          list.style.transform = 'none';
          items.forEach((el) => el.style.setProperty('--align', 'start'));
          const textH = Math.max(...items.map((el) => el.scrollHeight));
          gap = (textH + 24) / R;
        }
        const step = (fs * 1.15) / R;
        g = { R, H, fs, step, gap, tickStep: step / 4, maxA: Math.asin(Math.min(1, (H / 2 + fs) / R)) };
        ticks.forEach((t, i) => {
          const long = i % 4 === 0;
          t.style.setProperty('--r', `${R - 34 - (long ? 14 : 8)}px`);
          t.style.setProperty('--tl', `${long ? 14 : 8}px`);
        });
      };

      let lastPos = 0;
      const update = () => {
        const travel = ms.offsetHeight - window.innerHeight;
        const p = clamp01(-ms.getBoundingClientRect().top / Math.max(1, travel));
        const raw = p * SEGMENTS;
        const k = Math.min(n - 1, Math.floor(raw));
        const pos = k >= n - 1 ? n - 1 : k + smooth(clamp01((raw - k - DWELL) / (1 - DWELL)));
        const dir = pos >= lastPos ? 1 : -1;
        lastPos = pos;

        years.forEach((y, i) => {
          const d = i - pos;
          const a = angle(d);
          y.style.setProperty('--a', `${a.toFixed(4)}rad`);
          y.style.setProperty('--o', Math.abs(a) > g.maxA ? '0' : ((1 - Math.min(1, Math.abs(d)) * 0.75) * edge(a)).toFixed(3));
        });
        const half = TICKS / 2;
        ticks.forEach((t, i) => {
          const a = (i - half - ((pos * 4) % 1)) * g.tickStep;
          t.style.setProperty('--a', `${a.toFixed(4)}rad`);
          t.style.opacity = Math.abs(a) > g.maxA ? '0' : edge(a).toFixed(3);
        });
        items.forEach((el, i) => {
          const t = clamp01(1 - Math.abs(pos - i) * 2.5);
          el.style.setProperty('--t', t.toFixed(3));
          el.style.setProperty('--dir', String(i > pos ? dir : -dir));
          el.style.setProperty('--vis', t > 0 ? 'visible' : 'hidden');
        });
      };

      const refresh = () => (size(), update());
      document.fonts?.ready.then(refresh);
      refresh();
      window.addEventListener('resize', refresh, { passive: true });
      new ResizeObserver(refresh).observe(wheel);
      whileNear(ms, update, '10% 0px');
    }
  }
</script>
