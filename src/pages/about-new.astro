    z-index: var(--z-cover);
  }

  .an-trust__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 2rem) var(--section-y);
  }

  .an-seals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .an-seals :global(.chip) {
    min-height: 2rem;
