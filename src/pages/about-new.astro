    grid-area: title;
  }

  .an-row--num .an-row__text {
    grid-area: text;
  }

  /* ---------- Independent pinned, Trust slides over (homepage Solutions pattern) ---------- */
  .an-pin {
    position: relative;
  }

  /* Sticks once its bottom reaches the bottom of the viewport (top set by the script). */
  .an-pinned {
    position: sticky;
    top: var(--pin-top, 0px);
    z-index: var(--z-stage);
    background: var(--canvas);
  }

  .an-trust {
    position: relative;
    z-index: var(--z-cover);
