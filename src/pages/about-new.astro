---
/**
 * About, new draft (/about-new). Content from the "predicterra-about.md" brief,
 * laid out in the site's current design language so it can be compared with
 * /about. The brief's visual notes are interpreted, not copied:
 * light canvas, notched rules, 4 : 8 grid, notched image frames, the grey CTA
 * card. Like the homepage it mixes a classic reading layout with a few
 * scroll-driven moments: the mission statement lights up word by word, the
 * milestones pin and run sideways, and the dark Trust section slides over the
 * pinned Independent section while the page theme turns dark. Reduced motion
 * gets the static layout. Not indexed while it is a draft.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NotchRule from '../components/NotchRule.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import TextLink from '../components/TextLink.astro';
import AboutCompare from '../components/AboutCompare.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy, withBase } from '../i18n/config';
import type { IconName } from '../data/icons';

const locale = 'en';
const { aboutNew: a } = getCopy(locale);
const pad = (n: number) => String(n).padStart(2, '0');
const last = a.milestones.items.length - 1;
const missionWords = a.mission.title.split(' ');
// The payoff of the statement, in orange (one accent per statement).
const missionAccentFrom = missionWords.length - 2;
---

<BaseLayout title={a.seo.title} description={a.seo.description} locale={locale} noindex>
  <!-- 1. Hero -->
  <PageIntro id="about-title" eyebrow={a.hero.eyebrow} title={a.hero.title} text={a.hero.text} />
  <div class="container">
    <figure class="an-hero-media" data-reveal>
      <img
        data-parallax
        src={withBase(a.hero.photo.src)}
        alt={a.hero.photo.alt}
        width={a.hero.photo.w}
        height={a.hero.photo.h}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>

  <!-- 2. Mission -->
  <section class="an-sec" aria-labelledby="mission-title">
    <div class="container">
      <NotchRule at={70} />
      <p class="label an-label">{a.mission.label}</p>
      <h2 id="mission-title" class="an-statement" data-lit>
        {missionWords.map((w, i) => <span class:list={['w', i >= missionAccentFrom && 'accent']}>{w} </span>)}
      </h2>
      <div class="an-grid an-grid--tight">
        <div aria-hidden="true"></div>
        <div class="an-mission" data-reveal-group>
          <p class="an-lead" data-reveal>{a.mission.text}</p>
          <div class="an-dfn" data-reveal>
            <p class="label">{a.mission.definition.term}</p>
            <p class="an-dfn__text"><dfn>{a.mission.definition.text}</dfn></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Story -->
  <section class="an-sec" aria-labelledby="story-title">
    <div class="container">
      <NotchRule at={70} />
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.story.label}</p>
          <h2 id="story-title" class="t-h2" data-render>{a.story.title}</h2>
          <p class="an-quote" data-reveal>
            {a.story.quote.text} <span class="accent nowrap">{a.story.quote.accent}</span>
          </p>
        </div>
        <div class="an-prose" data-reveal-group>
          {a.story.paragraphs.map((p) => <p data-reveal>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Milestones: pinned, one year at a time, moving sideways with the scroll -->
  <section class="an-ms" aria-labelledby="milestones-title" data-ms style={`--n:${a.milestones.items.length}`}>
    <div class="an-ms__stage" data-ms-stage>
      <div class="container an-ms__head">
        <NotchRule at={70} />
        <div class="an-grid">
          <div class="an-head">
            <p class="label">{a.milestones.label}</p>
            <h2 id="milestones-title" class="t-h2" data-render>{a.milestones.title}</h2>
          </div>
        </div>
      </div>

      <div class="container an-ms__viewport" data-ms-viewport>
        <ol class="an-ms__track" data-ms-track>
          {
            a.milestones.items.map((m, i) => (
              <li class:list={['an-ms__panel', i === last && 'is-last']} data-ms-panel>
                <span class="an-ms__node" aria-hidden="true" />
                <p class="an-ms__year t-num">{m.year}</p>
                <p class="an-ms__text">{m.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="container an-ms__rail" aria-hidden="true">
        <div class="an-ms__line">
          <span class="an-ms__fill" data-ms-fill />
          <span class="an-ms__fill an-ms__fill--last" data-ms-fill-last />
        </div>
        <ol class="an-ms__ticks">
          {
            a.milestones.items.map((m, i) => (
              <li class:list={['an-ms__tick', i === last && 'is-last']} style={`--i:${i}`} data-ms-tick>
                <span class="an-ms__tick-node" />
                <span class="an-ms__tick-year t-num">{m.year}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. European by design -->
  <section class="an-sec" aria-labelledby="europe-title">
    <div class="container">
      <NotchRule at={70} />
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.europe.label}</p>
          <h2 id="europe-title" class="t-h2" data-render>{a.europe.title}</h2>
          <p class="an-lead" data-reveal>{a.europe.text}</p>
        </div>
        <ul class="an-rows" data-reveal-group>
          {
            a.europe.items.map((it) => (
              <li class="an-row an-row--icon" data-reveal>
                <Icon name={it.icon as IconName} boxed size="2.75rem" />
                <h3 class="an-row__title">{it.title}</h3>
                <p class="an-row__text">{it.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 6–7. Independent stays pinned while the dark Trust section slides over it -->
  <div class="an-pin">
  <section class="an-sec an-pinned" aria-labelledby="independent-title" data-pinned>
    <div class="container">
      <NotchRule at={70} />
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.independent.label}</p>
          <h2 id="independent-title" class="t-h2" data-render>{a.independent.title}</h2>
        </div>
        <div class="an-indep">
          <p class="an-lead" data-reveal>{a.independent.text}</p>
          <ul class="an-rows" data-reveal-group>
            {
              a.independent.items.map((it) => (
                <li class="an-row an-row--split" data-reveal>
                  <h3 class="an-row__title">{it.title}</h3>
                  <p class="an-row__text">{it.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Trust: dark, scrubbed from light to dark as it covers the pinned section -->
  <section class="an-trust theme-scrub" aria-labelledby="trust-title" data-theme-dark data-header-dark="scrub">
    <div class="container an-trust__inner">
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.trust.label}</p>
          <h2 id="trust-title" class="t-h2" data-render>{a.trust.title}</h2>
          <p class="an-lead" data-reveal>{a.trust.text}</p>
        </div>
        <ol class="an-rows" data-reveal-group>
          {
            a.trust.items.map((it, i) => (
              <li class="an-row an-row--num" data-reveal>
                <span class="an-row__num t-num">{pad(i + 1)}</span>
                <h3 class="an-row__title">{it.title}</h3>
                <p class="an-row__text">{it.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <ul class="an-seals" aria-label="Certifications and hosting" data-reveal>
        {a.trust.seals.map((s) => <li class="chip">{s}</li>)}
      </ul>
    </div>
  </section>
  </div>

  <!-- 8. Recognition: scrubbed back from dark to light as it comes in -->
  <section class="an-sec an-sec--first an-recog theme-scrub" aria-labelledby="recognition-title" data-theme-next>
    <div class="container">
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.recognition.label}</p>
          <h2 id="recognition-title" class="t-h2" data-render>{a.recognition.title}</h2>
        </div>
      </div>
      <ul class="an-cards" data-reveal-group>
        {
          a.recognition.items.map((it) => (
            <li class="an-card" data-reveal>
              <div class="an-card__brand">
                {it.logo ? (
                  <img
                    src={withBase(it.logo.src)}
                    alt={it.name}
                    width={Math.round((it.logo.w / it.logo.h) * it.logo.h1)}
                    height={it.logo.h1}
                    style={`--h:${it.logo.h1}px`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="an-card__wordmark">{it.name}</span>
                )}
              </div>
              <div class="an-card__body">
                {it.logo && <h3 class="an-card__name t-small">{it.name}</h3>}
                <p class="an-card__text">
                  <span class="an-dot" aria-hidden="true" />
                  {it.text}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. Team -->
  <section class="an-sec" aria-labelledby="team-title">
    <div class="container">
      <NotchRule at={70} />
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.team.label}</p>
          <h2 id="team-title" class="t-h2" data-render>{a.team.title}</h2>
        </div>
        <p class="an-lead" data-reveal>{a.team.text}</p>
      </div>
      <ul class="an-team" data-reveal-group>
        {
          a.team.people.map((m, i) => (
            <li class="an-person" data-reveal>
              <div class="an-person__photo">
                <img src={withBase(m.photo)} alt={m.name} width="600" height="600" loading="lazy" decoding="async" />
              </div>
              <p class="an-person__index t-caption t-num">{pad(i + 1)}</p>
              <h3 class="an-person__name">{m.name}</h3>
              <p class="an-person__role t-small">{m.role}</p>
              {m.org && <p class="an-person__org t-small">{m.org}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 10. Built by Woza -->
  <section class="an-sec" aria-labelledby="woza-title">
    <div class="container">
      <div class="an-woza" data-reveal>
        <div class="an-woza__brand">
          <p class="label">{a.woza.label}</p>
          <p class="an-woza__mark" aria-hidden="true">Woza Labs</p>
        </div>
        <div class="an-woza__body">
          <h2 id="woza-title" class="t-h3">{a.woza.title}</h2>
          <p class="an-woza__text">{a.woza.text}</p>
          <TextLink href={a.woza.link.href} label={`${a.woza.link.label} →`} external />
        </div>
      </div>
    </div>
  </section>

  <!-- 11. Where we are -->
  <section class="an-sec" aria-labelledby="where-title">
    <div class="container">
      <NotchRule at={70} />
      <div class="an-grid">
        <div class="an-head">
          <p class="label">{a.where.label}</p>
          <h2 id="where-title" class="t-h2" data-render>{a.where.title}</h2>
        </div>
        <div class="an-where" data-reveal-group>
          <address class="an-where__contact" data-reveal>
            <span class="an-lead">{a.where.address}</span>
            <a href={`mailto:${a.where.email}`}>{a.where.email}</a>
            {
              a.where.phones.map((p) => (
                <a href={p.href}>
                  <span class="t-muted">{p.label}</span> <span class="t-num">{p.value}</span>
                </a>
              ))
            }
          </address>
          <p class="an-where__join t-small" data-reveal>
            {a.where.join.text} <a href={`mailto:${a.where.join.email}`}>{a.where.join.email}</a>
          </p>
          <div class="an-map" role="img" aria-label={`${a.where.map.place}, ${a.where.map.city}`} data-reveal>
            <span class="an-map__pin" aria-hidden="true" />
            <span class="an-map__tag t-small" aria-hidden="true">
              <span>{a.where.map.place}</span>
              <span class="t-muted">{a.where.map.city}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. CTA -->
  <Cta locale={locale} copy={a.cta} />

  <AboutCompare locale={locale} current="draft" />
</BaseLayout>

<style>
  /* ---------- Shared ---------- */
  .an-sec {
    position: relative;
    padding-bottom: var(--section-y);
  }

  .an-sec--first {
    padding-top: var(--section-y);
  }

  .an-grid {
    display: grid;
    gap: 2rem var(--gutter);
    padding-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .an-grid--tight {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  @media (min-width: 64rem) {
    .an-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .an-head {
    display: grid;
    align-content: start;
    gap: 1rem;
    /* Head column wraps titles; keep them from running into the right column. */
    max-width: 30rem;
  }

  .an-label {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .an-lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- Hero media ---------- */
  .an-hero-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--section-y);
    background: #e4e4e4;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  @media (min-width: 48rem) {
    .an-hero-media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 80rem) {
    .an-hero-media {
      aspect-ratio: 21 / 9;
    }
  }

  .an-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Slow drift while the photo scrolls past (scripts below); never with reduced motion. */
  .an-hero-media.is-parallax img {
    height: 116%;
    transform: translate3d(0, var(--py, 0px), 0);
    will-change: transform;
  }

  /* ---------- Mission ---------- */
  .an-statement {
    max-width: 22ch;
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    line-height: 0.98;
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }

  :global(.lit-on) .an-statement .w {
    opacity: var(--o, 0.16);
    transition: opacity 200ms linear;
  }

  .an-mission {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .an-dfn {
    display: grid;
    gap: 0.875rem;
    max-width: 40rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--card);
  }

  .an-dfn__text dfn {
    font-style: normal;
    font-size: var(--fs-h4);
    line-height: 1.35;
    letter-spacing: var(--track-title);
  }

  /* ---------- Story ---------- */
  .an-quote {
    margin-top: clamp(0.5rem, 0.25rem + 1vw, 1.5rem);
    font-size: var(--fs-h2);
    line-height: 1.02;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .an-prose {
    display: grid;
    gap: 1.25em;
    max-width: 40rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- Milestones ----------
   Static by default (no JS, reduced motion): a vertical list on phones and a
   five-column timeline on wide screens. With JS, .is-pinned turns it into a
   sticky stage whose track moves sideways with the scroll, one year per screen. */
  .an-ms {
    --node: 0.625rem;
    position: relative;
    padding-bottom: var(--section-y);
  }

  .an-ms__track {
    display: grid;
    gap: 0 var(--gutter);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .an-ms__panel {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 0 0 2rem 1.75rem;
  }

  /* The line: vertical on small screens, horizontal from 64rem. */
  .an-ms__panel::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }

  .an-ms__node {
    position: absolute;
    left: 0;
    top: 0.25rem;
    width: var(--node);
    height: var(--node);
    background: var(--ink);
  }

  .an-ms__panel.is-last::before,
  .an-ms__panel.is-last .an-ms__node {
    background: var(--accent);
  }

  .an-ms__year {
    font-size: var(--fs-h2);
    line-height: 0.9;
    letter-spacing: var(--track-display);
  }

  .an-ms__text {
    max-width: 30ch;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .an-ms__rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .an-ms:not(.is-pinned) .an-ms__track {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }

    .an-ms:not(.is-pinned) .an-ms__panel {
      padding: 2.25rem 0 0;
    }

    .an-ms:not(.is-pinned) .an-ms__panel::before {
      left: 0;
      right: calc(-1 * var(--gutter));
      top: calc(var(--node) / 2 - 0.5px);
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .an-ms:not(.is-pinned) .an-ms__panel.is-last::before {
      right: 0;
      height: 2px;
    }

    .an-ms:not(.is-pinned) .an-ms__node {
      top: 0;
    }
  }

  /* Pinned: the section is as tall as its scroll distance (set by the script);
     the stage sticks for that distance and the track slides. */
  .an-ms.is-pinned {
    padding-bottom: 0;
  }

  .an-ms.is-pinned .an-ms__stage {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100svh;
    overflow: clip;
    padding-top: calc(var(--header-h) + 0.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .an-ms.is-pinned .an-ms__viewport {
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 0;
    /* Clip to the content box, so only the current year shows, never the next one peeking in the gutter. */
    clip-path: inset(0 var(--gutter));
  }

  .an-ms.is-pinned .an-ms__track {
    display: flex;
    width: 100%;
    margin: 0;
    gap: 0;
    will-change: transform;
  }

  .an-ms.is-pinned .an-ms__panel {
    flex: 0 0 100%;
    display: grid;
    align-items: end;
    gap: 1.5rem var(--gutter);
    padding: 0;
  }

  .an-ms.is-pinned .an-ms__panel::before,
  .an-ms.is-pinned .an-ms__node {
    display: none;
  }

  .an-ms.is-pinned .an-ms__year {
    font-size: clamp(6rem, 2.5rem + 17vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .an-ms.is-pinned .an-ms__panel.is-last .an-ms__year {
    color: var(--accent);
  }

  .an-ms.is-pinned .an-ms__text {
    max-width: 34ch;
    font-size: var(--fs-h4);
    line-height: 1.35;
    letter-spacing: var(--track-title);
    color: var(--ink);
    /* Fades in as its year settles (set by the script). */
    opacity: var(--t, 1);
  }

  @media (min-width: 64rem) {
    .an-ms.is-pinned .an-ms__panel {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .an-ms.is-pinned .an-ms__text {
      padding-bottom: 0.75rem;
    }
  }

  /* Rail: every year on one line, progress filled up to the current one; the
     last segment and node are orange. */
  .an-ms.is-pinned .an-ms__rail {
    display: block;
    position: relative;
    padding-top: 1.25rem;
  }

  .an-ms__line {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(1.25rem + var(--node) / 2);
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--line-strong) calc((var(--n) - 2) / (var(--n) - 1) * 100%),
      rgb(255 55 0 / 0.3) 0
    );
  }

  .an-ms__fill {
    position: absolute;
    left: 0;
    top: -0.5px;
    height: 2px;
    width: calc((var(--n) - 2) / (var(--n) - 1) * 100%);
    background: var(--ink);
    transform-origin: left center;
    transform: scaleX(var(--fa, 0));
  }

  .an-ms__fill--last {
    left: calc((var(--n) - 2) / (var(--n) - 1) * 100%);
    width: calc(100% / (var(--n) - 1));
    background: var(--accent);
    transform: scaleX(var(--fb, 0));
  }

  .an-ms__ticks {
    position: relative;
    height: 2.75rem;
  }

  .an-ms__tick {
    position: absolute;
    left: calc(var(--i) / (var(--n) - 1) * 100%);
    top: 0;
    display: grid;
    justify-items: start;
    gap: 0.625rem;
  }

  .an-ms__tick:last-child {
    justify-items: end;
    transform: translateX(-100%);
  }

  .an-ms__tick:last-child .an-ms__tick-node {
    margin-left: auto;
  }

  .an-ms__tick-node {
    width: var(--node);
    height: var(--node);
    background: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .an-ms__tick-year {
    font-size: var(--fs-small);
