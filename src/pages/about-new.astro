  }

  .an-card__text {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .an-dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    transform: translateY(-0.05em);
  }

  /* ---------- Team ---------- */
  .an-team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  @media (min-width: 48rem) {
    .an-team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .an-team {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .an-person {
    display: grid;
    align-content: start;
  }

  .an-person__photo {
    overflow: hidden;
    aspect-ratio: 1;
    margin-bottom: 1rem;
    background: #e4e4e4;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  /* Portraits are cut out on white: multiply takes the white to the frame grey. Always in colour. */
  .an-person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .an-person__index {
    color: var(--muted);
  }

  .an-person__name {
    margin-top: 0.25rem;
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .an-person__role {
    margin-top: 0.25rem;
    color: var(--ink-2);
  }

  .an-person__org {
    color: var(--muted);
  }

  /* ---------- Woza ---------- */
  .an-woza {
    display: grid;
    gap: 2rem var(--gutter);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background: var(--card);
  }

  @media (min-width: 64rem) {
    .an-woza {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .an-woza__brand {
    display: grid;
    align-content: space-between;
    gap: 2rem;
  }

  .an-woza__mark {
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: var(--track-heading);
  }

  .an-woza__body {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .an-woza__text {
    color: var(--ink-2);
  }

  /* ---------- Where ---------- */
  .an-where {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    align-content: start;
  }

  .an-where__contact {
    display: grid;
    gap: 0.375rem;
    font-style: normal;
  }

  .an-where__contact .an-lead {
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .an-where a {
    width: fit-content;
    transition: color 160ms ease;
  }

  .an-where__join {
    color: var(--ink-2);
  }

  .an-where__join a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--line-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .an-where a:hover {
      color: var(--accent);
    }
  }

  /* Schematic map: grey dot field, orange square on the office. */
  .an-map {
    --px: 34%;
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin-top: 1rem;
    background-color: #e4e4e4;
    background-image: radial-gradient(circle, rgb(30 30 30 / 0.22) 1px, transparent 1.5px);
    background-size: 14px 14px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  .an-map::after {
    /* Soften the field towards the edges. */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at var(--px) 46%, transparent 30%, #e4e4e4 85%);
  }

  @media (min-width: 48rem) {
    .an-map {
      --px: 52%;
      aspect-ratio: 21 / 9;
    }
  }

  .an-map__pin {
    position: absolute;
    z-index: 1;
    left: var(--px);
    top: 46%;
    width: 0.875rem;
    height: 0.875rem;
    background: var(--accent);
    box-shadow: 0 0 0 0.5rem rgb(255 55 0 / 0.14);
    transform: translate(-50%, -50%);
  }

  .an-map__tag {
    position: absolute;
    z-index: 1;
    left: calc(var(--px) + 1.25rem);
    top: 46%;
    display: grid;
    padding: 0.5rem 0.75rem;
    background: var(--surface);
    transform: translateY(-50%);
  }
</style>

<script>
  import { mountThemeScrub } from '../scripts/theme-scrub';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);

  /** Calls `fn` on scroll (one rAF per frame) only while `el` is near the viewport. */
  function whileNear(el: Element, fn: () => void, margin = '25% 0px') {
    let raf = 0;
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(() => ((raf = 0), fn()));
    };
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          window.addEventListener('scroll', onScroll, { passive: true });
          fn();
        } else window.removeEventListener('scroll', onScroll);
      },
      { rootMargin: margin },
    ).observe(el);
    window.addEventListener('resize', onScroll, { passive: true });
  }

  // Dark Trust section: light → dark → light, like the homepage.
  mountThemeScrub();

  // Independent sticks when its bottom meets the bottom of the viewport, so
  // Trust slides over it instead of pushing it away.
  const pinned = document.querySelector<HTMLElement>('[data-pinned]');
  if (pinned) {
    const setTop = () => pinned.style.setProperty('--pin-top', `${Math.min(0, window.innerHeight - pinned.offsetHeight)}px`);
    setTop();
    new ResizeObserver(setTop).observe(pinned);
    window.addEventListener('resize', setTop, { passive: true });
  }

  if (!reduce) {
    // Hero photo: slow drift inside its frame.
    const fig = document.querySelector<HTMLElement>('.an-hero-media');
    const img = fig?.querySelector<HTMLElement>('[data-parallax]');
    if (fig && img) {
      fig.classList.add('is-parallax');
      whileNear(fig, () => {
        const r = fig.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = clamp01((vh - r.top) / (vh + r.height));
        img.style.setProperty('--py', `${(-p * 0.14 * r.height).toFixed(1)}px`);
      });
    }

    // Mission statement: lit word by word as it scrolls in (homepage claim pattern).
    const lit = document.querySelector<HTMLElement>('[data-lit]');
    if (lit) {
      const words = Array.from(lit.querySelectorAll<HTMLElement>('.w'));
      lit.parentElement?.classList.add('lit-on');
      whileNear(lit, () => {
        const vh = window.innerHeight;
        const top = lit.getBoundingClientRect().top;
        const p = clamp01((vh * 0.92 - top) / (vh * 0.92 - vh * 0.45));
        const on = p * words.length;
        words.forEach((w, i) => w.style.setProperty('--o', Math.min(1, Math.max(0.16, on - i + 0.16)).toFixed(3)));
      });
    }

    // Milestones: the stage pins and the years run sideways, one per screen.
    const ms = document.querySelector<HTMLElement>('[data-ms]');
    const track = ms?.querySelector<HTMLElement>('[data-ms-track]');
    const viewport = ms?.querySelector<HTMLElement>('[data-ms-viewport]');
    if (ms && track && viewport) {
      const panels = Array.from(track.querySelectorAll<HTMLElement>('[data-ms-panel]'));
      const ticks = Array.from(ms.querySelectorAll<HTMLElement>('[data-ms-tick]'));
      const fillA = ms.querySelector<HTMLElement>('[data-ms-fill]');
      const fillB = ms.querySelector<HTMLElement>('[data-ms-fill-last]');
      const n = panels.length;
      // Each year rests for the first part of its scroll segment, then slides on.
      const DWELL = 0.3;
      const SEGMENTS = n - 1 + 0.6; // extra rest on the last year before the page moves on
      let seg = 0;

      ms.classList.add('is-pinned');

      const size = () => {
        seg = window.innerHeight * 0.85;
        ms.style.height = `${window.innerHeight + SEGMENTS * seg}px`;
      };

      const update = () => {
        const travel = ms.offsetHeight - window.innerHeight;
        const p = clamp01(-ms.getBoundingClientRect().top / Math.max(1, travel));
        const raw = p * SEGMENTS;
        const k = Math.min(n - 1, Math.floor(raw));
        const pos = k >= n - 1 ? n - 1 : k + smooth(clamp01((raw - k - DWELL) / (1 - DWELL)));
        const w = panels[0].offsetWidth; // content width (the viewport's clientWidth includes its padding)
        track.style.transform = `translate3d(${(-pos * w).toFixed(1)}px, 0, 0)`;
        panels.forEach((el, i) => el.style.setProperty('--t', clamp01(1 - Math.abs(pos - i) * 2.2).toFixed(3)));
        fillA?.style.setProperty('--fa', clamp01(pos / Math.max(1, n - 2)).toFixed(4));
        fillB?.style.setProperty('--fb', clamp01(pos - (n - 2)).toFixed(4));
        const current = Math.round(pos);
        ticks.forEach((t, i) => t.classList.toggle('is-on', i <= current));
      };

      size();
      update();
      window.addEventListener('resize', () => (size(), update()), { passive: true });
      whileNear(ms, update, '10% 0px');
    }
  }
</script>
