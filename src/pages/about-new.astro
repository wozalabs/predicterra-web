  }

  /* Monochrome logos, as in the homepage strip. */
  .an-card__brand img {
    width: auto;
    height: var(--h);
    max-width: 100%;
    filter: brightness(0) invert(var(--dt, 0));
    opacity: 0.7;
  }

  .an-card__wordmark {
