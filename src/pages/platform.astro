---
/**
 * Platform (/platform), from "predicterra-02-platform.md".
 * hero (video) · what a Cognitive Twin is · how it's built · what goes in and
 * what comes out · validation · trust (dark) · CTA.
 * "Read the methodology" stays hidden until the PDF exists.
 */
import PageLayout from '../layouts/PageLayout.astro';
import VideoHero from '../sections/pages/VideoHero.astro';
import Compare from '../sections/pages/Compare.astro';
import Rows from '../sections/pages/Rows.astro';
import Stats from '../sections/pages/Stats.astro';
import Cards from '../sections/pages/Cards.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import CodePanel from '../components/CodePanel.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy } from '../i18n/config';
import { softwareJsonLd } from '../data/seo';

const locale = 'en';
const { platform: c } = getCopy(locale);
const site = Astro.site ?? new URL('https://www.predicterra.com');
const pad = (n: number) => String(n).padStart(3, '0');
---

<PageLayout
  title={c.seo.title}
  description={c.seo.description}
  locale={locale}
  jsonLd={[softwareJsonLd(site, c.seo.description)]}
>
  <VideoHero locale={locale} {...c.hero} logos={[...c.logos]} />

  <Compare
    id="twin-title"
    title={c.twin.title}
    text={c.twin.text}
    columns={c.twin.columns}
    rows={c.twin.rows}
    variant="steps"
    head="center"
  />

  <Rows
    id="arch-title"
    title={c.architecture.title}
    items={c.architecture.layers.map((l) => ({ title: l.title, text: l.text }))}
    marker="num"
    head="side"
  />
  <Stats locale={locale} items={[...c.architecture.figures]} label="The platform in figures" />

  <!-- What goes in and what comes out: two quiet lists, the risk event beside them. -->
  <section class="pf-io pg-sec" aria-labelledby="io-title">
    <div class="container pg-body">
      <SectionHead id="io-title" title={c.io.title} align="stack" wide />
      <div class="pf-io__grid">
        <div class="pf-io__lists">
          {
            [
              { label: c.io.readsLabel, items: c.io.reads, out: false },
              { label: c.io.returnsLabel, items: c.io.returns, out: true },
            ].map((list) => (
              <div class="pf-io__list">
                <p class:list={['pf-io__label t-small', list.out && 'is-out']}>{list.label}</p>
                <ul data-reveal-group>
                  {list.items.map((it, i) => (
                    <li class="pf-io__item" data-reveal>
                      <span class="pg-idx">{pad(i + 1)}</span>
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="pf-io__code" data-reveal>
          <CodePanel label={c.io.code.label} json={c.io.code.json} />
        </div>
      </div>
      <p class="pf-io__note" data-reveal>
        <span class="pg-dot" aria-hidden="true"></span>
        {c.io.integrations}
      </p>
    </div>
  </section>

  <Cards id="validation-title" title={c.validation.title} items={c.validation.items} head="center" />

  <Rows id="trust-title" title={c.trust.title} items={c.trust.items} head="stack" dark>
    <ul class="pf-seals" aria-label="Certifications and availability" data-reveal>
      {c.trust.seals.map((s) => <li class="chip pf-seal">{s}</li>)}
    </ul>
  </Rows>

  <Cta locale={locale} copy={c.cta} />
</PageLayout>

<style>
  .pf-io__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem clamp(3rem, 1rem + 5vw, 7rem);
  }

  @media (min-width: 64rem) {
    .pf-io__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  .pf-io__lists {
    display: grid;
    gap: 3rem var(--gutter);
  }

  @media (min-width: 40rem) {
    .pf-io__lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pf-io__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .pf-io__label.is-out {
    color: var(--ink);
  }

  .pf-io__label.is-out::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .pf-io__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1.125rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .pf-io__item .pg-idx {
    padding-top: 0.2rem;
  }

  @media (min-width: 64rem) {
    .pf-io__code {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
  }

  .pf-io__note {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    max-width: 52ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .pf-seals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pf-seal {
    min-height: 2.25rem;
    font-size: var(--fs-small);
  }
</style>
