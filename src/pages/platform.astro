<script>
  // Ontology graph: hovering or focusing a node lights its link to the asset.
  const graph = document.querySelector<HTMLElement>('.pf-graph');
  if (graph) {
    const edges = Array.from(graph.querySelectorAll<SVGLineElement>('[data-edge]'));
    const nodes = Array.from(graph.querySelectorAll<HTMLElement>('[data-node]'));
    const set = (k: number) => {
      edges.forEach((e, i) => e.classList.toggle('is-on', i === k));
      nodes.forEach((n, i) => n.classList.toggle('is-on', i === k));
    };
    nodes.forEach((n, i) => {
      n.addEventListener('pointerenter', () => set(i));
      n.addEventListener('focus', () => set(i));
      n.addEventListener('click', () => set(i));
    });
    graph.addEventListener('pointerleave', () => set(nodes.length - 1));
    set(nodes.length - 1);
  }
</script>
