---
/**
 * Platform (/platform), from "predicterra-02-platform.md".
 * hero · what it is · how it's built · the ontology in action · every
 * team, every horizon · already built · in and out · validation and trust
 * (dark) · CTA. "Read the methodology" stays hidden until the PDF exists.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../sections/pages/PageHero.astro';
import TwinMeter from '../sections/pages/TwinMeter.astro';
import Rows from '../sections/pages/Rows.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import Stats from '../sections/pages/Stats.astro';
import CodePanel from '../components/CodePanel.astro';
import AssetCard from '../components/AssetCard.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy } from '../i18n/config';
import { softwareJsonLd } from '../data/seo';

const locale = 'en';
const { platform: c } = getCopy(locale);
const site = Astro.site ?? new URL('https://www.predicterra.com');
const pad = (n: number) => String(n).padStart(3, '0');
---

<PageLayout
  title={c.seo.title}
  description={c.seo.description}
  locale={locale}
  jsonLd={[softwareJsonLd(site, c.seo.description)]}
>
  <!-- The title on the left, the description and the action on the right. -->
  <PageHero locale={locale} {...c.hero} />

  <!-- Three kinds of twin on one scale: the first two stop part way. -->
  <TwinMeter
    id="twin-title"
    title={c.twin.title}
    text={c.twin.text}
    columns={c.twin.columns}
    rows={c.twin.rows}
    levels={c.twin.levels}
    scale={c.twin.scale}
    closing={c.twin.closing}
  />

  <Rows id="arch-title" title={c.architecture.title} text={c.architecture.text} items={c.architecture.layers} marker="num">
    <p class="pf-note" data-reveal>
      <span class="pg-dot" aria-hidden="true"></span>
      {c.architecture.closing}
    </p>
  </Rows>

  <!-- The ontology in action: the story on one side, the object and its relationships on the other. -->
  <section class="pf-ont pg-sec" aria-labelledby="ont-title">
    <div class="container pf-ont__grid">
      <SectionHead id="ont-title" title={c.ontology.title} text={c.ontology.text} align="stack" class="pf-ont__head" />
      <!-- The same asset as every team sees it: the 3D section's asset panel. -->
      <AssetCard sector="solar" locale={locale} class="pf-ont__card" data-reveal />
    </div>
  </section>

  <!-- Every team, every horizon: one row per team. -->
  <section class="pf-hz pg-sec" aria-labelledby="hz-title">
    <div class="container pg-body">
      <SectionHead id="hz-title" title={c.horizons.title} text={c.horizons.text} align="side" />
      <div class="pf-hz__table" role="table" aria-label={c.horizons.title}>
        <div class="pf-hz__row pf-hz__row--head" role="row">
          <span role="columnheader"></span>
          <span role="columnheader">{c.horizons.labels.question}</span>
          <span role="columnheader">{c.horizons.labels.gets}</span>
        </div>
        {
          c.horizons.teams.map((t, i) => (
            <div class="pf-hz__row" role="row" data-reveal>
              <div class="pf-hz__team" role="cell">
                <span class="pg-idx">{pad(i + 1)}</span>
                <span class="pf-hz__name">{t.team}</span>
                <span class="pf-hz__horizon t-small">{t.horizon}</span>
              </div>
              <p class="pf-hz__q" role="cell">
                {t.question}
              </p>
              <p class="pf-hz__gets" role="cell">
                {t.gets}
              </p>
            </div>
          ))
        }
      </div>
      <p class="pf-note" data-reveal>
        <span class="pg-dot" aria-hidden="true"></span>
        {c.horizons.closing}
      </p>
    </div>
  </section>

  <!-- Already built: the three figures as rows, each with what it means. -->
  <Stats
    id="built-title"
    title={c.built.title}
    text={c.built.text}
    items={c.built.items.map((it) => ({ value: it.value, text: it.title, note: it.text }))}
  />

  <!-- In and out, then validation and trust entering over it as a panel (scripts/panels.ts). -->
  <div class="pnl">
  <section class="pf-io pg-sec" aria-labelledby="io-title">
    <div class="container pg-body">
      <SectionHead id="io-title" title={c.io.title} text={c.io.text} align="side" />
      <!-- A flow: what goes in runs into the twin, what comes out leaves it.
           Pulses travel along the connectors (none with reduced motion). -->
      <div class="pf-flow" data-reveal>
        <div class="pf-flow__side">
          <p class="pf-flow__label t-small">{c.io.inLabel}</p>
          <ul class="pf-flow__list">
            {c.io.in.map((it, i) => (
              <li class="pf-flow__item pf-flow__item--in" style={`--i:${i}`}>
                <span class="pg-idx">{pad(i + 1)}</span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pf-flow__core">
          <p class="pf-flow__brand">Predicterra</p>
          <p class="pf-flow__kind t-small">{c.twin.columns[c.twin.columns.length - 1]}</p>
          <ul class="pf-flow__layers">
            {c.architecture.layers.map((l) => <li>{l.title}</li>)}
          </ul>
        </div>

        <div class="pf-flow__side">
          <p class="pf-flow__label pf-flow__label--out t-small">{c.io.outLabel}</p>
          <ul class="pf-flow__list">
            {c.io.out.map((it, i) => (
              <li class="pf-flow__item pf-flow__item--out" style={`--i:${i}`}>
                <span class="pg-idx">{pad(i + 1)}</span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Every output is a structured object: the note and an example of one. -->
      <div class="pf-io__grid">
        <p class="pf-io__note" data-reveal>{c.io.note}</p>
        <div class="pf-io__code" data-reveal>
          <CodePanel label={c.io.code.label} json={c.io.code.json} />
        </div>
      </div>
    </div>
  </section>

  <Rows id="trust-title" title={c.trust.title} items={c.trust.items} dark>
    <div class="pf-trust" data-reveal>
      <p class="pf-trust__text">{c.trust.statement}</p>
      <ul class="pf-seals" aria-label="Certifications and availability">
        {c.trust.seals.map((s) => <li class="chip pf-seal">{s}</li>)}
      </ul>
    </div>
  </Rows>
  </div>

  <Cta locale={locale} copy={c.cta} />
</PageLayout>

<style>
  /* A closing line under a section, with the orange dot. */
  .pf-note {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    max-width: 60ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  /* ---------- The ontology in action ---------- */
  /* The story on the left, the asset as every team sees it on the right. */
  .pf-ont__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 56rem) {
    .pf-ont__grid {
      grid-template-columns: minmax(0, 1fr) 22.5rem;
      align-items: center;
    }
  }

  .pf-ont__grid :global(.pf-ont__card) {
    justify-self: center;
  }

  /* ---------- Every team, every horizon ---------- */
  .pf-hz__table {
    display: grid;
  }

  .pf-hz__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem var(--gutter);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 56rem) {
    .pf-hz__row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 4fr);
      align-items: baseline;
    }
  }

  .pf-hz__row--head {
    padding-block: 0 0.75rem;
    border-top: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 55.99rem) {
    .pf-hz__row--head {
      display: none;
    }
  }

  .pf-hz__team {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.25rem 0.5rem;
    align-items: baseline;
  }

  .pf-hz__name {
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .pf-hz__horizon {
    grid-column: 2;
    color: var(--muted);
  }

  .pf-hz__q {
    font-size: var(--fs-lead);
    line-height: 1.4;
    letter-spacing: var(--track-title);
  }

  .pf-hz__gets {
    color: var(--ink-2);
  }

  /* ---------- In and out: a flow through the twin ----------
     Inputs on the left, the twin in the middle (the fire block), outputs on
     the right. Each item is joined to the block by a hairline that a small
     pulse runs along: into the twin on the left, out of it on the right. */
  .pf-flow {
    --link: clamp(2rem, 1rem + 3vw, 4.5rem);
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .pf-flow {
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 16rem) minmax(0, 1fr);
      gap: 0 var(--link);
      align-items: stretch;
    }
  }

  .pf-flow__side {
    display: grid;
    align-content: center;
  }

  .pf-flow__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--muted);
  }

  .pf-flow__label--out {
    color: var(--ink);
  }

  .pf-flow__label--out::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .pf-flow__list {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .pf-flow__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    min-height: 4rem;
    align-content: center;
    padding: 0.875rem 1rem;
    background: var(--card);
    color: var(--ink-2);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .pf-flow__item--out {
    color: var(--ink);
  }

  /* The connector, and its pulse (wide screens, where the block sits beside). */
  @media (min-width: 64rem) {
    .pf-flow__item::before,
    .pf-flow__item::after {
      content: '';
      position: absolute;
      top: 50%;
      width: var(--link);
      pointer-events: none;
    }
    .pf-flow__item::before {
      height: 1px;
      background: var(--line-strong);
    }
    .pf-flow__item::after {
      height: 3px;
      margin-top: -1px;
      background: linear-gradient(90deg, rgb(255 55 0 / 0), var(--accent) 70%, #ff8a2a);
      background-size: 40% 100%;
      background-repeat: no-repeat;
      background-position: -100% 0;
    }
    .pf-flow__item--in::before,
    .pf-flow__item--in::after {
      left: 100%;
    }
    .pf-flow__item--out::before,
    .pf-flow__item--out::after {
      right: 100%;
    }
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .pf-flow__item::after {
      animation: pf-pulse 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      animation-delay: calc(var(--i) * 0.37s);
    }
    .pf-flow__item--out::after {
      animation-delay: calc(1.2s + var(--i) * 0.37s);
    }
  }

  @keyframes pf-pulse {
    0% {
      background-position: -100% 0;
    }
    55%,
    100% {
      background-position: 200% 0;
    }
  }

  /* The twin: the fire block, the brand at the top, the four layers below. */
  .pf-flow__core {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 2rem;
    min-height: 16rem;
    padding: 1.5rem;
    background: var(--accent);
    background: var(--grad-panel);
    background-size: var(--grad-panel-size);
    animation: var(--fire-panel-motion);
    box-shadow: var(--fire-edge-panel);
    color: #fff;
  }

  .pf-flow__core::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grain);
    opacity: 0.18;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .pf-flow__brand {
    font-size: var(--fs-h3);
    line-height: 1;
    letter-spacing: var(--track-heading);
  }

  .pf-flow__kind {
    margin-top: -1.5rem;
    color: rgb(255 255 255 / 0.8);
  }

  .pf-flow__layers {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .pf-flow__layers li {
    padding-block: 0.625rem;
    border-top: 1px solid rgb(255 255 255 / 0.28);
    font-size: var(--fs-small);
  }

  /* The note and one output as it leaves the twin. */
  .pf-io__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem clamp(3rem, 1rem + 5vw, 7rem);
  }

  @media (min-width: 64rem) {
    .pf-io__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
    }
  }

  .pf-io__note {
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  /* ---------- Trust ---------- */
  .pf-trust {
    display: grid;
    gap: 1.5rem;
    max-width: 62ch;
  }

  .pf-trust__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .pf-seals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pf-seal {
    min-height: 2.25rem;
    font-size: var(--fs-small);
  }
</style>
