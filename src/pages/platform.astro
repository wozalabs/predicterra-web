---
/**
 * Platform (/platform), from "predicterra-02-platform.md".
 * hero · what it is · how it's built · the ontology in action · every
 * team, every horizon · already built · in and out · validation and trust
 * (dark) · CTA. "Read the methodology" stays hidden until the PDF exists.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../sections/pages/PageHero.astro';
import TwinNest from '../sections/pages/TwinNest.astro';
import Rows from '../sections/pages/Rows.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import Stats from '../sections/pages/Stats.astro';
import DataFlow from '../sections/pages/DataFlow.astro';
import AssetCard from '../components/AssetCard.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy } from '../i18n/config';
import { softwareJsonLd } from '../data/seo';

const locale = 'en';
const { platform: c } = getCopy(locale);
const site = Astro.site ?? new URL('https://www.predicterra.com');
const pad = (n: number) => String(n).padStart(3, '0');
---

<PageLayout
  title={c.seo.title}
  description={c.seo.description}
  locale={locale}
  jsonLd={[softwareJsonLd(site, c.seo.description)]}
>
  <!-- The title on the left, the description and the action on the right. -->
  <PageHero locale={locale} {...c.hero} />

  <!-- Three kinds of twin on one scale: the first two stop part way. -->
  <!-- Three kinds of twin, each nested in the one that can do more. -->
  <TwinNest
    id="twin-title"
    title={c.twin.title}
    text={c.twin.text}
    columns={c.twin.columns}
    rows={c.twin.rows}
    tags={c.twin.tags}
    axisY={c.twin.axisY}
    axisX={c.twin.axisX}
    closing={c.twin.closing}
  />

  <Rows id="arch-title" title={c.architecture.title} text={c.architecture.text} items={c.architecture.layers} marker="num">
    <p class="pf-note" data-reveal>
      <span class="pg-dot" aria-hidden="true"></span>
      {c.architecture.closing}
    </p>
  </Rows>

  <!-- The ontology in action: the story on one side, the object and its relationships on the other. -->
  <section class="pf-ont pg-sec" aria-labelledby="ont-title">
    <div class="container pf-ont__grid">
      <SectionHead id="ont-title" title={c.ontology.title} text={c.ontology.text} align="stack" class="pf-ont__head" />
      <!-- The same asset as every team sees it: the 3D section's asset panel. -->
      <AssetCard sector="solar" locale={locale} class="pf-ont__card" data-reveal />
    </div>
  </section>

  <!-- Every team, every horizon: one row per team. -->
  <section class="pf-hz pg-sec" aria-labelledby="hz-title">
    <div class="container pg-body">
      <SectionHead id="hz-title" title={c.horizons.title} text={c.horizons.text} align="side" />
      <div class="pf-hz__table" role="table" aria-label={c.horizons.title}>
        <div class="pf-hz__row pf-hz__row--head" role="row">
          <span role="columnheader"></span>
          <span role="columnheader">{c.horizons.labels.question}</span>
          <span role="columnheader">{c.horizons.labels.gets}</span>
        </div>
        {
          c.horizons.teams.map((t, i) => (
            <div class="pf-hz__row" role="row" data-reveal>
              <div class="pf-hz__team" role="cell">
                <span class="pg-idx">{pad(i + 1)}</span>
                <span class="pf-hz__name">{t.team}</span>
                <span class="pf-hz__horizon t-small">{t.horizon}</span>
              </div>
              <p class="pf-hz__q" role="cell">
                {t.question}
              </p>
              <p class="pf-hz__gets" role="cell">
                {t.gets}
              </p>
            </div>
          ))
        }
      </div>
      <p class="pf-note" data-reveal>
        <span class="pg-dot" aria-hidden="true"></span>
        {c.horizons.closing}
      </p>
    </div>
  </section>

  <!-- Already built: the three figures as rows, each with what it means. -->
  <Stats
    id="built-title"
    title={c.built.title}
    text={c.built.text}
    items={c.built.items.map((it) => ({ value: it.value, text: it.title, note: it.text }))}
  />

  <!-- In and out: the home's pinned 3D scroll, Predicterra as the chip in the middle. -->
  <DataFlow locale={locale} />

  <!-- Validation and trust slides over the pinned board, notched top edge first. -->
  <div class="pf-cover">
  <Rows id="trust-title" title={c.trust.title} items={c.trust.items} dark>
    <div class="pf-trust" data-reveal>
      <p class="pf-trust__text">{c.trust.statement}</p>
      <ul class="pf-seals" aria-label="Certifications and availability">
        {c.trust.seals.map((s) => <li class="chip pf-seal">{s}</li>)}
      </ul>
    </div>
  </Rows>
  </div>

  <Cta locale={locale} copy={c.cta} />
</PageLayout>

<style>
  /* A closing line under a section, with the orange dot. */
  .pf-note {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    max-width: 60ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  /* ---------- The ontology in action ---------- */
  /* The story on the left, the asset as every team sees it on the right. */
  .pf-ont__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 56rem) {
    .pf-ont__grid {
      grid-template-columns: minmax(0, 1fr) 22.5rem;
      align-items: center;
    }
  }

  .pf-ont__grid :global(.pf-ont__card) {
    justify-self: center;
  }

  /* ---------- Every team, every horizon ---------- */
  .pf-hz__table {
    display: grid;
  }

  .pf-hz__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem var(--gutter);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 56rem) {
    .pf-hz__row {
      grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 4fr);
      align-items: baseline;
    }
  }

  .pf-hz__row--head {
    padding-block: 0 0.75rem;
    border-top: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 55.99rem) {
    .pf-hz__row--head {
      display: none;
    }
  }

  .pf-hz__team {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.25rem 0.5rem;
    align-items: baseline;
  }

  .pf-hz__name {
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .pf-hz__horizon {
    grid-column: 2;
    color: var(--muted);
  }

  .pf-hz__q {
    font-size: var(--fs-lead);
    line-height: 1.4;
    letter-spacing: var(--track-title);
  }

  .pf-hz__gets {
    color: var(--ink-2);
  }

  /* ---------- Trust: slides over the pinned data flow ---------- */
  .pf-cover {
    position: relative;
    z-index: var(--z-cover);
    margin-top: -100svh;
    clip-path: var(--notch-top);
    background: var(--canvas);
  }

  .pf-cover > :global(section) {
    min-height: 100svh;
  }

  /* ---------- Trust ---------- */
  .pf-trust {
    display: grid;
    gap: 1.5rem;
    max-width: 62ch;
  }

  .pf-trust__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  .pf-seals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pf-seal {
    min-height: 2.25rem;
    font-size: var(--fs-small);
  }
</style>
