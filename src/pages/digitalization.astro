---
/**
 * Digitalization (/digitalization), from "predicterra-09-digitalization.md".
 * For those who decide the architecture (CIO, CDO, data teams).
 * hero · metrics · not a data lake · integrate once (48 → 14, in type) ·
 * architecture fit (dark, with the risk event) · CTA.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../sections/pages/PageHero.astro';
import Stats from '../sections/pages/Stats.astro';
import Compare from '../sections/pages/Compare.astro';
import Rows from '../sections/pages/Rows.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import CodePanel from '../components/CodePanel.astro';
import Icon from '../components/Icon.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy } from '../i18n/config';

const locale = 'en';
const { digitalization: c } = getCopy(locale);
---

<PageLayout title={c.seo.title} description={c.seo.description} locale={locale}>
  <PageHero locale={locale} {...c.hero} layout="centred" />
  <Stats locale={locale} items={[...c.metrics]} />

  <Compare
    id="difference-title"
    title={c.difference.title}
    columns={c.difference.columns}
    rows={c.difference.rows}
    closing={c.difference.closing}
    head="center"
  />

  <!-- Integrate once: the two numbers say it, set large. -->
  <section class="ig pg-sec" aria-labelledby="integrate-title">
    <div class="container ig__grid">
      <SectionHead id="integrate-title" title={c.integrate.title} text={c.integrate.text} align="stack" />
      <div class="ig__nums" data-reveal>
        <div class="ig__num">
          <span class="ig__value t-num">{c.integrate.before.value}</span>
          <span class="ig__label">{c.integrate.before.text}</span>
        </div>
        <span class="ig__arrow" aria-hidden="true"><Icon name="arrow_forward" /></span>
        <div class="ig__num">
          <span class="ig__value ig__value--hi t-num">{c.integrate.after.value}</span>
          <span class="ig__label">{c.integrate.after.text}</span>
        </div>
      </div>
    </div>
  </section>

  <Rows id="fit-title" title={c.fit.title} items={c.fit.items} marker="num" dark>
    <CodePanel slot="side" label={c.fit.code.label} json={c.fit.code.json} />
  </Rows>

  <Cta locale={locale} copy={c.cta} />
</PageLayout>

<style>
  .ig__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .ig__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
    }
  }

  .ig__nums {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .ig__num {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .ig__value {
    font-size: clamp(4rem, 2.5rem + 6vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--muted-large);
  }

  .ig__value--hi {
    color: var(--accent);
  }

  .ig__label {
    max-width: 18ch;
    color: var(--ink-2);
  }

  .ig__arrow {
    padding-bottom: 3.25rem;
    color: var(--muted);
  }

  .ig__arrow :global(.icon) {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>
