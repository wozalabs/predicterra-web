---
/**
 * New home content (/home-new), from "predicterra-01-home.md", for comparison
 * with the current home (/). Same building blocks: the video hero, the 3D scene
 * (with the brief's incidents), a dark section sliding over it, then the light.
 * Not indexed while it is a draft.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../sections/pages/VideoHero.astro';
import SectorTrail from '../sections/home/SectorTrail.astro';
import Intro from '../sections/home-new/Intro.astro';
import Teams from '../sections/home-new/Teams.astro';
import Figures from '../sections/home-new/Figures.astro';
import Proof from '../sections/home-new/Proof.astro';
import Cta from '../sections/home/Cta.astro';
import PageCompare from '../components/PageCompare.astro';
import '../styles/pages.css';
import { getCopy } from '../i18n/config';

const locale = 'en';
const { homeNew: h } = getCopy(locale);
---

<BaseLayout title={h.seo.title} description={h.seo.description} locale={locale} noindex>
  <VideoHero locale={locale} {...h.hero} logos={[...h.logos]} />
  <Intro locale={locale} />
  <SectorTrail locale={locale} scene={h.scene} />
  <Teams locale={locale} />
  <Figures locale={locale} />
  <Proof locale={locale} />
  <Cta locale={locale} copy={h.cta} />
  <PageCompare locale={locale} current="next" />
</BaseLayout>
