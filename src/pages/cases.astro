---
/**
 * Cases (/cases), from "predicterra-16-cases.md".
 * hero · the cases (i-DE, UFD, Moeve), each with the link to its published
 * article · recognition · CTA. Moeve's figure waits for Moeve's validation.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../sections/pages/PageHero.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import Button from '../components/Button.astro';
import FigureValue from '../components/FigureValue.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy, withBase } from '../i18n/config';

const locale = 'en';
const { casesPage: c } = getCopy(locale);
const pad = (n: number) => String(n).padStart(3, '0');
---

<PageLayout title={c.seo.title} description={c.seo.description} locale={locale}>
  <PageHero locale={locale} {...c.hero} layout="centred" />

  <section class="cs pg-sec" aria-label="Cases">
    <div class="container">
      <ol class="cs__list">
        {
          c.cases.map((k, i) => (
            <li class="cs__case" aria-labelledby={`${k.id}-title`} data-reveal-group>
              <div class="cs__brand" data-reveal>
                <span class="pg-idx">{pad(i + 1)}</span>
                <img
                  src={withBase(k.logo.src)}
                  alt=""
                  width={Math.round((k.logo.w / k.logo.h0) * k.logo.h)}
                  height={k.logo.h}
                  style={`--h:${k.logo.h}px`}
                  loading="lazy"
                  decoding="async"
                />
                <h2 id={`${k.id}-title`} class="cs__client">
                  {k.client}
                </h2>
              </div>
              <div class="cs__main" data-reveal>
                {k.value ? (
                  <p class="cs__figure">
                    <FigureValue class="cs__value t-num" value={k.value} />
                    <span class="cs__label">{k.label}</span>
                  </p>
                ) : null}
                <p class:list={['cs__text', !k.value && 'cs__text--lead']}>{k.text}</p>
              </div>
              <div class="cs__meta" data-reveal>
                <p class="cs__badge t-small">
                  <span aria-hidden="true" />
                  {k.badge}
                </p>
                <Button href={k.link.href} label={k.link.label} variant="secondary" external />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="rc pg-sec" aria-labelledby="recognition-title">
    <div class="container pg-body">
      <SectionHead id="recognition-title" title={c.recognition.title} align="center" />
      <ul class="rc__list" data-reveal-group>
        {
          c.recognition.items.map((r) => (
            <li class="rc__item" data-reveal>
              <span class="rc__name">{r.name}</span>
              {r.text && <span class="rc__text">{r.text}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta locale={locale} copy={c.cta} />
</PageLayout>

<style>
  /* ---------- Cases: one wide row each, on hairlines ---------- */
  .cs__list {
    display: grid;
  }

  .cs__case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem var(--gutter);
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .cs__case:last-child {
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .cs__case {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      align-items: start;
    }
  }

  .cs__brand {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .cs__brand img {
    width: auto;
    height: var(--h);
    margin-top: 0.75rem;
    filter: brightness(0) invert(var(--logo-inv, 0));
    opacity: 0.75;
  }

  .cs__client {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .cs__main {
    display: grid;
    gap: 1.25rem;
  }

  .cs__figure {
    display: grid;
    gap: 0.5rem;
  }

  /* The number in ink, its unit in orange (FigureValue). */
  .cs__value {
    font-size: clamp(2.75rem, 2rem + 2.4vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .cs__label {
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: var(--track-heading);
  }

  .cs__text {
    max-width: 46ch;
    color: var(--ink-2);
  }

  .cs__text--lead {
    max-width: 30ch;
    font-size: var(--fs-h3);
    line-height: 1.25;
    letter-spacing: var(--track-heading);
    color: var(--ink);
  }

  .cs__meta {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .cs__meta {
      justify-items: end;
      text-align: right;
    }
  }

  .cs__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    padding: 0 0.75rem;
    background: var(--chip-bg);
    color: var(--ink-2);
  }

  .cs__badge span {
    width: 0.375rem;
    height: 0.375rem;
    background: var(--accent);
  }

  /* ---------- Recognition ---------- */
  .rc__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .rc__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .rc__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .rc__item {
    display: grid;
    align-content: space-between;
    gap: 2.5rem;
    min-height: clamp(9rem, 7rem + 4vw, 12rem);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--card);
  }

  .rc__name {
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .rc__text {
    color: var(--muted);
  }
</style>
