---
/**
 * Compliance (/compliance), from "predicterra-08-compliance.md".
 * hero · metrics · what it covers (frameworks as quiet rows) · why (the
 * paragraph left, the three blocks right) · CTA.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../sections/pages/PageHero.astro';
import Stats from '../sections/pages/Stats.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import Icon from '../components/Icon.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy } from '../i18n/config';
import type { IconName } from '../data/icons';

const locale = 'en';
const { compliance: c } = getCopy(locale);
const pad = (n: number) => String(n).padStart(3, '0');
---

<PageLayout title={c.seo.title} description={c.seo.description} locale={locale}>
  <PageHero locale={locale} {...c.hero} layout="centred" />
  <Stats locale={locale} items={[...c.metrics]} />

  <section class="cv pg-sec" aria-labelledby="covers-title">
    <div class="container pg-body">
      <SectionHead id="covers-title" title={c.covers.title} align="center" />
      <table class="cv__table">
        <thead class="visually-hidden">
          <tr>
            <th scope="col">{c.covers.labels.framework}</th>
            <th scope="col">{c.covers.labels.get}</th>
          </tr>
        </thead>
        <tbody data-reveal-group>
          {
            c.covers.items.map((it, i) => (
              <tr class="cv__row" data-reveal>
                <th scope="row" class="cv__name">
                  <span class="pg-idx">{pad(i + 1)}</span>
                  <span>{it.framework}</span>
                </th>
                <td class="cv__get">{it.get}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="cw pg-sec" aria-labelledby="why-title">
    <div class="container cw__grid">
      <SectionHead id="why-title" title={c.why.title} text={c.why.text} align="stack" />
      <ul class="cw__list" data-reveal-group>
        {
          c.why.items.map((it) => (
            <li class="cw__item" data-reveal>
              <Icon name={it.icon as IconName} boxed size="2.5rem" />
              <div>
                <h3 class="cw__title">{it.title}</h3>
                <p class="cw__text">{it.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta locale={locale} copy={c.cta} />
</PageLayout>

<style>
  .cv__table {
    width: 100%;
    border-collapse: collapse;
  }

  .cv__row {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .cv__row:last-child {
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .cv__row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
    }
  }

  .cv__name {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: baseline;
    font-weight: 400;
    text-align: left;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: var(--track-title);
  }

  .cv__get {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .cw__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .cw__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  .cw__list {
    display: grid;
  }

  .cw__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .cw__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .cw__title {
    font-size: var(--fs-h4);
    line-height: 1.2;
    letter-spacing: var(--track-title);
  }

  .cw__text {
    margin-top: 0.5rem;
    max-width: 38ch;
    color: var(--ink-2);
  }
</style>
