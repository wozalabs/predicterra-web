---
/**
 * About (/about), from "predicterra-03-about.md".
 * hero (with the BAT tower) · our story · the team · Woza Labs and contact
 * (dark). Photos always in colour.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../sections/pages/PageHero.astro';
import SectionHead from '../sections/pages/SectionHead.astro';
import Button from '../components/Button.astro';
import wozaLogoRaw from '../assets/woza-labs.svg?raw';
import { getCopy, withBase } from '../i18n/config';

const locale = 'en';
const { about: a } = getCopy(locale);
const site = Astro.site ?? new URL('https://www.predicterra.com');
const pad = (n: number) => String(n).padStart(3, '0');

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: a.seo.title,
  description: a.seo.description,
  url: new URL(withBase('/about'), site).href,
  mainEntity: { '@id': new URL('/#organization', site).href },
};

// Woza Labs logo, recoloured to follow the text colour (light on the dark section).
const wozaLogo = wozaLogoRaw
  .replace(/<metadata[\s\S]*?<\/metadata>/g, '')
  .replace(/fill="#161616"/g, 'fill="currentColor"')
  .replace('<svg ', '<svg role="img" aria-label="Woza Labs" focusable="false" ');
---

<PageLayout title={a.seo.title} description={a.seo.description} locale={locale} jsonLd={[aboutJsonLd]}>
  <PageHero locale={locale} title={a.hero.title} accent={a.hero.accent} text={a.hero.text} note={a.hero.note}>
    <figure slot="visual" class="ab-photo">
      <img
        src={withBase(a.hero.photo.src)}
        alt={a.hero.photo.alt}
        width={a.hero.photo.w}
        height={a.hero.photo.h}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </PageHero>

  <!-- Our story: the title on the left, the paragraph on the right. -->
  <section class="ab-story pg-sec" aria-labelledby="story-title">
    <div class="container ab-story__grid">
      <h2 id="story-title" class="ab-story__title" data-render>{a.story.title}</h2>
      <p class="ab-story__text" data-reveal>{a.story.text}</p>
    </div>
  </section>

  <!-- Woza Labs enters as a panel over the team (scripts/panels.ts). -->
  <div class="pnl">
  <section class="ab-team pg-sec" aria-labelledby="team-title">
    <div class="container pg-body">
      <SectionHead id="team-title" title={a.team.title} text={a.team.text} align="side" />
      <ul class="ab-team__list" data-reveal-group>
        {
          a.team.people.map((m, i) => (
            <li class="ab-person" data-reveal>
              <div class="ab-person__photo">
                <img src={withBase(m.photo)} alt={m.name} width="600" height="600" loading="lazy" decoding="async" />
              </div>
              <span class="pg-idx">{pad(i + 1)}</span>
              <h3 class="ab-person__name">{m.name}</h3>
              <p class="ab-person__role t-small">{m.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ab-woza pg-sec" aria-labelledby="woza-title" data-dark>
    <div class="container ab-woza__grid">
      <div class="ab-woza__brand">
        <div class="ab-woza__logo" set:html={wozaLogo} />
        <p id="woza-title" class="ab-woza__text" data-render>{a.woza.text}</p>
        <div data-reveal>
          <Button href={a.woza.link.href} label={a.woza.link.label} variant="secondary" external />
        </div>
      </div>
      <dl class="ab-woza__contact" data-reveal-group>
        <div class="ab-woza__fact" data-reveal>
          <dt class="t-small">{a.contact.officeLabel}</dt>
          <dd>{a.contact.address}</dd>
        </div>
        <div class="ab-woza__fact" data-reveal>
          <dt class="t-small">{a.contact.emailLabel}</dt>
          <dd><a href={`mailto:${a.contact.email}`}>{a.contact.email}</a></dd>
        </div>
        <div class="ab-woza__fact" data-reveal>
          <dt class="t-small">{a.contact.joinLabel}</dt>
          <dd>
            {a.contact.join} <a href={`mailto:${a.contact.email}`}>{a.contact.email}</a>.
          </dd>
        </div>
      </dl>
    </div>
  </section>
  </div>
</PageLayout>

<style>
  /* ---------- Hero photo: the BAT tower in the notched frame ---------- */
  .ab-photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--media);
    clip-path: var(--notch);
  }

  .ab-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  /* ---------- Our story ---------- */
  .ab-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .ab-story__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .ab-story__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .ab-story__text {
    max-width: 58ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
    letter-spacing: var(--track-title);
    color: var(--ink-2);
  }

  /* ---------- Team ---------- */
  .ab-team__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--gutter);
  }

  @media (min-width: 48rem) {
    .ab-team__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .ab-team__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .ab-person {
    display: grid;
    align-content: start;
    gap: 0.25rem;
  }

  .ab-person__photo {
    overflow: hidden;
    aspect-ratio: 1;
    margin-bottom: 1rem;
    background: var(--portrait);
    clip-path: var(--notch);
  }

  /* Portraits are cut out on white: multiply takes the white to the frame grey. Always in colour. */
  .ab-person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .ab-person__name {
    margin-top: 0.25rem;
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .ab-person__role {
    color: var(--ink-2);
  }

  /* ---------- Woza Labs and contact (dark) ---------- */
  .ab-woza__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem clamp(3rem, 1rem + 6vw, 8rem);
  }

  @media (min-width: 64rem) {
    .ab-woza__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  .ab-woza__brand {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }

  .ab-woza__logo {
    width: clamp(10rem, 6rem + 10vw, 17rem);
  }

  .ab-woza__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ab-woza__text {
    max-width: 30ch;
    font-size: var(--fs-h3);
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .ab-woza__contact {
    display: grid;
  }

  .ab-woza__fact {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .ab-woza__fact dt {
    color: var(--muted);
  }

  .ab-woza__fact dd {
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .ab-woza__fact a {
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ab-woza__fact a:hover {
      color: var(--accent);
      background: var(--grad-text);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      background-size: var(--grad-text-size);
      animation: var(--fire-text-motion);
    }
  }
</style>
