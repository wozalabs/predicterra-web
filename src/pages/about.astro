---
/**
 * About. Copy and team from predicterra.com/about, in the homepage's design
 * language: light canvas, notched rules, title left / content right on a
 * 4 : 8 grid, notched image frames, the grey CTA card. Sections: intro,
 * team, where we are, CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import NotchRule from '../components/NotchRule.astro';
import Cta from '../sections/home/Cta.astro';
import { getCopy, withBase } from '../i18n/config';

const locale = 'en';
const { about } = getCopy(locale);
const { hero, team, where } = about;
const site = Astro.site ?? new URL('https://www.predicterra.com');
const pad = (n: number) => String(n).padStart(2, '0');

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: about.seo.title,
  description: about.seo.description,
  url: new URL(withBase('/about'), site).href,
  mainEntity: { '@id': new URL('/#organization', site).href },
};
---

<BaseLayout title={about.seo.title} description={about.seo.description} locale={locale} jsonLd={[aboutJsonLd]}>
  <!-- Intro -->
  <section class="ab-hero" aria-labelledby="about-title">
    <div class="container ab-hero__inner">
      <p class="ab-hero__eyebrow t-small" data-reveal>{hero.eyebrow}</p>
      <h1 id="about-title" class="ab-hero__title" data-render>{hero.title}</h1>
      <p class="ab-hero__text" data-reveal>{hero.text}</p>
    </div>
  </section>

  <!-- Team -->
  <section class="ab-sec" aria-labelledby="team-title">
    <div class="container">
      <NotchRule at={70} />
      <div class="ab-grid">
        <div class="ab-head">
          <p class="label">{team.label}</p>
          <h2 id="team-title" class="t-h2" data-render>{team.title}</h2>
        </div>
        <p class="ab-lead" data-reveal>{team.text}</p>
      </div>
      <ul class="ab-team" data-reveal-group>
        {
          team.people.map((m, i) => (
            <li class="ab-person" data-reveal>
              <div class="ab-person__photo">
                <img src={withBase(m.photo)} alt={m.name} width="600" height="600" loading="lazy" decoding="async" />
              </div>
              <p class="ab-person__index t-caption t-num">{pad(i + 1)}</p>
              <h3 class="ab-person__name">{m.name}</h3>
              <p class="ab-person__role t-small">{m.role}</p>
              {m.org && <p class="ab-person__org t-small">{m.org}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Where we are -->
  <section class="ab-sec" aria-labelledby="where-title">
    <div class="container">
      <NotchRule at={70} />
      <div class="ab-grid">
        <div class="ab-head">
          <p class="label">{where.label}</p>
          <h2 id="where-title" class="t-h2" data-render>{where.title}</h2>
        </div>
        <div class="ab-where" data-reveal-group>
          <p class="ab-lead" data-reveal>{where.text}</p>
          <address class="ab-where__contact" data-reveal>
            <span>{where.address}</span>
            {
              where.phones.map((p) => (
                <a href={p.href}>
                  <span class="t-muted">{p.label}</span> <span class="t-num">{p.value}</span>
                </a>
              ))
            }
          </address>
          <div class="ab-photo" data-reveal>
            <img src={withBase(where.photo.src)} alt={where.photo.alt} width={where.photo.w} height={where.photo.h} loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Cta locale={locale} copy={about.cta} />
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .ab-hero__inner {
    display: grid;
    gap: 1.5rem 0;
    padding-top: calc(var(--header-h) + clamp(4rem, 2rem + 9vh, 9rem));
    padding-bottom: clamp(4rem, 2rem + 6vw, 8rem);
  }

  .ab-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--muted);
  }

  .ab-hero__eyebrow::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .ab-hero__title {
    max-width: 16ch;
    font-size: clamp(2.75rem, 1rem + 4.6vw, 6rem);
    line-height: 0.96;
    letter-spacing: var(--track-display);
  }

  .ab-hero__text {
    max-width: 38ch;
    margin-top: clamp(0.5rem, 0.25rem + 1vw, 1.5rem);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }

  @media (min-width: 64rem) {
    /* Intro paragraph sits in the content column, like the sections below */
    .ab-hero__inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--gutter);
    }
    .ab-hero__eyebrow,
    .ab-hero__title {
      grid-column: 1 / -1;
    }
    .ab-hero__text {
      grid-column: 2;
    }
  }

  /* ---------- Sections ---------- */
  .ab-sec {
    position: relative;
    padding-bottom: var(--section-y);
  }

  .ab-grid {
    display: grid;
    gap: 2rem var(--gutter);
    padding-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  @media (min-width: 64rem) {
    .ab-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  .ab-head {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .ab-lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- Team ---------- */
  .ab-team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  @media (min-width: 48rem) {
    .ab-team {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .ab-team {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .ab-person {
    display: grid;
    align-content: start;
  }

  /* Same notched frame as the success-stories images */
  .ab-person__photo,
  .ab-photo {
    overflow: hidden;
    background: #e4e4e4;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 42% 100%, calc(42% - 18px) calc(100% - 18px), 0 calc(100% - 18px));
  }

  .ab-person__photo {
    aspect-ratio: 1;
    margin-bottom: 1rem;
  }

  .ab-person__photo img,
  .ab-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The portraits are cut out on white: multiply takes the white to the frame grey. */
  .ab-person__photo img {
    mix-blend-mode: multiply;
  }

  .ab-person__index {
    color: var(--muted);
  }

  .ab-person__name {
    margin-top: 0.25rem;
    font-size: var(--fs-h4);
    letter-spacing: var(--track-title);
  }

  .ab-person__role {
    margin-top: 0.25rem;
    color: var(--ink-2);
  }

  .ab-person__org {
    color: var(--muted);
  }

  /* ---------- Where we are ---------- */
  .ab-where {
    display: grid;
    gap: 2rem;
    min-width: 0;
    align-content: start;
  }

  .ab-where__contact {
    display: grid;
    gap: 0.375rem;
    font-style: normal;
  }

  .ab-where__contact a {
    width: fit-content;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ab-where__contact a:hover {
      color: var(--accent);
    }
  }

  .ab-photo {
    aspect-ratio: 3 / 2;
    margin-top: 1rem;
  }
</style>
