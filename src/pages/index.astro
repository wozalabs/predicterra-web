---
/**
 * Home (/), from "predicterra-01-home.md": hero (with the platform capture and
 * the three pillars) · logos · sectors (the 3D scene, then across all sectors)
 * · metrics · CTA. The hero layouts other than App are test layouts (menu).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/home/Hero.astro';
import HeroPanel from '../sections/home/HeroPanel.astro';
import HeroApp from '../sections/home/HeroApp.astro';
import HeroCutout from '../sections/home/HeroCutout.astro';
import HeroPixel from '../sections/home/HeroPixel.astro';
import HeroClean from '../sections/home/HeroClean.astro';
import HeroImmersive from '../sections/home/HeroImmersive.astro';
import HeroWindow from '../sections/home/HeroWindow.astro';
import HeroAnnotated from '../sections/home/HeroAnnotated.astro';
import Showcase from '../sections/home/Showcase.astro';
import WhyUs from '../sections/home/WhyUs.astro';
import SectorsIntro from '../sections/home/SectorsIntro.astro';
import SectorTrail from '../sections/home/SectorTrail.astro';
import SectorScene from '../sections/home/SectorScene.astro';
import Across from '../sections/home/Across.astro';
// Key figures are hidden for now; to bring them back, restore this import and <Metrics /> below.
// import Metrics from '../sections/home/Metrics.astro';
import Cta from '../sections/home/Cta.astro';
import HomeIntro from '../sections/home/HomeIntro.astro';
import { getCopy } from '../i18n/config';
import { softwareJsonLd } from '../data/seo';
import '../styles/rhythm.css';

const locale = 'en';
const { home } = getCopy(locale);
const site = Astro.site ?? new URL('https://www.predicterra.com');
// Test switches, bottom left (the capture and the film, the intro). Always on
// while developing (npm run dev). On the published site they stay hidden
// unless the page is opened once with ?options in the address (remembered in
// that browser; ?options=off hides them again), so coworkers can compare while
// visitors only ever see the defaults (current, intro on).
const dev = import.meta.env.DEV;
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  locale={locale}
  jsonLd={[softwareJsonLd(site, home.seo.description)]}
>
  <!-- Set before paint. -->
  <script is:inline define:vars={{ dev }}>
    var showTests = dev;
    try {
      var q = new URLSearchParams(location.search).get('options');
      if (q !== null) localStorage.setItem('predicterra:options', q === 'off' ? 'off' : 'on');
      showTests = dev || localStorage.getItem('predicterra:options') === 'on';
    } catch (e) {}
    if (showTests) document.documentElement.dataset.tests = '';
    // Test: the capture and the film (sections/home/Showcase.astro).
    try {
      var mix = showTests ? localStorage.getItem('predicterra:sc-mix') : null;
      document.documentElement.dataset.scMix = mix === 'alternate' || mix === 'framed' ? mix : 'current';
    } catch (e) {
      document.documentElement.dataset.scMix = 'current';
    }
    // Test: the intro (sections/home/HomeIntro.astro), panel hero only, from
    // the top: on a visit from outside the site and on a reload, not when
    // arriving from another page of the site (a link or the back button).
    try {
      var h = document.documentElement;
      var intro = showTests && localStorage.getItem('predicterra:intro') === 'off' ? 'off' : 'on';
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var internal = false;
      try {
        internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
      } catch (e) {}
      var play = type === 'reload' || (type === 'navigate' && !internal);
      h.dataset.introPref = intro;
      if (intro === 'on' && play && h.dataset.hero === 'panel' && !location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        h.dataset.intro = 'pre';
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        window.scrollTo(0, 0);
      }
    } catch (e) {}
  </script>
  <HomeIntro />
  <!-- Default hero: title centred, the platform capture peeking up from the bottom. -->
  <HeroApp locale={locale} />
  <!-- Default hero: white panel, title left, text right, the capture underneath. -->
  <HeroPanel locale={locale} />
  <!-- Test only: the other hero layouts, shown when selected in the menu. -->
  <Hero locale={locale} />
  <HeroCutout locale={locale} />
  <HeroPixel locale={locale} />
  <HeroClean locale={locale} />
  <!-- Test only: three layouts that combine the hero with the platform's interface. -->
  <HeroImmersive locale={locale} />
  <HeroWindow locale={locale} />
  <HeroAnnotated locale={locale} />
  <!-- The platform and, under it, who runs it: one screen once scrolled to. -->
  <Showcase locale={locale} peek logos={home.proof.groups} />
  <!-- Why us: what sets Predicterra apart, in one sentence. -->
  <WhyUs locale={locale} />
  <SectorsIntro locale={locale} />
  <SectorTrail locale={locale} />
  <!-- Test only: previous 3D variant, shown when selected in the menu (3D view). -->
  <SectorScene locale={locale} />
  <Across locale={locale} />
  {/* <Metrics locale={locale} /> */}
  <Cta locale={locale} copy={home.cta} />

  <!-- Test switches, bottom left (shown with html[data-tests], see the script at the top). -->
  {(
  <div class="rhy">
    <div class="rhy__row" role="group" aria-label="Capture and film (test)">
      <span class="rhy__label">Showcase</span>
      <button type="button" class="rhy__btn" data-mix-option="current" aria-pressed="false">Current</button>
      <button type="button" class="rhy__btn" data-mix-option="alternate" aria-pressed="false">Alternate</button>
      <button type="button" class="rhy__btn" data-mix-option="framed" aria-pressed="false">App lower</button>
    </div>
    <div class="rhy__row" role="group" aria-label="Intro (test)">
      <span class="rhy__label">Intro</span>
      <button type="button" class="rhy__btn" data-intro-option="on" aria-pressed="false">On</button>
      <button type="button" class="rhy__btn" data-intro-option="off" aria-pressed="false">Off</button>
      <button type="button" class="rhy__btn" data-intro-replay>Replay</button>
    </div>
  </div>
  )}
</BaseLayout>

<script>
  const html = document.documentElement;
  // The capture and the film: current, alternate or app lower.
  const mixes = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mix-option]'));
  const syncMix = () => mixes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mixOption === html.dataset.scMix)));
  mixes.forEach((b) =>
    b.addEventListener('click', () => {
      html.dataset.scMix = b.dataset.mixOption;
      try {
        localStorage.setItem('predicterra:sc-mix', b.dataset.mixOption!);
      } catch {}
      syncMix();
      window.dispatchEvent(new Event('showcase:mix'));
      // The ground film starts or stops with it (scripts/hero-video).
      window.dispatchEvent(new Event('hero:change'));
    }),
  );
  syncMix();

  // Intro on or off, and replay (reloads from the top).
  const intros = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-intro-option]'));
  const syncIntro = () => intros.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.introOption === html.dataset.introPref)));
  intros.forEach((b) =>
    b.addEventListener('click', () => {
      html.dataset.introPref = b.dataset.introOption;
      try {
        localStorage.setItem('predicterra:intro', b.dataset.introOption!);
      } catch {}
      syncIntro();
    }),
  );
  syncIntro();
  document.querySelector('[data-intro-replay]')?.addEventListener('click', () => {
    try {
      localStorage.setItem('predicterra:intro', 'on');
    } catch {}
    history.replaceState(null, '', location.pathname + location.search);
    window.scrollTo(0, 0);
    location.reload();
  });


</script>
